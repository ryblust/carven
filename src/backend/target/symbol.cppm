module carven:backend.target.symbol;

import std;

enum class TargetSymbol {
    Auto,
    Void,
    Bool,
    Char,
    Int,
    CChar,
    StdInt8,
    StdInt16,
    StdInt32,
    StdInt64,
    StdUInt8,
    StdUInt16,
    StdUInt32,
    StdUInt64,
    StdPtrdiff,
    StdSize,
    Float,
    Double,
    RuntimeReadArg,
    RuntimeTransfer,
    RuntimeDeferredStorage,
    RuntimeOutcome,
    RuntimeStrBytesView,
    RuntimeStrCharsView,
    RuntimeEntryArgs,
    RuntimeFunctionRef,
    RuntimeStrBytes,
    RuntimeStrChars,
    RuntimeIntegerNegate,
    RuntimeIntegerAdd,
    RuntimeIntegerSubtract,
    RuntimeIntegerMultiply,
    RuntimeIntegerDivide,
    RuntimeIntegerRemainder,
    RuntimeIntegerLeftShift,
    RuntimeIntegerRightShift,
    RuntimeCheckedArrayIndex,
    RuntimeCheckedUnicodeScalar,
    StdReferenceWrapper,
    StdAddressof,
    StdGetIf,
    StdForward,
    StdMove,
    StdNullopt,
    StdNullptr,
    StdExitFailure,
    StdOptional,
    StdStringView,
    StdVariant,
    TestingContext,
    TestingReporter,
};

auto target_symbol_spelling(TargetSymbol symbol) noexcept -> std::string_view;
