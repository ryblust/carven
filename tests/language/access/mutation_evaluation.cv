fn next_index(&calls: i32) -> i32 {
    calls += 1;
    return 0;
}

fn ordered_index(&trace: i32) -> i32 {
    trace = trace * 10 + 1;
    return 0;
}

fn ordered_value(&trace: i32) -> i32 {
    trace = trace * 10 + 2;
    return 3;
}

fn ordered_writes(&first: i32, &second: i32) {
    first = 1;
    second = 2;
}

test "Mutation: compound mutation evaluates its target once" {
    var calls = 0;
    var values: [i32; 2] = [4, 9];
    values[next_index(&calls)] += 3;

    check(calls == 1);
    check(values[0] == 7);
}

test "Mutation: target evaluation precedes the assigned value" {
    var trace = 0;
    var values: [i32; 2] = [4, 9];
    values[ordered_index(&trace)] += ordered_value(&trace);

    let order = trace;
    check(order == 12);
    check(values[0] == 7);
}

test "Mutation: Write access is nonexclusive and follows execution order" {
    var value = 0;
    ordered_writes(&value, &value);
    check(value == 2);
}

test "Bindings: initializer selects the outer binding before shadowing" {
    let value = 7;
    if true {
        let value = value + 1;
        check(value == 8);
    }
    check(value == 7);
}
