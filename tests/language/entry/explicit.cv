import "entry/explicit.hpp";

private import(cpp) fn cv_test_entry_mark_test_observed() = ::cv_test_entry_mark_test_observed;
private import(cpp) fn cv_test_entry_run_tests() -> i32 = ::cv_test_entry_run_tests;

test "Entry: an authored entry runs inline tests" {
    cv_test_entry_mark_test_observed();
}

struct Failure {
    payload: ::EntryPayload
}

private fn fail_entry() throw Failure {
    throw Failure { payload: ::EntryPayload {} };
}

fn main(args) -> ::EntryPayload throw Failure {
    assert(args.length() == 3);
    assert(args[1] == "alpha" && args[2] == "beta");
    let owner = ::cv_test_entry_begin(if args[0] == "recover" { 2 } else { 1 });
    let result = cv_test_entry_run_tests();
    assert(result == 0);
    if args[0] == "throw" {
        throw Failure { payload: ::EntryPayload {} };
    }
    if args[0] == "propagate" {
        fail_entry()?;
    }
    if args[0] == "recover" {
        try {
            fail_entry()?;
        } catch {
            Failure(_) => {},
        }
    }
    return ::EntryPayload {};
}
