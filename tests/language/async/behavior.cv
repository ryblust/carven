import .composition using run_composition;
import .constant using run_constant;
import .containers using run_containers;
import .contracts using run_contracts;
import .owners using run_owners;
import .scheduling using run_scheduling;
import .tail using run_tail;
import .tuples using run_tuples;
import .waiting using run_waiting;

export async fn run_behavior() {
    await run_containers();
    await run_tuples();
    await run_tail();
    await run_constant();
    await run_contracts();
    await run_owners();
    await run_composition();
    await run_waiting();
    await run_scheduling();
}
