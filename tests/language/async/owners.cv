import std::async using { Operation, cancel_point, yield_once, wait_ready, close }

const fn inspect(&_: Operation<void>) {}

const fn replace(&pending: Operation<void>) {
    pending = cancel_point();
}

const fn relay(&pending: Operation<void>) {
    replace(&pending);
}

const async fn touch(&value: i32) {
    ++value;
}

const async fn replacement() -> bool {
    var old = 0;
    var current = 0;
    var pending = touch(&old);
    pending = touch(&current);
    let released = &&old;
    await pending;
    return released == 0 && current == 1;
}

const async fn equivalent() {
    var inferred = yield_once();
    var typed: Operation<void> = yield_once();
    inspect(&inferred);
    inspect(&typed);
    await inferred;
    await typed;
}

const async fn observed(&continued: bool) {
    var pending = yield_once();
    relay(&pending);
    await pending;
    continued = true;
}

const async fn cancellation() -> bool {
    var continued = false;
    async let child = observed(&continued);
    cancel child;
    let (_, cancelled) = await wait_ready(child);
    await close(child);
    return cancelled && !continued;
}

const async fn read_temporary_owners() -> bool {
    let original = "object" as String;
    var text: String = {};
    for value in [original, original] {
        await yield_once();
        text.append(value);
    }
    return text == "objectobject";
}

const replaced = await replacement();
const cancelled = await cancellation();

const test "Async owners: static replacement, cancellation, and temporary iteration" {
    await equivalent();
    check(replaced && cancelled);
    check(await read_temporary_owners());
}

async test "Async owners: replacement, cancellation, and temporary iteration" {
    await equivalent();
    check(await read_temporary_owners());
    check(await replacement());
    check(await cancellation());
    var current = 0;
    var slots = (touch(&current),);
    slots.0 = touch(&current);
    await (&&slots).0;
    check(current == 1);
}
