import std::async using { yield_once, when_all }
import std::json using { JSONError, JSONValueError, JSONValue }

async fn parse_owned(&&text: String) -> JSONValue throw JSONError {
    await yield_once();
    return JSONValue::parse(text.as_str())?;
}

async fn products() -> Vector<(i32, void)> {
    var values = Vector<(i32, void)> {};
    values.push((41, ()));
    await yield_once();
    values.push((42, ()));
    return &&values;
}

async fn units() -> Vector<void> {
    var values = Vector<void> {};
    values.push(());
    await yield_once();
    values.push(());
    return &&values;
}

async test "Async containers: owned aggregate results survive suspension" {
    try {
        let text: String = "[41,42]";
        let (document, values, empty_values) = await when_all(
            parse_owned(&&text),
            products(),
            units()
        )?;
        check(document.length()? == 2);
        check(document.at(1)?.as_i64()? == 42);
        require(values.length() == 2);
        check(values[0] == (41, ()));
        check(values[1] == (42, ()));
        require(empty_values.length() == 2);
        check(empty_values[1] == ());
    } catch {
        JSONError(_) => fail("unexpected JSON parse failure"),
        JSONValueError(_) => fail("unexpected JSON value failure"),
    }
}
