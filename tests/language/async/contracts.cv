async fn leaf(value: i32) -> i32 {
    await yield_once();
    return value;
}

async fn rejected_guard(&trace: i32) -> bool {
    await yield_once();
    trace += 1;
    return false;
}

async fn match_guard() -> i32 {
    var trace: i32 = 0;
    let selected = match 4 {
        _ if await rejected_guard(&trace) => 99,
        _ => await leaf(7),
    };
    return selected + trace * 10;
}

enum Failure {
    First,
    Second
}

async fn fail(first: bool) throw Failure {
    await yield_once();
    if first { throw Failure::First; }
    throw Failure::Second;
}

async fn catch_guard(first: bool) -> i32 {
    var trace: i32 = 0;
    let selected = try {
        await fail(first)?;
        99
    } catch {
        Failure(.First) if await rejected_guard(&trace) => 98,
        Failure(.First) => await leaf(3),
        Failure(.Second) => await leaf(5),
    };
    return selected + trace * 10;
}

async fn recover_rethrow() -> i32 {
    var trace: i32 = 0;
    return try {
        let selected = try {
            await fail(true)?;
            99
        } catch {
            Failure(.First) => {
                trace = await leaf(4);
                rethrow;
            },
            Failure(.Second) => 98,
        };
        selected
    } catch {
        Failure(_) => trace + await leaf(6),
    };
}

async fn header_once() -> i32 {
    for let operation = leaf(23); true;
    {
        return await operation;
    }
    return 0;
}

async fn write_later(&value: i32) -> i32 {
    await yield_once();
    return value;
}

fn wrapped(&used: i32, &discarded: i32) {
    let unused = write_later(&discarded);
    return write_later(&used);
}

async fn wrapper_backing() -> i32 {
    var used: i32 = 8;
    var discarded: i32 = 12;
    let operation = wrapped(&used, &discarded);
    let moved = &&discarded;
    return await operation + moved;
}

fn select_return(&trace: i32) -> i32 {
    trace = trace * 10 + 1;
    return trace;
}

async fn finish_child(&trace: i32) {
    await yield_once();
    trace = trace * 10 + 2;
}

async fn pending_return(&trace: i32) -> i32 {
    async let child = finish_child(&trace);
    cancel child;
    return select_return(&trace);
}

async fn header_child_observe() -> i32 {
    var selected: i32 = 0;
    for async let child = leaf(25); true;
    {
        selected = await child;
        break;
    }
    return selected;
}

async fn header_child_continue() -> i32 {
    var trace: i32 = 0;
    var index: i32 = 0;
    var before_close: i32 = 0;
    for async let child = finish_child(&trace);
        if true {
            cancel child;
            index < 2
        } else {
            false
        };
        ++index {
        before_close = trace;
        cancel child;
        continue;
    }
    return before_close * 10 + trace;
}

async fn header_child_break() -> i32 {
    var trace: i32 = 0;
    for async let child = finish_child(&trace); true;
    {
        cancel child;
        trace = 1;
        break;
    }
    return trace;
}

async fn branch_child_closure(flag: bool) -> i32 {
    let value = if flag {
        async let child = leaf(7);
        cancel child;
        9
    } else {
        3
    };
    return value;
}

fn capture_argument(&trace: i32, digit: i32, value: i32) -> i32 {
    trace = trace * 10 + digit;
    return value;
}

async fn captured(value: i32, extra: i32, &backing: i32, &bodies: i32) -> i32 {
    bodies += 1;
    return value + extra + backing;
}

async fn cold_capture() -> i32 {
    var trace: i32 = 0;
    var backing: i32 = 3;
    var bodies: i32 = 0;
    if true {
        let dropped = captured(0, 0, &backing, &bodies);
    }
    let operation = captured(
        capture_argument(&trace, 1, backing),
        capture_argument(&trace, 2, 0),
        &backing,
        &bodies
    );
    backing = 7;
    let result = await operation;
    return trace * 1000 + bodies * 100 + result;
}

async fn record(&trace: i32, digit: i32) {
    trace = trace * 10 + digit;
}

async fn ready_dependency(&trace: i32) {
    await record(&trace, 1);
    trace = trace * 10 + 2;
}

async fn direct_dependency() -> i32 {
    var trace: i32 = 0;
    async let child = record(&trace, 9);
    await ready_dependency(&trace);
    await child;
    return trace;
}

async fn yielding_dependency(&trace: i32) {
    trace = trace * 10 + 1;
    await record(&trace, 2);
    let turn = yield_once();
    trace = trace * 10 + 3;
    await turn;
    trace = trace * 10 + 4;
}

async fn explicit_yield_boundary() -> i32 {
    var trace: i32 = 0;
    async let child = record(&trace, 8);
    await yielding_dependency(&trace);
    await child;
    return trace;
}

async fn forward_yield() {
    return await yield_once();
}

async fn return_yield_boundary() -> i32 {
    var trace: i32 = 0;
    async let child = record(&trace, 8);
    trace = 1;
    await forward_yield();
    trace = trace * 10 + 2;
    await child;
    return trace;
}

fn first_argument(&trace: i32, reject: bool) -> i32 throw Failure {
    trace = trace * 10 + 1;
    if reject { throw Failure::First; }
    return 3;
}

async fn argument_owner(&trace: i32) -> i32 {
    await yield_once();
    trace = trace * 10 + 2;
    return 7;
}

async fn sum_arguments(first: i32, second: i32, &trace: i32) -> i32 {
    trace = trace * 10 + 3;
    return first + second;
}

async fn operand_recovery(reject: bool) -> i32 {
    var trace: i32 = 0;
    let operation = argument_owner(&trace);
    let result = try {
        await sum_arguments(first_argument(&trace, reject)?, await operation, &trace)
    } catch {
        Failure(_) => await operation,
    };
    return result * 1000 + trace;
}

export fn typed_relay(&&pending: AsyncOperation<i32>) -> AsyncOperation<i32> => &&pending;

async fn typed_forward(&&pending: AsyncOperation<i32, throw Failure>) -> i32 throw Failure {
    return await pending?;
}

async fn typed_failure() -> i32 throw Failure {
    throw Failure::First;
}

struct PendingBox {
    pending: AsyncOperation<i32>
}

fn array_text(&&values: [String; 2]) -> String => (&&values)[0];
fn sequence_text(&&values: Vector<String>) -> String => (&&values)[0];
fn slice_text(&&values: [String]) -> String => (&&values)[0];

private struct Box<T> {
    value: T
}

private fn store<T>(&&value: T) -> Box<T> => { value: &&value };
private fn release<T>(&&box: Box<T>) -> T => (&&box).value;
private fn relay<T>(&&value: T) -> T => &&value;

private async fn complete<T, throw E>(&&pending: AsyncOperation<T, throw E>) -> T throw E {
    return (await pending)?;
}

private async fn keep_first<T, throw E>(
    &&left: AsyncOperation<T, throw E>,
    &&right: AsyncOperation<T, throw E>
) -> T throw E {
    let value = (await left)?;
    let _ = (await right)?;
    return &&value;
}

private fn store_pending<T, throw E>(
    &&pending: AsyncOperation<T, throw E>
) -> Box<AsyncOperation<T, throw E>> => { value: &&pending };

private async fn forwarded<throw E>(&&pending: AsyncOperation<i32, throw E>) -> i32 {
    return (await pending)?;
}

private async fn repeat<throw E>(&&pending: AsyncOperation<i32, throw E>, again: bool) -> i32 {
    if again { return (await repeat(&&forwarded(&&pending), false))?; }
    return (await pending)?;
}

async fn generic_owners() {
    let pending: AsyncOperation<i32> = leaf(42);
    let boxed = store(&&pending);
    let released = release(&&boxed);
    assert((await relay<AsyncOperation<i32>>(&&released)) == 42);
    let item: AsyncOperation<i32> = leaf(43);
    let items = relay<[AsyncOperation<i32>; 1]>(&&[&&item]);
    assert((await (&&items)[0]) == 43);
    let rejected: AsyncOperation<i32, throw Failure> = typed_failure();
    let forwarded = relay(&&rejected);
    let result = try {
        await forwarded?
    } catch {
        Failure(.First) => 47,
        Failure(.Second) => 0,
    };
    assert(result == 47);
    let stored = store_pending(&&leaf(51));
    let selected = release(&&stored);
    assert((await complete(&&selected)) == 51);
    assert((await keep_first(&&leaf(53), &&leaf(59))) == 53);
    assert((await repeat(&&leaf(67), true)) == 67);
    let failure = try {
        await complete(&&typed_failure())?
    } catch {
        Failure(.First) => 61,
        Failure(.Second) => 0,
    };
    assert(failure == 61);
}

async fn typed_owners() {
    let text = array_text(&&["first", "second"]);
    assert(text == "first");
    var texts: Vector<String> = {};
    texts.push("kept");
    let selected = sequence_text(&&texts);
    assert(selected == "kept");
    let originals: [String; 1] = ["unchanged"];
    var copied = slice_text(&&originals.as_slice());
    copied.clear();
    assert(originals[0] == "unchanged");
    let pending: AsyncOperation<i32> = typed_relay(&&leaf(31));
    assert((await pending) == 31);
    let box = PendingBox { pending: leaf(37) };
    assert((await (&&box).pending) == 37);
    let pair: (AsyncOperation<i32>, void) = (leaf(41), ());
    let (inner, empty) = &&pair;
    assert((await inner) == 41);
    let array: [AsyncOperation<i32>; 1] = [leaf(43)];
    assert((await (&&array)[0]) == 43);
    let result = try {
        await typed_forward(&&typed_failure())?
    } catch {
        Failure(.First) => 47,
        Failure(.Second) => 0,
    };
    assert(result == 47);
}

async fn main() {
    await generic_owners();
    await typed_owners();
    assert((await operand_recovery(true)) == 7012);
    assert((await operand_recovery(false)) == 10123);
    println(await match_guard());
    println(await catch_guard(true));
    println(await catch_guard(false));
    println(await recover_rethrow());
    println(await header_once());
    println(await wrapper_backing());
    var trace: i32 = 0;
    println(await pending_return(&trace));
    println(trace);
    println(await header_child_observe());
    println(await header_child_continue());
    println(await header_child_break());
    println(await branch_child_closure(true));
    println(await branch_child_closure(false));
    println(await cold_capture());
    println(await direct_dependency());
    println(await explicit_yield_boundary());
    println(await return_yield_boundary());
}
