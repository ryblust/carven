import "functions_and_calls/call_evaluation.hpp";

private import(cpp) fn cv_test_call_reset_order();
private import(cpp) fn cv_test_call_record(marker: i32) -> i32;
private import(cpp) fn cv_test_call_order() -> i32;

fn pair(left: i32, right: i32) -> i32 => left * 10 + right;

struct RecordedPair {
    first: i32,
    second: i32,
}

fn recorded_one() -> i32 => cv_test_call_record(1);

fn recorded_two() -> i32 => cv_test_call_record(2);

fn source_first(operand: i32) -> i32 => pair(cv_test_call_record(3), operand);

fn identity(value: i32) -> i32 => value;

fn reserved_identifier(__value: i32) -> i32 => __value;

fn next_value(&value: i32) -> i32 {
    value += 1;
    return value;
}

fn eight_values(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32) -> i32 {
    return a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
}

test "Evaluation: predecessor reads survive later effects across a wide argument list" {
    var value = 1;
    let result = eight_values(
        value, value, next_value(&value), value, value, next_value(&value), value, value
    );
    check(result == 33322211);
    check(value == 3);
}

test "Evaluation: call arguments evaluate from left to right" {
    cv_test_call_reset_order();
    let ordered = pair(
        cv_test_call_record(1),
        cv_test_call_record(2),
    );
    let observed = cv_test_call_order();

    check(ordered == 12);
    check(observed == 12);

    cv_test_call_reset_order();
    let invoked = (if cv_test_call_record(1) > 0 {
        identity
    } else {
        identity
    })(recorded_two() + 0);
    let callback_order = cv_test_call_order();
    check(invoked == 2);
    check(callback_order == 12);

    cv_test_call_reset_order();
    let aggregated = [recorded_one(), recorded_two() + 0];
    let aggregate_order = cv_test_call_order();
    check(aggregated[0] == 1);
    check(aggregated[1] == 2);
    check(aggregate_order == 12);

    cv_test_call_reset_order();
    let constructed = RecordedPair { recorded_one(), recorded_two() + 0 };
    let construction_order = cv_test_call_order();
    check(constructed.first == 1);
    check(constructed.second == 2);
    check(construction_order == 12);

    cv_test_call_reset_order();
    check(source_first(4) == 34);
    let source_first_order = cv_test_call_order();
    check(source_first_order == 3);
    check(reserved_identifier(5) == 5);
}
