fn decimal_record(value: i64) -> String => f"[{value:020d}]";
fn bit_record(value: u8) -> String => f"{value:b}|{value:B}|{value:o}|{value:x}|{value:X}";
fn narrow_record(value: i8) -> String => f"{value:06d}/{value:04x}/{value:09B}";
fn unicode_record(value: u64) -> String => f"{{我}}\0value={value:016X};";
fn wide_record(value: i32) -> String => f"start{value:65537}!";

fn advance_integer(&value: i32) -> i32 {
    value += 1;
    return value;
}

fn integer_flag(&trace: i32) -> bool {
    trace += 1;
    return true;
}

test "String interpolation: integer types preserve signs bases width Unicode and NUL" {
    check(decimal_record(-9223372036854775808i64) == "[-9223372036854775808]");
    check(decimal_record(7i64) == "[00000000000000000007]");
    check(bit_record(255u8) == "11111111|11111111|377|ff|FF");
    check(narrow_record(-128i8) == "-00128/-080/-10000000");
    check(unicode_record(18446744073709551615u64) == "{我}\0value=FFFFFFFFFFFFFFFF;");
    let wide = wide_record(-7);
    check(wide.len() == 65543usize);
    let bytes = wide.bytes;
    check(bytes[0usize] == 115u8 && bytes[4usize] == 116u8);
    check(bytes[65540usize] == 45u8 && bytes[65541usize] == 55u8 && bytes[65542usize] == 33u8);
}

test "String interpolation: parsed integer writes follow ordered scalar snapshots and folded effects" {
    var value = 2;
    var trace = 0;
    let text = f"{value}/{integer_flag(&trace) && false}/{advance_integer(&value)}/{value}";
    check(text == "2/false/3/3");
    check(value == 3);
    check(trace == 1);
    var output: String = "prefix:";
    output.append_format(f"{value:011d}/{advance_integer(&value):011d}/{value:011d}");
    check(output == "prefix:00000000003/00000000004/00000000004");
    check(value == 4);
}

fn mixed_writer_record(
    text: str,
    owned: String,
    value: u64,
    flag: bool,
    scalar: char
) -> String => f"{{{text}}}\0{owned}|{value:016X}|{flag}|{scalar}";

fn mixed_writer_append(&output: String, text: String, value: i32, flag: bool, scalar: char) {
    output.append_format(f"[{text}:{value:04}:{flag}:{scalar}]");
}

test "String interpolation: mixed writer fields preserve bytes growth and ownership" {
    var owned: String = "我\0text";
    let result = mixed_writer_record("view", owned, 18446744073709551615u64, false, '😀');
    check(result == "{view}\0我\0text|FFFFFFFFFFFFFFFF|false|😀");
    var output: String = "prefix:";
    for index in 0..100 {
        mixed_writer_append(&output, owned, index, true, '\0');
    }
    check(output.len() == 2207usize);
    owned.clear();
    check(result == "{view}\0我\0text|FFFFFFFFFFFFFFFF|false|😀");
}

fn writer_change(&source: String, &trace: i32) -> i32 {
    source.clear();
    source.append("after我");
    trace += 1;
    return trace;
}

fn writer_direct_return(
    &source: String,
    &trace: i32
) -> String => f"{source}/{trace}/{writer_change(&source, &trace)}/{source}";

struct WriterFailure {
    code: i32
}

fn writer_fail(&trace: i32) -> i32 throw WriterFailure {
    trace += 1;
    throw WriterFailure { code: trace };
}

fn writer_fallible_return(&trace: i32) -> String throw WriterFailure => f"text/{writer_fail(
        &trace
    )?}/{advance_integer(&trace)}";

test "Writer delivery: direct returns observe String after effects and keep scalar snapshots" {
    var source: String = "before storage long enough to allocate";
    var trace = 3;
    let result = writer_direct_return(&source, &trace);
    check(result == "after我/3/4/after我");
    source.clear();
    check(result == "after我/3/4/after我");
    var output = String {};
    var counter = 0;
    let nested = f"{advance_integer(&counter)}/{if true {
            output.append_format(f"{counter}/{advance_integer(&counter)}");
            counter
        } else {
            0
        }}/{counter}";
    check(nested == "1/2/2");
    check(output == "1/2");
    check(counter == 2);
    let code = try {
        writer_fallible_return(&trace)?;
        0
    } catch {
        WriterFailure(error) => error.code
    };
    check(code == 5);
    check(trace == 5);
}

fn writer_temporary_return(text: str, &trace: i32) -> String {
    return f"{String::from_str(text).as_str()}/{advance_integer(&trace)}";
}

test "Writer delivery: direct return retains temporary text through later effects" {
    var source: String = "dynamic text long enough to require independent heap storage 我";
    var trace = 7;
    let result = writer_temporary_return(source.as_str(), &trace);
    source.clear();
    check(result == "dynamic text long enough to require independent heap storage 我/8");
    check(trace == 8);
}

fn dynamic_integer_record(
    value: i64,
    width: i32,
    text: str
) -> String => f"{42:04}/{value:0{width}x}/{text}/{value:{width}d}";

fn dynamic_integer_failure(
    value: i32,
    width: i32,
    &trace: i32
) -> String throw WriterFailure => f"{value:0{width}x}/{writer_fail(&trace)?}";

fn dynamic_integer_append(&output: String, &text: String, &width: i32, &trace: i32) {
    output.append_format(
        f"{text}/{-7:0{width}x}/{advance_integer(&width)}/{writer_change(
                &text,
                &trace
            )}/{text}/{width}"
    );
}

test "Dynamic integer width: direct nested and append delivery preserve mixed operands" {
    check(dynamic_integer_record(-7, 4, "我\0") == "0042/-007/我\0/  -7");
    check(dynamic_integer_record(-7, 0, "text") == "0042/-7/text/-7");
    var width = 4;
    check(f"{-7:0{width}x}".len() == 4usize);
    var text: String = "before storage long enough to allocate";
    var output: String = "prefix:";
    var trace = 0;
    dynamic_integer_append(&output, &text, &width, &trace);
    check(output == "prefix:after我/-007/5/1/after我/5");
    check(width == 5 && trace == 1);
    let temporary = f"{String::from_str(text.as_str()).as_str()}/{-7:0{width}x}/{advance_integer(
            &width
        )}";
    text.clear();
    check(temporary == "after我/-0007/6");
}

test "Dynamic integer width: later source failure precedes invalid width formatting" {
    var trace = 0;
    let code = try {
        dynamic_integer_failure(42, -1, &trace)?;
        0
    } catch {
        WriterFailure(error) => error.code
    };
    check(code == 1 && trace == 1);
}
