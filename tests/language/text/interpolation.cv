struct FormatPair {
    value: i32,
}

fn next_format_value(&counter: i32) -> i32 {
    counter += 1;
    return counter;
}

fn append_format_value(&text: String) -> i32 {
    text.append(" changed");
    return 7;
}

fn consume_format_value(&&text: String) -> usize => text.len();
fn format_view(text: String) -> str => text;

fn record_format_flag(&trace: i32, digit: i32) -> bool {
    trace = trace * 10 + digit;
    return true;
}

test "Interpolation: precomputed contents preserve local values ownership and integer rules" {
    let version = 42;
    let copy = version;
    let text = "我\0{value}";
    check(f"build-{copy:04}" == "build-0042");
    check(f"{text} {'😀'} {true} {false}" == "我\0{value} 😀 true false");
    check(f"{-42:06x} {42:08B} {42:04o}" == "-0002a 00101010 0052");
    let minimum = -9223372036854775808i64;
    let maximum = 18446744073709551615u64;
    check(f"{minimum:021} {maximum:X}" == "-09223372036854775808 FFFFFFFFFFFFFFFF");
    var first = f"{42:64}";
    let second = f"{42:64}";
    first.clear();
    check(first.is_empty());
    check(second.len() == 64usize);
    let limit = 2147483647;
    check(limit + 1 == -2147483648);
    var dynamic = 42;
    dynamic += 1;
    check(f"{dynamic:04}" == "0043");
}

test "Interpolation: known results retain effects before construction and when discarded" {
    var trace = 0;
    check(
        f"{record_format_flag(&trace, 1) && false} {record_format_flag(&trace, 2) || true}"
            == "false true"
    );
    check(trace == 12);
    f"{record_format_flag(&trace, 3) && false}";
    check(trace == 123);
    let saved = record_format_flag(&trace, 4) && false;
    check(f"{saved}" == "false");
    check(trace == 1234);
}

test "Interpolation: mixed contents preserve literals and dynamic specification arguments" {
    let prefix = "{build}\0我";
    let version = 42;
    var value = 7;
    check(f"{prefix}={value}/{version:04}/{true}/{'😀'}" == "{build}\0我=7/0042/true/😀");
    check(f"{value}/{version:04}/{value}" == "7/0042/7");
    var price = 1.25;
    var width = 7;
    var precision = 2;
    check(f"{version:04}/{price:{width}.{precision}f}/{7}" == "0042/   1.25/7");
    var counter = 0;
    check(
        f"{version:04}/{1.0:{next_format_value(&counter) + 3}.{next_format_value(&counter)}f}/{7}"
            == "0042/1.00/7"
    );
    check(counter == 2);
}

test "Interpolation: mixed contents retain scalar snapshots String aliases and discarded effects" {
    var counter = 2;
    check(f"{counter} {record_format_flag(&counter, 3) && false} {counter}" == "2 false 23");
    check(counter == 23);
    var text: String = "original";
    let result = f"{text} {(append_format_value(&text) == 0) && false}";
    check(result == "original changed false");
    text.clear();
    check(result == "original changed false");
    counter = 0;
    f"{next_format_value(&counter)} {record_format_flag(&counter, 2) && false} {next_format_value(
            &counter
        )}";
    check(counter == 13);
}

test "Interpolation: owning text standard formats and UTF-8" {
    let f = 42;
    check(f == 42);
    check(f"".is_empty());
    check(f"{'\0'}" == "\0");
    check(f"hello" == "hello");
    check(f"{{value}} = {f:04x}" == "{value} = 002a");
    check(f"\u{7b}literal\u{7d}\0x{f}" == "{literal}\0x42");
}

test "Interpolation: expressions nested strings and dynamic specifications" {
    let price = 1.25;
    let count = 2;
    let width = 7;
    let precision = 2;
    check(f"Total: {price * (count as f64):.2f}" == "Total: 2.50");
    check(f"{price:{width}.{precision}f}" == "   1.25");
    check(f"{'我'} {'😀':>4} {String::from_str("abc"):.2}" == "我   😀 ab");
    check(f"{if true { FormatPair { value: 3 }.value } else { 4 }}" == "3");
    check(f"{f"inner {count}"}" == "inner 2");
    check(f"{("unused")}".len() > 0usize);
}

test "Interpolation: source order snapshots aliases and independent results" {
    var counter = 0;
    check(f"{next_format_value(&counter)} {next_format_value(&counter)}" == "1 2");
    check(counter == 2);
    counter = 0;
    check(f"{1.0:{next_format_value(&counter) + 3}.{next_format_value(&counter)}f}" == "1.00");
    check(counter == 2);
    check(f"{counter} {next_format_value(&counter)}" == "2 3");
    var text: String = "original";
    check(f"{text} {append_format_value(&text)}" == "original changed 7");
    let independent = f"{text.as_str()}";
    text.clear();
    check(independent == "original changed");
    check(f"{format_view("temporary")}" == "temporary");
    var moved: String = "abc";
    check(f"{f"{moved.as_str()}"} {consume_format_value(&&moved)}" == "abc 3");
    let _ = f"{next_format_value(&counter)}";
    check(counter == 4);
    var scalars = 0usize;
    for c in f"{'我'}{'😀'}".chars {
        let _ = c;
        scalars += 1usize;
    }
    check(scalars == 2usize);
}

test "Interpolation: multiline holes and branch values retain ordinary expression scope" {
    let result = f"value {if true {
            let x = 2;
            x * 3
        } else {
            0
        }}";
    check(result == "value 6");
    let closure = [](x: i32) -> String => f"{x}";
    check(closure(7) == "7");
    var text: String = "text that exceeds a small string buffer";
    text = f"{text.as_str()}!";
    check(text == "text that exceeds a small string buffer!");
    check(
        f"{String::from_str("temporary backing that exceeds a small string buffer").as_str()}"
            == "temporary backing that exceeds a small string buffer"
    );
}
