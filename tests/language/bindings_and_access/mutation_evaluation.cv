import "bindings_and_access/mutation_evaluation.hpp";

private import(cpp) fn cv_test_mutation_reset_index_calls();
private import(cpp) fn cv_test_mutation_index_call_count() -> i32;
private import(cpp) fn cv_test_mutation_next_index() -> i32;
private import(cpp) fn cv_test_mutation_reset_order();
private import(cpp) fn cv_test_mutation_order_value() -> i32;
private import(cpp) fn cv_test_mutation_ordered_index() -> i32;
private import(cpp) fn cv_test_mutation_ordered_value() -> i32;

fn ordered_writes(&first: i32, &second: i32) {
    first = 1;
    second = 2;
}

test "Mutation: compound mutation evaluates its target once" {
    cv_test_mutation_reset_index_calls();
    var values: [i32; 2] = [4, 9];
    values[cv_test_mutation_next_index()] += 3;

    let calls = cv_test_mutation_index_call_count();
    check(calls == 1);
    check(values[0] == 7);
}

test "Mutation: target evaluation precedes the assigned value" {
    cv_test_mutation_reset_order();
    var values: [i32; 2] = [4, 9];
    values[cv_test_mutation_ordered_index()] += cv_test_mutation_ordered_value();

    let order = cv_test_mutation_order_value();
    check(order == 12);
    check(values[0] == 7);
}

test "Mutation: Write access is nonexclusive and follows execution order" {
    var value = 0;
    ordered_writes(&value, &value);
    check(value == 2);
}

test "Bindings: initializer selects the outer binding before shadowing" {
    let value = 7;
    if true {
        let value = value + 1;
        check(value == 8);
    }
    check(value == 7);
}
