struct PrintedMoney {
    cents: i64
}

struct PrintedOrder {
    price: PrintedMoney,
    names: [str; 2]
}

struct PrintedEmpty {}

enum PrintedState {
    Pending,
    Done(i32, str)
}

enum PrintedCode: i32 {
    Ok = 1,
    Bad = 2
}

fn replace_order(&value: PrintedOrder) -> i32 {
    value.price.cents = 99;
    return 1;
}

fn output_number(output: fn(i32) -> void, value: i32) {
    output(value);
}

fn next_value(&value: i32) -> i32 {
    value += 1;
    return value;
}

fn output_pair(output: fn(str, i32) -> void) {
    output("count:", 3);
}

fn replace_text(&text: String) -> i32 {
    text = "after";
    return 1;
}

fn record_output_flag(&counter: i32) -> bool {
    counter += 10;
    return true;
}

fn main() {
    print("text: ");
    println(String::from_str("你好😀"));
    println(42);
    println(true);
    println('我');
    println(1.25);
    println("a\0b");
    println("{unchanged}");
    let value = 7;
    println(f"value={value:04}");
    output_number(println, 9);
    let output: fn(str) -> void = print;
    output("done");
    println();
    eprint(String::from_str("error: "));
    eprintln(-3);
    eprintln();
    print("mixed:", 42, true, '我', 1.25, String::from_str("owned"));
    println();
    println("{value}", value, "a\0b", "");
    output_pair(println);
    var counter = 0;
    println(next_value(&counter), next_value(&counter), next_value(&counter));
    println(counter);
    var text: String = "before";
    println(text, replace_text(&text));
    eprint("error:", -4);
    eprintln("status:", false);
    counter = 0;
    println(next_value(&counter), record_output_flag(&counter) && false, counter);
    println(counter);
    text = "before";
    println(42, f"{text}", replace_text(&text));
    text = "before";
    println(42, text, replace_text(&text));
    println(18446744073709551615u64, -9223372036854775808i64);
    var order = PrintedOrder {
        PrintedMoney { 1250 },
        ["a", "b\n"]
    };
    println(order);
    println(PrintedState::Done(42, "ok"), PrintedState::Pending, PrintedCode::Bad);
    println(PrintedEmpty {}, [1, 2, 3]);
    let values = [4, 5];
    println(values.as_slice());
    println(order, replace_order(&order));
    let structural: fn(PrintedOrder) -> void = println;
    structural(order);
    println(1..=3);

}
