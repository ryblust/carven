fn increment(value: i32) -> i32 => value + 1;

fn first(value: i32) -> i32 => value + 1;

fn second(value: i32) -> i32 => value + 2;

fn invoke(callback: fn(i32) -> i32, value: i32) -> i32 => callback(value);

fn apply(callback: fn(i32) -> i32, value: i32) -> i32 => callback(value);

fn replace_with_second(&callback: fn(i32) -> i32) {
    callback = second;
}

test "Lambdas: lambdas capture values and adapt callable views" {
    var source = 10;
    let snapshot = [source](_: i32) => source;
    source = 20;

    let mutate = [&source](delta: i32) {
        source += delta;
        return source;
    };
    let snapshot_view: fn(i32) -> i32 = snapshot;

    check(snapshot(0) == 10);
    check(snapshot_view(0) == 10);
    check(mutate(2) == 22);
    check(invoke(increment, 4) == 5);
    let callback = increment;
    check(apply(callback, 4) == 5);
    check(invoke([](value: i32) => value * 2, 4) == 8);
    check(invoke(snapshot, 0) == 10);
    check(invoke([source](value: i32) => value + source, 1) == 23);
    check(source == 22);
}

test "Callable arrays: distinct functions with the same shape" {
    let callbacks = [first, second];
    check(callbacks[0](1) == 2);
    check(callbacks[1](1) == 3);
}

test "Callable loans: owner can move after nested borrower scope exits" {
    var source = 4;
    let owner = [source](value: i32) => value + source;
    if true {
        let view: fn(i32) -> i32 = owner;
        check(view(1) == 5);
    }
    let moved = &&owner;
    check(moved(2) == 6);
}

test "Callable views: copies retain their target after intermediate scope exit" {
    var source = 4;
    let owner = [&source](delta: i32) {
        source += delta;
        return source;
    };
    var selected: fn(i32) -> i32 = first;
    if true {
        let intermediate: fn(i32) -> i32 = owner;
        selected = intermediate;
    }
    check(selected(3) == 7);
    check(source == 7);
}

test "Callable views: mutable storage follows branch and loop replacement" {
    var callback: fn(i32) -> i32 = first;
    if true {
        callback = second;
    } else {
        callback = first;
    }
    check(callback(1) == 3);

    var iteration = 0;
    while iteration < 2 {
        callback = if iteration == 0 { first } else { second };
        iteration += 1;
    }
    check(callback(1) == 3);

    replace_with_second(&callback);
    check(callback(1) == 3);
}

test "Calls: callee is selected before argument evaluation" {
    var callback: fn(i32) -> i32 = first;
    let result = callback(if true {
        replace_with_second(&callback);
        1
    } else {
        1
    });
    check(result == 2);
    check(callback(1) == 3);
}

test "Captures: immutable closure owners preserve write access to referents" {
    var source = 1;
    let update = [&source]() {
        source += 1;
    };
    let nested = [update]() {
        update();
    };
    let callbacks = [update, update];
    nested();
    callbacks[0]();
    callbacks[1]();
    check(source == 4);
    let moved = &&nested;
    moved();
    check(source == 5);
}

test "Closures: assignment rebinds Write targets with default C++ assignment" {
    let factory = [](&target: i32) {
        return [&target](delta: i32) {
            target += delta;
            return target;
        };
    };
    var first_target = 1;
    var second_target = 10;
    var first_closure = factory(&first_target);
    let second_closure = factory(&second_target);
    first_closure = second_closure;
    check(first_closure(2) == 12);
    check(first_target == 1);
    check(second_target == 12);
    var first_array = [first_closure];
    let second_array = [second_closure];
    first_array = second_array;
    check(first_array[0](3) == 15);
}

test "Callee selection: identity and explicit value snapshots" {
    let factory = [](value: i32) => [value](ignored: i32) => value;
    var selected = factory(1);
    let replacement = factory(10);
    let rebind = [&selected, replacement]() {
        selected = replacement;
        return 0;
    };
    check(selected(rebind()) == 10);
    selected = factory(1);
    let view: fn(i32) -> i32 = selected;
    check(view(rebind()) == 10);
    selected = factory(1);
    let snapshot = selected;
    check(snapshot(rebind()) == 1);
}

test "Callable views: stateless targets outlive their creation expression" {
    var count = 0;
    let stateless: fn() -> i32 = [&count]() {
        count += 1;
        return []() => 7;
    }();
    check(count == 1);
    check(stateless() == 7);
    let block_view: fn(i32) -> i32 = [](value) => value + 1;
    check(block_view(2) == 3);
}

fn stateless_callbacks() => [[]() => 8];

test "Callable views: stateless array elements need no backing storage" {
    let callbacks: [fn() -> i32; 1] = stateless_callbacks();
    check(callbacks[0]() == 8);
}
