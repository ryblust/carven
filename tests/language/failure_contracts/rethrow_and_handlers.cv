import "failure_contracts/rethrow_and_handlers.hpp";

struct ReadError {
    code: i32,
}

struct ParseError {
    code: i32,
}

struct UnreachableError {}

struct RecursiveError {
    code: i32,
}

enum DecodeError {
    Empty,
    Invalid(i32),
}

enum PairError {
    Pair(i32, i32),
}

private import(cpp) fn cv_test_reset_catch_guard_calls();
private import(cpp) fn cv_test_record_catch_guard() -> bool;
private import(cpp) fn cv_test_catch_guard_call_count() -> i32;

fn read() -> i32 throw ReadError {
    throw ReadError { code: 7 };
}

fn fail_parse(code: i32) -> i32 throw ParseError {
    throw ParseError { code: code };
}

fn fail_selected(read_failure: bool) -> i32 throw ReadError + ParseError {
    if read_failure {
        throw ReadError { code: 31 };
    }
    throw ParseError { code: 47 };
}

fn fail_decode(kind: i32) -> i32 throw DecodeError {
    if kind == 0 {
        throw DecodeError::Empty;
    }
    throw DecodeError::Invalid(73);
}

fn fail_unreachable() -> i32 throw UnreachableError {
    throw UnreachableError {};
}

fn fail_pair() -> i32 throw PairError {
    throw PairError::Pair(1, 1);
}

fn recover_decode(kind: i32) -> i32 {
    return try {
        fail_decode(kind)?
    } catch {
        DecodeError(.Empty) => 11,
        DecodeError(.Invalid(code)) => code,
    };
}

fn ignore_unreachable_catch_effect() -> i32 {
    return try {
        fail_decode(1)?
    } catch {
        DecodeError(.Empty) => 11,
        DecodeError(.Empty) => fail_unreachable()?,
        DecodeError(.Invalid(code)) => code,
    };
}

fn ignore_absent_typed_catch_effect() -> i32 {
    return try {
        fail_decode(1)?
    } catch {
        ReadError(_) => fail_unreachable()?,
        DecodeError(.Empty) => 11,
        DecodeError(.Invalid(code)) => code,
    };
}

fn ignore_constant_dead_effect() -> i32 {
    if false {
        return fail_unreachable()?;
    }
    while false {
        fail_unreachable()?;
    }
    return if true { 73 } else { fail_unreachable()? };
}

fn residual_decode(kind: i32) -> i32 throw DecodeError {
    return try {
        fail_decode(kind)?
    } catch {
        DecodeError(.Empty) => 19,
        DecodeError(.Invalid(_)) => rethrow,
    };
}

fn recover_residual_decode() -> i32 {
    return try {
        residual_decode(1)?
    } catch {
        DecodeError(.Empty) => -1,
        DecodeError(.Invalid(code)) => code,
    };
}

fn residual_read() -> i32 throw ReadError {
    return try {
        read()?
    } catch {
        ReadError(error) if error.code == 0 => 0,
        ReadError(_) => rethrow,
    };
}

fn recover_residual_read() -> i32 {
    return try {
        residual_read()?
    } catch {
        ReadError(error) => error.code,
    };
}

fn rethrow_typed_alternatives(read_failure: bool) -> i32 throw ReadError + ParseError {
    return try {
        fail_selected(read_failure)?
    } catch {
        ReadError(_) | ParseError(_) => rethrow,
    };
}

fn rethrow_wildcard(read_failure: bool) -> i32 throw ReadError + ParseError {
    return try {
        fail_selected(read_failure)?
    } catch {
        _ => rethrow,
    };
}

fn recover_typed_rethrow(read_failure: bool) -> i32 {
    return try {
        rethrow_typed_alternatives(read_failure)?
    } catch {
        ReadError(error) => error.code,
        ParseError(error) => error.code,
    };
}

fn recover_wildcard_rethrow(read_failure: bool) -> i32 {
    return try {
        rethrow_wildcard(read_failure)?
    } catch {
        ReadError(error) => error.code,
        ParseError(error) => error.code,
    };
}

fn guard_is_type_conditional() -> i32 {
    cv_test_reset_catch_guard_calls();
    let result = try {
        fail_selected(false)?
    } catch {
        ReadError(_) if cv_test_record_catch_guard() => -1,
        ReadError(error) => error.code,
        ParseError(error) => error.code,
    };
    let calls = cv_test_catch_guard_call_count();
    return result + calls * 100;
}

fn overlapping_alternatives_share_one_guard(accepted: bool) -> i32 {
    cv_test_reset_catch_guard_calls();
    let result = try {
        fail_pair()?
    } catch {
        PairError(.Pair(1, _)) | PairError(.Pair(_, 1))
            if cv_test_record_catch_guard() && accepted => 7,
        PairError(_) => 0,
    };
    let calls = cv_test_catch_guard_call_count();
    return result + calls * 10;
}

fn handler_propagates_outward() -> i32 throw ParseError {
    return try {
        read()?
    } catch {
        ReadError(_) => fail_parse(59)?,
    };
}

fn handler_transforms_failure() -> i32 throw ParseError {
    return try {
        read()?
    } catch {
        ReadError(_) => {
            throw ParseError { code: 61 };
        },
    };
}

fn guard_propagates_outward() -> i32 throw ParseError {
    return try {
        read()?
    } catch {
        ReadError(_) if fail_parse(67)? == 0 => 0,
        ReadError(_) => 1,
    };
}

fn recover_propagated_handler_failure() -> i32 {
    return try {
        handler_propagates_outward()?
    } catch {
        ParseError(error) => error.code,
    };
}

fn recover_transformed_handler_failure() -> i32 {
    return try {
        handler_transforms_failure()?
    } catch {
        ParseError(error) => error.code,
    };
}

fn recover_guard_failure() -> i32 {
    return try {
        guard_propagates_outward()?
    } catch {
        ParseError(error) => error.code,
    };
}

fn nested_rethrow() -> i32 throw ReadError {
    return try {
        read()?
    } catch {
        ReadError(error) => {
            if error.code == 7 {
                rethrow;
            }
            0
        },
    };
}

fn recover_nested_rethrow() -> i32 {
    return try {
        nested_rethrow()?
    } catch {
        ReadError(error) => error.code,
    };
}

private fn recursive_failure_left(fail_here: bool) -> i32 {
    if fail_here {
        throw RecursiveError { code: 83 };
    }
    return recursive_failure_right(true)?;
}

private fn recursive_failure_right(visit_left: bool) -> i32 {
    if visit_left {
        return recursive_failure_left(true)?;
    }
    return 0;
}

fn recover_recursive_failure() -> i32 {
    return try {
        recursive_failure_left(true)?
    } catch {
        RecursiveError(error) => error.code,
    };
}

test "Failure contracts: preserve rethrow and handler semantics" {
    check(recover_residual_read() == 7);
    check(recover_typed_rethrow(true) == 31);
    check(recover_typed_rethrow(false) == 47);
    check(recover_wildcard_rethrow(true) == 31);
    check(recover_wildcard_rethrow(false) == 47);
    check(guard_is_type_conditional() == 47);
    check(overlapping_alternatives_share_one_guard(true) == 17);
    check(overlapping_alternatives_share_one_guard(false) == 10);
    check(recover_propagated_handler_failure() == 59);
    check(recover_transformed_handler_failure() == 61);
    check(recover_guard_failure() == 67);
    check(recover_decode(0) == 11);
    check(recover_decode(1) == 73);
    check(ignore_unreachable_catch_effect() == 73);
    check(ignore_absent_typed_catch_effect() == 73);
    check(ignore_constant_dead_effect() == 73);
    check(recover_residual_decode() == 73);
    check(recover_nested_rethrow() == 7);
    check(recover_recursive_failure() == 83);
}
