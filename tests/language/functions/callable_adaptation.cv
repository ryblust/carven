struct Rejected {
    value: i32,
}

struct OtherFailure {}

fn first(value: i32) -> i32 throw Rejected {
    if value < 0 { throw Rejected { value }; }
    return value + 1;
}

fn second(value: i32) -> i32 throw Rejected {
    if value < 0 { throw Rejected { value }; }
    return value + 2;
}

fn invoke(callback: fn(i32) -> i32 throw Rejected, value: i32) -> i32 throw Rejected {
    return callback(value)?;
}

test "Callable adaptation: selected captured targets preserve results and effects on failure" {
    for choose_add in [false, true] {
        var calls = 0;
        let offset = 5;
        let add = [offset, &calls](value: i32) {
            calls += 1;
            if value < 0 { throw Rejected { value }; }
            return value + offset;
        };
        let subtract = [offset, &calls](value: i32) {
            calls += 1;
            if value < 0 { throw Rejected { value }; }
            return value - offset;
        };
        let selected: fn(i32) -> i32 throw Rejected =
            if choose_add { add } else { subtract };

        let direct = try {
            let value = if choose_add { add(20)? } else { subtract(20)? };
            value
        } catch {
            Rejected(_) => 0,
        };
        let dynamic = try { invoke(selected, 20)? } catch { Rejected(_) => 0, };
        let expected = if choose_add { 25 } else { 15 };
        check(direct == expected);
        check(dynamic == direct);
        check(calls == 2);

        let rejected = try { invoke(selected, -3)? } catch {
            Rejected(error) => error.value,
        };
        check(rejected == -3);
        check(calls == 3);
    }
}

test "Callable adaptation: equal copies snapshot targets while widening borrows view storage" {
    var source: fn(i32) -> i32 throw Rejected = first;
    let copied = source;
    let widened: fn(i32) -> i32 throw Rejected + OtherFailure = source;
    source = second;

    let original = try { copied(5)? } catch { Rejected(_) => 0, };
    let current = try { widened(5)? } catch {
        Rejected(_) => 0,
        OtherFailure(_) => 0,
    };
    check(original == 6);
    check(current == 7);

    // The saved widened target still refers to source, whose contents change
    // during argument evaluation before the inner invocation selects a target.
    let replaced = try {
        widened(if true { source = first; 5 } else { 5 })?
    } catch {
        Rejected(_) => 0,
        OtherFailure(_) => 0,
    };
    check(replaced == 6);
}
