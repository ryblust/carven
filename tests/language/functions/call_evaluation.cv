fn record(&trace: i32, marker: i32) -> i32 {
    trace = trace * 10 + marker;
    return marker;
}

fn pair(left: i32, right: i32) -> i32 => left * 10 + right;

struct RecordedPair {
    first: i32,
    second: i32,
}

fn recorded_one(&trace: i32) -> i32 => record(&trace, 1);
fn recorded_two(&trace: i32) -> i32 => record(&trace, 2);
fn source_first(&trace: i32, operand: i32) -> i32 => pair(record(&trace, 3), operand);
fn identity(value: i32) -> i32 => value;
fn reserved_identifier(__value: i32) -> i32 => __value;

fn next_value(&value: i32) -> i32 {
    value += 1;
    return value;
}

private fn known_effect_arguments(before: i32, flag: bool, after: i32) -> i32 {
    return before * 100 + (flag as i32) * 10 + after;
}

test "Evaluation: known argument results preserve earlier snapshots and later reads" {
    var trace = 3;
    let result = known_effect_arguments(trace, record(&trace, 4) > 0 && false, trace);
    check(result == 334);
    check(trace == 34);
    let truth = record(&trace, 5) > 0 || true;
    check(truth);
    check(trace == 345);
}

fn eight_values(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32) -> i32 {
    return a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
}

test "Evaluation: predecessor reads survive later effects across a wide argument list" {
    var value = 1;
    let result = eight_values(
        value,
        value,
        next_value(&value),
        value,
        value,
        next_value(&value),
        value,
        value
    );
    check(result == 33322211);
    check(value == 3);
}

test "Evaluation: call arguments evaluate from left to right" {
    var trace = 0;
    let ordered = pair(record(&trace, 1), record(&trace, 2),);
    let observed = trace;

    check(ordered == 12);
    check(observed == 12);

    trace = 0;
    let invoked = (if record(&trace, 1) > 0 { identity } else { identity })(
        recorded_two(&trace) + 0
    );
    let callback_order = trace;
    check(invoked == 2);
    check(callback_order == 12);

    trace = 0;
    let aggregated = [recorded_one(&trace), recorded_two(&trace) + 0];
    let aggregate_order = trace;
    check(aggregated[0] == 1);
    check(aggregated[1] == 2);
    check(aggregate_order == 12);

    trace = 0;
    let constructed = RecordedPair { recorded_one(&trace), recorded_two(&trace) + 0 };
    let construction_order = trace;
    check(constructed.first == 1);
    check(constructed.second == 2);
    check(construction_order == 12);

    trace = 0;
    check(source_first(&trace, 4) == 34);
    let source_first_order = trace;
    check(source_first_order == 3);
    check(reserved_identifier(5) == 5);
}

struct TextContainer {
    text: String,
}

fn text_length_after(value: String, marker: i32) -> usize => value.len() + marker as usize;

test "Evaluation: read-only owner projections retain backing across later effects" {
    var trace = 0;
    var container = TextContainer { text: "field" };
    var values: [String; 1] = ["element"];
    let field_result = text_length_after(container.text, record(&trace, 1));
    let element_result = text_length_after(values[0], record(&trace, 2));
    check(field_result == 6usize);
    check(element_result == 9usize);
    check(trace == 12);
    check(container.text == "field");
    check(values[0] == "element");
}

fn captured_before_callback(value: i32) {
    return [value](effect: fn() -> i32) -> i32 => pair(value, effect());
}

test "Evaluation: replacing a closure preserves its earlier captured operand" {
    var closure = captured_before_callback(1);
    let change = [&closure]() -> i32 {
        closure = captured_before_callback(9);
        return 2;
    };
    check(closure(change) == 12);
}

private fn captured_assignment(&target: i32) {
    return [&target](effect: fn() -> i32) {
        target = effect();
    };
}

test "Evaluation: assignment selects a capture place before evaluating its value" {
    var first = 1;
    var second = 9;
    var closure = captured_assignment(&first);
    let change = [&closure, &second]() -> i32 {
        closure = captured_assignment(&second);
        return 2;
    };
    closure(change);
    check(first == 2);
    check(second == 9);
}

fn replace_pointed_value(address: ptr<&i32>) -> i32 {
    if address == nullptr { return -1; }
    *address = 9;
    return *address;
}

fn observe_read_record(value: RecordedPair, address: ptr<&i32>) -> i32 {
    return pair(value.first, replace_pointed_value(address));
}

fn observe_read_slice(values: [i32], address: ptr<&i32>) -> i32 {
    return pair(values[0], replace_pointed_value(address));
}

fn observe_read_pointer(address: ptr<&i32>) -> i32 {
    if address == nullptr { return -1; }
    return pair(*address, replace_pointed_value(address));
}

test "Evaluation: Read value snapshots preserve observations through pointers and slices" {
    var record = RecordedPair {
        first: 1,
        second: 2
    };
    check(observe_read_record(record, addressof(&record.first)) == 19);
    check(record.first == 9);
    var values = [1, 2];
    check(observe_read_slice(values.as_slice(), addressof(&values[0])) == 19);
    check(values[0] == 9);
    var value = 1;
    check(observe_read_pointer(addressof(&value)) == 19);
    check(value == 9);
}

fn preserve_text_snapshot(original: str, &slot: str, replacement: str) -> str {
    slot = replacement;
    return original;
}

fn forward_text_snapshot(external: str) -> str {
    var slot = external;
    let local: String = "temporary";
    return preserve_text_snapshot(slot, &slot, local.as_str());
}

test "Evaluation: Read text snapshots survive replacement of the argument holder" {
    let owner: String = "original";
    check(forward_text_snapshot(owner.as_str()) == "original");
}

fn snapshot_fallback() -> i32 => 1;

fn invoke_callable_snapshot(original: fn() -> i32, &slot: fn() -> i32) -> i32 {
    slot = snapshot_fallback;
    return original();
}

test "Evaluation: Read callable snapshots keep their target when the holder is replaced" {
    let captured = 2;
    let owner = [captured]() => captured;
    var slot: fn() -> i32 = owner;
    check(invoke_callable_snapshot(slot, &slot) == 2);
    check(slot() == 1);
}
