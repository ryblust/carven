fn interpreted_successor(value: i32) -> i32 => value + 1;
fn interpreted_check(value: i32) => check(value == 3);

struct InterpretedError {
    value: i32
}

fn interpreted_failure() -> i32 throw InterpretedError {
    throw InterpretedError { value: 7 };
}

test "Runtime execution: arithmetic storage and recovery agree across executors" {
    var number: u8 = 255;
    ++number;
    check(number == 0);
    interpreted_check(interpreted_successor(2));
    var text: String = "a";
    text.append("b");
    check(text == "ab");
    const characters = String::from_str("a\0é我😀").chars;
    var copied = String {};
    for character in characters {
        copied.push(character);
    }
    check(copied == "a\0é我😀");
    let bytes = [65u8, 0xe6u8, 0x88u8, 0x91u8];
    for character in str::from_utf8_unchecked(bytes).chars {
        copied.push(character);
    }
    check(copied == "a\0é我😀A我");
    let recovered = try {
        interpreted_failure()?
    } catch {
        InterpretedError(problem) => problem.value,
    };
    require(recovered == 7);
    println("shared runtime test");
}
