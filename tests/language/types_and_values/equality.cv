import "types_and_values/equality.hpp";

struct Point {
    x: i32,
    y: i32,
}

struct Envelope {
    point: Point,
    values: [i32; 2],
}

enum Status: u8 {
    Ready = 4,
    Done,
}

enum Value {
    Number(i32),
    Pair(i32, i32),
    Wrapped(Envelope),
    Empty,
}

private import(cpp) fn cv_test_equality_reset_trace();
private import(cpp) fn cv_test_equality_record(value: i32) -> i32;
private import(cpp) fn cv_test_equality_trace_value() -> i32;

fn traced_value(value: i32) -> Value {
    let _ = cv_test_equality_record(value);
    return .Number(value);
}

test "Equality: structural equality compares values recursively" {
    let first_point = Point { x: 1, y: 2 };
    let same_point = Point { x: 1, y: 2 };
    let other_point = Point { x: 1, y: 3 };
    let first_envelope = Envelope { point: first_point, values: [3, 4] };
    let same_envelope = Envelope { point: same_point, values: [3, 4] };
    let other_envelope = Envelope { point: other_point, values: [3, 4] };

    check(first_point == same_point);
    check(first_point != other_point);
    check(first_envelope == same_envelope);
    check(first_envelope != other_envelope);

    check(Status::Ready != Status::Done);

    check(Value::Number(7) == Value::Number(7));
    check(Value::Number(7) != Value::Number(8));
    check(Value::Pair(1, 2) == Value::Pair(1, 2));
    check(Value::Pair(1, 2) != Value::Pair(1, 3));
    check(Value::Wrapped(first_envelope) == Value::Wrapped(same_envelope));
    check(Value::Wrapped(first_envelope) != Value::Wrapped(other_envelope));
    check(Value::Empty == Value::Empty);
    check(Value::Number(7) != Value::Empty);

    let empty: Value = .Empty;
    check(empty == .Empty);
    check(.Empty == empty);
    check(.Empty == (if true { empty } else { Value::Number(0) }));
    check(empty != .Number(0));
}

test "Equality: equality evaluates operands left to right once" {
    cv_test_equality_reset_trace();
    check(traced_value(1) != traced_value(2));
    let trace = cv_test_equality_trace_value();
    check(trace == 12);

    cv_test_equality_reset_trace();
    check(.Number(cv_test_equality_record(1)) != traced_value(2));
    let contextual_trace = cv_test_equality_trace_value();
    check(contextual_trace == 12);
}
