import "types_and_values/slices.hpp";

struct SliceHolder {
    values: [i32],
}

fn middle(values: [i32]) -> [i32] => values.slice(1, values.len() - 1);

fn sum(values: [i32]) -> i32 {
    var result = 0;
    for value in values { result += value; }
    return result;
}

test "Slices: arrays expose explicit read views and half-open subranges" {
    let values = [10, 20, 30, 40];
    let view: [i32] = values.as_slice();
    check(view.len() == 4);
    check(!view.is_empty());
    check(view[0] == 10);
    check(view[3] == 40);
    let saved = SliceHolder { values: middle(view) };
    check(sum(saved.values) == 50);
    check(view.slice(4, 4).is_empty());
    check(view.slice(0, 0).is_empty());
}

fn first_text(values: [str]) -> str => values[0];

test "Slices: extracting elements preserves their text backing" {
    let owner = String::from_str("hello");
    let values = [owner.as_str(), "world"];
    let view = values.as_slice();
    check(first_text(view) == "hello");
    let copy = view;
    for text in copy { check(!text.is_empty()); }
}

test "Slices: byte projections have a native slice type" {
    let text = String::from_str("a\u{0}😀");
    let bytes: [u8] = text.bytes;
    check(bytes.len() == 6);
    check(bytes[1] == 0);
    check(bytes[2] == 0xf0);
    let suffix = bytes.slice(2, bytes.len());
    check(suffix.len() == 4);
    var count = 0;
    for byte in suffix { if byte != 0 { count += 1; } }
    check(count == 4);
    let empty: [u8; 0] = [];
    check(empty.as_slice().is_empty());
}

fn call_first(callbacks: [fn() -> i32]) -> i32 => callbacks[0]();

test "Slices: callable elements and expression temporaries" {
    let number = 42;
    let closure = [number]() => number;
    let callback: fn() -> i32 = closure;
    let values = [callback];
    check(call_first(values.as_slice()) == 42);
    check(sum([1, 2, 3].as_slice()) == 6);
    var total = 0;
    for value in [1, 2, 3].as_slice() { total += value; }
    check(total == 6);
}

test "Slices: inner borrowed elements survive subrange rebasing" {
    let owner = String::from_str("text");
    let texts = ["", owner.as_str()];
    let suffix = texts.as_slice().slice(1, 2);
    check(first_text(suffix) == "text");
    let nested = [suffix];
    check(first_text(nested.as_slice()[0]) == "text");
}

private struct SliceNode {
    children: [SliceNode],
    value: i32,
}

private fn slice_node_value(node: SliceNode) -> i32 {
    return if node.children.is_empty() {
        node.value
    } else {
        slice_node_value(node.children[0])
    };
}

test "Slices: recursive views borrow backing rather than owning their elements" {
    let empty: [SliceNode; 0] = [];
    let leaf = SliceNode { children: empty.as_slice(), value: 42 };
    let children = [leaf];
    let tree = SliceNode { children: children.as_slice(), value: 0 };
    check(slice_node_value(tree) == 42);
}

private struct ArrayStorage {
    values: [i32; 2]
}

private enum ArrayPayload {
    Values([i32; 2])
}

private fn borrow_array(values: [i32; 2]) -> [i32] => values.as_slice();
private fn borrow_field(value: ArrayStorage) -> [i32] => value.values.as_slice();

private fn observe_payload(value: ArrayPayload, &target: ArrayPayload) -> i32 {
    target = .Values([70, 80]);
    match value { .Values(values) => { return values[0]; }, }
}

test "Slices: Read parameters preserve array backing through aggregates" {
    let values: [i32; 2] = [10, 20];
    let field = ArrayStorage { values: [30, 40] };
    var payload = ArrayPayload::Values([50, 60]);
    check(::slice_observation::same_backing(values, borrow_array(values)));
    check(sum(borrow_array(values)) == 30);
    check(::slice_observation::same_backing(field.values, borrow_field(field)));
    check(sum(borrow_field(field)) == 70);
    check(observe_payload(payload, &payload) == 70);
    let nested = [field];
    for item in nested { check(sum(borrow_field(item)) == 70); }
}

test "Slices: replacing a view releases its former backing" {
    var first = [1];
    let second = [2];
    var view = first.as_slice();
    view = second.as_slice();
    first[0] = 3;
    check(view[0] == 2);
    check(first[0] == 3);
}

private fn borrow_first_row(values: [[i32; 2]; 2]) -> [i32] {
    for row in values { return row.as_slice(); }
    return values[0].as_slice();
}

private fn borrow_slice_row(values: [[i32; 2]]) -> [i32] => values[0].as_slice();

private fn borrow_slice_loop(values: [[i32; 2]]) -> [i32] {
    for row in values { return row.as_slice(); }
    return values[0].as_slice();
}

private fn borrow_text_loop(values: [String]) -> str {
    for text in values { return text.as_str(); }
    return "";
}

test "Slices: Read selection preserves backing through parameters, projections and loops" {
    var rows: [[i32; 2]; 2] = [[10, 20], [30, 40]];
    check(::slice_observation::same_backing(rows[0], borrow_first_row(rows)));
    check(::slice_observation::same_backing(rows[1], borrow_slice_row(rows.as_slice().slice(1, 2))));
    check(::slice_observation::same_backing(rows[1], borrow_slice_loop(rows.as_slice().slice(1, 2))));
    let texts = [String::from_str("borrowed")];
    check(borrow_text_loop(texts.as_slice()) == "borrowed");
    let copied = rows.as_slice()[0];
    check(!::slice_observation::same_backing(rows[0], copied.as_slice()));
    rows[0][0] = 99;
    check(copied[0] == 10);
    check(sum(borrow_slice_loop([[1, 2]].as_slice())) == 3);
}

private fn choose_row(flag: bool, a: [[i32; 2]], b: [[i32; 2]]) -> [i32] {
    let rows = if flag { a } else { b };
    return borrow_slice_loop(rows);
}

test "Slices: joined views retain the selected owner through a Read binding" {
    let first: [[i32; 2]; 1] = [[1, 2]];
    let second: [[i32; 2]; 1] = [[3, 4]];
    check(::slice_observation::same_backing(first[0], choose_row(true, first.as_slice(), second.as_slice())));
    check(::slice_observation::same_backing(second[0], choose_row(false, first.as_slice(), second.as_slice())));
}

private fn array_text(values: [str; 1]) -> str => values[0];
private struct TextArray { values: [str; 1] }
private fn field_text(value: TextArray) -> str => array_text(value.values);
private fn array_slice(values: [[i32]; 1]) -> [i32] => values[0];

test "Slices: temporary aggregates preserve contained borrows after the call" {
    let owner = String::from_str("hello");
    let from_array = array_text([owner.as_str()]);
    let from_field = field_text(TextArray { values: [owner.as_str()] });
    check(from_array == "hello");
    check(from_field == "hello");
    let numbers: [i32; 2] = [10, 20];
    let selected = array_slice([numbers.as_slice()]);
    check(::slice_observation::same_backing(numbers, selected));
    check(sum(selected) == 30);
}

private fn invoke(callback: fn() -> i32) -> i32 => callback();

test "Slices: callable views borrow named closure elements" {
    let number = 42;
    let closure = [number]() => number;
    let owners = [closure];
    let view: fn() -> i32 = owners.as_slice()[0];
    check(view() == 42);
    for element in owners.as_slice() {
        let selected: fn() -> i32 = element;
        check(selected() == 42);
    }
    let rows = [[closure]];
    let callbacks: [fn() -> i32; 1] = rows.as_slice()[0];
    check(callbacks[0]() == 42);
    check(invoke([closure].as_slice()[0]) == 42);
}

test "Slices: consumed temporary holders release their contained borrows" {
    var owner = String::from_str("hello");
    check(array_text([owner.as_str()]) == "hello");
    owner.clear();
    check(owner.is_empty());
}
