struct FormatPair {
    value: i32,
}

fn next_format_value(&counter: i32) -> i32 {
    counter += 1;
    return counter;
}

fn append_format_value(&text: String) -> i32 {
    text.append(" changed");
    return 7;
}

fn consume_format_value(&&text: String) -> usize => text.len();
fn format_view(text: String) -> str => text.as_str();

test "Interpolation: owning text standard formats and UTF-8" {
    let f = 42;
    check(f == 42);
    check(f"".is_empty());
    check(f"{'\0'}".as_str() == "\0");
    check(f"hello" == String::from_str("hello"));
    check(f"{{value}} = {f:04x}".as_str() == "{value} = 002a");
    check(f"\u{7b}literal\u{7d}\0x{f}".as_str() == "{literal}\0x42");
}

test "Interpolation: expressions nested strings and dynamic specifications" {
    let price = 1.25;
    let count = 2;
    let width = 7;
    let precision = 2;
    check(f"Total: {price * (count as f64):.2f}".as_str() == "Total: 2.50");
    check(f"{price:{width}.{precision}f}".as_str() == "   1.25");
    check(f"{'我'} {'😀':>4} {String::from_str("abc"):.2}".as_str() == "我   😀 ab");
    check(f"{if true { FormatPair { value: 3 }.value } else { 4 }}".as_str() == "3");
    check(f"{f"inner {count}"}".as_str() == "inner 2");
    check(f"{("unused")}".len() > 0usize);
}

test "Interpolation: source order snapshots aliases and independent results" {
    var counter = 0;
    check(f"{next_format_value(&counter)} {next_format_value(&counter)}".as_str() == "1 2");
    check(counter == 2);
    counter = 0;
    check(f"{1.0:{next_format_value(&counter) + 3}.{next_format_value(&counter)}f}".as_str() == "1.00");
    check(counter == 2);
    check(f"{counter} {next_format_value(&counter)}".as_str() == "2 3");
    var text = String::from_str("original");
    check(f"{text} {append_format_value(&text)}".as_str() == "original changed 7");
    let independent = f"{text.as_str()}";
    text.clear();
    check(independent.as_str() == "original changed");
    check(f"{format_view(String::from_str("temporary"))}".as_str() == "temporary");
    var moved = String::from_str("abc");
    check(f"{f"{moved.as_str()}"} {consume_format_value(&&moved)}".as_str() == "abc 3");
    let _ = f"{next_format_value(&counter)}";
    check(counter == 4);
    var scalars = 0usize;
    for c in f"{'我'}{'😀'}".chars {
        let _ = c;
        scalars += 1usize;
    }
    check(scalars == 2usize);
}

test "Interpolation: multiline holes and branch values retain ordinary expression scope" {
    let result = f"value {if true {
        let x = 2;
        x * 3
    } else { 0 }}";
    check(result.as_str() == "value 6");
    let closure = [](x: i32) -> String => f"{x}";
    check(closure(7).as_str() == "7");
    var text = String::from_str("text that exceeds a small string buffer");
    text = f"{text.as_str()}!";
    check(text.as_str() == "text that exceeds a small string buffer!");
    check(f"{String::from_str("temporary backing that exceeds a small string buffer").as_str()}".as_str()
        == "temporary backing that exceeds a small string buffer");
}
