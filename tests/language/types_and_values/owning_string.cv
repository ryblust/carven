struct TextPair {
    first: String,
    second: String,
}

struct TextView {
    text: str,
}

struct MixedText {
    owner: String,
    view: str,
}

enum TextChoice {
    View(str),
    Owned(String),
}

fn view_of(text: String) -> str => text.as_str();
fn own(text: str) -> String => String::from_str(text);
fn pair_size(first: String, &&second: String) -> usize => first.len() + second.len();
fn scalar_then_take(first: usize, &&second: String) -> usize => first + second.len();
fn output_view(text: String, &output: str) {
    output = text.as_str();
}
fn release_then_push(&view: str, &owner: String) {
    view = "";
    owner.push('!');
}
fn recursive_view(text: String, count: i32) -> str {
    if count == 0 { return text.as_str(); }
    return recursive_view(text, count - 1);
}
fn read_with_write_alias(text: String, &alias: String) -> usize {
    let size = text.as_str().len();
    alias.push('!');
    return size;
}

test "String: builtin factories UTF-8 and independent value ownership" {
    var empty = (String::new)();
    check(empty.is_empty());
    empty.push('A');
    empty.push('é');
    empty.push('我');
    empty.push('😀');
    empty.push('\0');
    check(empty.len() == 11usize);
    check(empty.as_str() == "Aé我😀\0");
    var copy = empty;
    empty.clear();
    check(empty.is_empty());
    copy.append("é");
    check(copy.len() == 14usize);
    check(copy != String::from_str("Aé我😀\0é"));
    let moved = &&copy;
    check(moved == own("Aé我😀\0é"));
    var scalars = 0usize;
    for c in moved.chars {
        let _ = c;
        scalars += 1usize;
    }
    check(scalars == 7usize);
    var bytes = 0usize;
    for b in moved.bytes {
        let _ = b;
        bytes += 1usize;
    }
    check(bytes == moved.len());
    check(String::from_str("﻿").len() == 3usize);
}

test "String: holders end by scope replacement and independent consumption" {
    var text = String::from_str("abc");
    if true {
        let view = view_of(text);
        check(view == "abc");
    }
    text.push('!');
    var view = text.as_str();
    view = "";
    text = String::from_str(text.as_str());
    text = text;
    check(text.as_str() == "abc!");
    check(pair_size(String::from_str(text.as_str()), &&text) == 8usize);
    var second = own("xy");
    check(scalar_then_take(second.as_str().len(), &&second) == 4usize);
    var third = own("last");
    var output: str = "";
    output_view(third, &output);
    check(output == "last");
    release_then_push(&output, &third);
    check(third.as_str() == "last!");
    check(read_with_write_alias(third, &third) == 5usize);
    check(third.as_str() == "last!!");
}

test "String: aggregate storage captures branches recursive calls and retained ranges" {
    var pair = TextPair { first: own("one"), second: own("two") };
    if true {
        let v = pair.first.as_str();
        pair.second.push('!');
        check(v == "one");
    }
    var array = [own("a"), own("b")];
    array[1].append("c");
    check(array[1].as_str() == "bc");
    let view = TextView { text: pair.first.as_str() };
    let mixed = MixedText { owner: pair.first, view: view.text };
    check(mixed.owner.as_str() == mixed.view);
    let choice = TextChoice::View(recursive_view(pair.first, 2));
    let size: usize = match choice { .View(v) => v.len(), .Owned(s) => s.len() };
    check(size == 3usize);
    let closure = [view]() -> usize => view.text.len();
    check(closure() == 3usize);
    var count = 0usize;
    for c in view_of(String::from_str("a我😀")).chars {
        let _ = c;
        count += 1usize;
    }
    check(count == 3usize);
}

fn take_view(&&view: str) -> usize => view.len();
fn recursive_str(view: str, count: i32) -> str {
    if count == 0 { return view; }
    return recursive_str(view, count - 1);
}
fn selected_view(first: String, second: String, choose: bool) -> str {
    return if choose { first.as_str() } else { second.as_str() };
}
fn capture_view(view: str) => [view]() -> usize => view.len();

test "String: transferred views recursive str and selected results retain the right backing" {
    var text = String::from_str("abc");
    let taken = text.as_str();
    check(take_view(&&taken) == 3usize);
    text.push('!');
    let other = String::from_str("other");
    if true {
        let view = recursive_str(text.as_str(), 3);
        let selected = selected_view(text, other, false);
        check(view == "abc!");
        check(selected == "other");
        let captured = capture_view(view);
        check(captured() == 4usize);
    }
    text.clear();
    let String = 7;
    let builtin: String = String::from_str("builtin");
    check(String == 7);
    check(builtin.len() == 7usize);
}

fn text_closure(text: String) => [text]() -> str => text.as_str();

test "String: a returned view can borrow the owning value in a closure" {
    var original = String::from_str("captured owner");
    let closure = text_closure(original);
    original.clear();
    let view = closure();
    check(view == "captured owner");
}

test "String: Take parameters keep owning storage even for a read-only body" {
    let consume = [](&&text: String) -> usize => text.len();
    let text = String::from_str("taken");
    check(consume(&&text) == 5usize);
}
