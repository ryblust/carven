import "types_and_values/enum_evaluation.hpp";

enum Value {
    Number(i32),
    Pair(i32, i32),
}

private import(cpp) fn cv_test_reset_sum_evaluation_order();
private import(cpp) fn cv_test_sum_record(marker: i32) -> i32;
private import(cpp) fn cv_test_sum_evaluation_order_value() -> i32;
private import(cpp) fn cv_test_reset_match_subject_evaluations();
private import(cpp) fn cv_test_record_match_subject() -> i32;
private import(cpp) fn cv_test_match_subject_evaluation_count() -> i32;

fn next_value() -> Value {
    let _ = cv_test_record_match_subject();
    return .Number(21);
}

fn describe_next() -> i32 {
    return match next_value() {
        .Number(number) => number,
        _ => 0,
    };
}

fn second(value: Value) -> i32 {
    return match value {
        .Pair(_, item) => item,
        _ => 0,
    };
}

test "Enums: sum construction and matching evaluate once from left to right" {
    cv_test_reset_sum_evaluation_order();
    let ordered: Value = .Pair(
        cv_test_sum_record(1),
        cv_test_sum_record(2),
    );
    let observed = cv_test_sum_evaluation_order_value();
    check(second(ordered) == 2);
    check(observed == 12);

    cv_test_reset_match_subject_evaluations();
    check(describe_next() == 21);
    let match_evaluations = cv_test_match_subject_evaluation_count();
    check(match_evaluations == 1);
}
