enum Value {
    Number(i32),
    Pair(i32, i32),
}

#[cpp] {
    inline auto cv_test_sum_evaluation_order = 0;
    inline auto cv_test_match_subject_evaluations = 0;

    auto cv_test_sum_record(int marker) noexcept -> int {
        cv_test_sum_evaluation_order = cv_test_sum_evaluation_order * 10 + marker;
        return marker;
    }

    auto cv_test_record_match_subject() noexcept -> int {
        ++cv_test_match_subject_evaluations;
        return cv_test_match_subject_evaluations;
    }
}

fn next_value() -> Value {
    let _ = #[cpp] { cv_test_record_match_subject }();
    return .Number(21);
}

fn describe_next() -> i32 {
    return match next_value() {
        .Number(number) => number,
        _ => 0,
    };
}

fn second(value: Value) -> i32 {
    return match value {
        .Pair(_, item) => item,
        _ => 0,
    };
}

test "Enums: sum construction and matching evaluate once from left to right" {
    #[cpp] { cv_test_sum_evaluation_order = 0; }
    let ordered: Value = .Pair(
        #[cpp] { cv_test_sum_record(1) },
        #[cpp] { cv_test_sum_record(2) },
    );
    let observed: i32 = #[cpp] { cv_test_sum_evaluation_order };
    check(second(ordered) == 2);
    check(observed == 12);

    #[cpp] { cv_test_match_subject_evaluations = 0; }
    check(describe_next() == 21);
    let match_evaluations: i32 = #[cpp] { cv_test_match_subject_evaluations };
    check(match_evaluations == 1);
}
