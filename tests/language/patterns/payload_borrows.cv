private enum Choice {
    Left(String),
    Right(String),
}

private struct Holder {
    choice: Choice
}

private fn append_selected(&holder: Holder) {
    match holder.choice {
        .Left(&text) | .Right(&text) => text.append("!"),
    }
}

private fn read_selected(holder: Holder) -> String => match holder.choice {
    .Left(text) | .Right(text) if text.is_empty() => "empty" as String,
    .Left(text) | .Right(text) => text,
};

test "Payload borrowing: alternatives select original storage and guards release aliases" {
    var left = Holder { choice:.Left("left" as String) };
    var right = Holder { choice:.Right("right" as String) };
    append_selected(&left);
    append_selected(&right);
    check(read_selected(left).as_str() == "left!");
    check(read_selected(right).as_str() == "right!");
    let copied = read_selected(left);
    left.choice = .Right("replaced" as String);
    check(copied.as_str() == "left!");
    check(read_selected(left).as_str() == "replaced");
    let empty = Holder { choice:.Right(String {}) };
    check(read_selected(empty).as_str() == "empty");
}

private const fn mutate_patterns() -> i32 {
    var value: (String, i32) = ("start", 1);
    match value {
        (text, count) if text.is_empty() => {},
        (&text, &count) => {
            text.append("!");
            count += 1;
        },
    }
    match value {
        borrowed if borrowed.0.is_empty() => {},
        borrowed => assert(borrowed.0.as_str() == "start!"),
    }
    return value.0.byte_length() as i32 + value.1;
}

const test "Pattern access: static execution preserves writable subjects and releases Read aliases" {
    check(mutate_patterns() == 8);
}

test "Pattern access: runtime uses the same Read and Write model" {
    check(mutate_patterns() == 8);
    let value = match ("temporary" as String, 9) {
        (text, count) => text.byte_length() as i32 + count,
    };
    check(value == 18);
}
