fn classify(value: i32) -> i32 {
    return match value {
        -1 => 0,
        0 | 1 => 1,
        _ => {
            let doubled = value * 2;
            doubled
        },
    };
}

fn preserve_outer_binding(value: i32, carven_match_subject: i32) -> i32 {
    return match value {
        _ => carven_match_subject,
    };
}

fn __identity(__value: i32) -> i32 {
    return __value;
}

fn mutate_and_reject(&value: i32) -> bool {
    value = 2;
    return false;
}

#[cpp] {
    inline auto cv_match_subject_evaluations = 0;
    inline auto cv_match_dead_guard_evaluations = 0;

    auto cv_match_subject_once() noexcept -> bool {
        ++cv_match_subject_evaluations;
        return true;
    }

    auto cv_match_dead_guard() noexcept -> bool {
        ++cv_match_dead_guard_evaluations;
        return true;
    }
}

fn next_match_subject() -> bool {
    return #[cpp] { cv_match_subject_once() };
}

test "Pattern matching: matches support statement value and binding forms" {
    var selected: i32 = 0;
    match classify(0) {
        1 => { selected = 1; },
        _ => { selected = -1; },
    }

    check(selected == 1);
    check(classify(3) == 6);
    check(preserve_outer_binding(7, 42) == 42);
    check(__identity(9) == 9);

    #[cpp] {
        cv_match_subject_evaluations = 0;
        cv_match_dead_guard_evaluations = 0;
    }
    let dead_arm_result = match next_match_subject() {
        false => 1,
        true => 2,
        _ if #[cpp] { cv_match_dead_guard() } => 3,
    };
    let subject_evaluations: i32 = #[cpp] { cv_match_subject_evaluations };
    let dead_guard_evaluations: i32 = #[cpp] { cv_match_dead_guard_evaluations };
    check(dead_arm_result == 2);
    check(subject_evaluations == 1);
    check(dead_guard_evaluations == 0);

    let guarded_binding = match 1 {
        candidate if candidate == 0 => 10,
        1 => 20,
        _ => 30,
    };
    check(guarded_binding == 20);

    var mutable_subject: i32 = 1;
    let mutation_result = match mutable_subject {
        1 if mutate_and_reject(&mutable_subject) => 10,
        1 => 20,
        _ => 30,
    };
    check(mutation_result == 30);
}
