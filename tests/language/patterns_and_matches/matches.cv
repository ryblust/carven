import "patterns_and_matches/matches.hpp";

fn classify(value: i32) -> i32 {
    return match value {
        -1 => 0,
        0 | 1 => 1,
        _ => {
            let doubled = value * 2;
            doubled
        },
    };
}

fn preserve_outer_binding(value: i32, carven_match_subject: i32) -> i32 {
    return match value {
        _ => carven_match_subject,
    };
}

fn __identity(__value: i32) -> i32 {
    return __value;
}

fn mutate_and_reject(&value: i32) -> bool {
    value = 2;
    return false;
}

private import(cpp) fn cv_match_reset_evaluations();
private import(cpp) fn cv_match_subject_once() -> bool;
private import(cpp) fn cv_match_dead_guard() -> bool;
private import(cpp) fn cv_match_subject_evaluation_count() -> i32;
private import(cpp) fn cv_match_dead_guard_evaluation_count() -> i32;

fn next_match_subject() -> bool {
    return cv_match_subject_once();
}

test "Pattern matching: matches support statement value and binding forms" {
    var selected: i32 = 0;
    match classify(0) {
        1 => { selected = 1; },
        _ => { selected = -1; },
    }

    check(selected == 1);
    check(classify(3) == 6);
    check(preserve_outer_binding(7, 42) == 42);
    check(__identity(9) == 9);

    cv_match_reset_evaluations();
    let dead_arm_result = match next_match_subject() {
        false => 1,
        true => 2,
        _ if cv_match_dead_guard() => 3,
    };
    let subject_evaluations = cv_match_subject_evaluation_count();
    let dead_guard_evaluations = cv_match_dead_guard_evaluation_count();
    check(dead_arm_result == 2);
    check(subject_evaluations == 1);
    check(dead_guard_evaluations == 0);
    check(cv_match_dead_guard());

    let guarded_binding = match 1 {
        candidate if candidate == 0 => 10,
        1 => 20,
        _ => 30,
    };
    check(guarded_binding == 20);

    var mutable_subject: i32 = 1;
    var other: i32 = 0;
    let mutation_result = match mutable_subject {
        1 if mutate_and_reject(&other) => 10,
        1 => { mutable_subject = 3; 20 },
        _ => 30,
    };
    check(mutation_result == 20);
    check(other == 2);
    check(mutable_subject == 3);
}
