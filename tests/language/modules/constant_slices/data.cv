const table: [i32] = make_table(5);
const empty: [u16] = [];
const bytes = make_bytes();
const byte_tail: [u8] = bytes.slice(1, 4);

const rows: [[i32; 2]] = [
    [2, 4],
    [6, 8]
];

const fn make_table(offset: i32) -> [i32; 3] => [offset, offset + 2, offset + 4];

const fn make_bytes() -> Vector<u8> {
    var result = Vector<u8>::with_capacity(8);
    result.append([0u8, 127u8, 128u8, 255u8]);
    return &&result;
}

fn from_provider() -> [i32] => table;
fn provider_row() -> [i32] => rows[1];
