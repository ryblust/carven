import .data using { table, empty, bytes, byte_tail, rows, from_provider, provider_row }

const selected = table[1];
const tail = table.slice(1, table.length());
const selected_byte = byte_tail[1];
const byte_count = byte_tail.length();
const empty_bytes = byte_tail.slice(3, 3);

fn from_consumer() -> [i32] => table;

test "Modules: constant slices keep their contents across modules" {
    let provider = from_provider();
    let consumer = from_consumer();
    let row = provider_row();
    var index = 2;
    check(provider[index] == 9);
    check(consumer[index] == 9);
    check(table[index] == 9);
    check(selected == 7);
    check(tail.length() == 2usize);
    check(tail[1] == 9);
    check(empty.is_empty());
    check(row[0] == 6);
    check(row[1] == rows[1][1]);
    check(bytes.capacity() == 8);
    check(byte_count == 3);
    check(selected_byte == 128);
    check(byte_tail[2] == 255);
    check(empty_bytes.is_empty());
    var copy = bytes;
    copy[0] = 42;
    copy.push(7);
    check(bytes[0] == 0 && bytes.length() == 4);
    check(copy[0] == 42 && copy.length() == 5);
}
