import .api using { Box, Owned }
import .first using { HiddenBox, first }
import .second using second;

test "Generics: shared values and private types remain usable across modules" {
    let box = Box<i32> { value: 42 };
    check(second(box) == 42);
    check(first(box) == .Some(42));
    let hidden = HiddenBox::new(17);
    check(hidden.read() == 17);
    let owner = Owned<String>::new(&&("across modules" as String));
    check(owner.release().as_str() == "across modules");
}
