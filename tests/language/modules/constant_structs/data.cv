export struct Entry {
    key: i32,
    label: str,
}

export const records: [Entry] = make_records(4);
export const empty_records: [Entry] = [];
export const first_record: Entry = records[0];

const fn make_records(seed: i32) -> [Entry; 2] {
    var rows = [Entry { seed, "first" }, Entry { seed + 1, "我\0😀" }];
    rows[1].key += 10;
    return rows;
}

export fn provider_records() -> [Entry] => records;
