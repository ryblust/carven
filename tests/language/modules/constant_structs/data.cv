struct Entry {
    key: i32,
    label: str,
}

const records: [Entry] = make_records(4);
const empty_records: [Entry] = [];
const first_record: Entry = records[0];

const fn make_records(seed: i32) -> [Entry; 2] {
    var rows = [
        Entry { seed,     "first"     },
        Entry { seed + 1, "我\0😀" }
    ];
    rows[1].key += 10;
    return rows;
}

fn provider_records() -> [Entry] => records;
