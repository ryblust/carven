private class Counter {
    value: i32,

    fn new(value: i32) -> Counter => { value: value };
    fn read(self) -> i32 => self.value;

    fn increment(&self, amount: i32) {
        self.value += amount;
    }

    private fn twice(self) -> i32 => self.value * 2;

    fn from_other(self, other: Counter) -> i32 {
        let copy = other;
        let observe = [copy]() -> i32 => copy.value;
        return observe() + self.twice();
    }
}

private class Empty {

    fn new() -> Empty => {};
}

private fn argument(&trace: i32) -> i32 {
    trace = trace * 10 + 2;
    return 5;
}

private class Receiver {
    value: i32,

    fn new(value: i32) -> Receiver => { value: value };
    fn sum(self, value: i32) -> i32 => self.value + value;
}

private fn receiver(&trace: i32) -> Receiver {
    trace = trace * 10 + 1;
    return Receiver::new(7);
}

test "Classes: factories, receivers and lexical access compose ordinary value rules" {
    let factory: fn(i32) -> Counter = Counter::new;
    var counter = factory(3);
    counter.increment(4);
    check(counter.read() == 7);
    let copy = counter;
    counter.increment(1);
    check(copy.read() == 7);
    check(counter.from_other(copy) == 23);
    let _ = Empty::new();
    check(counter.read() == 8);
    var trace = 0;
    check(receiver(&trace).sum(argument(&trace)) == 12);
    check(trace == 12);
    let array = [Counter::new(1), Counter::new(2)];
    check(array[1].read() == 2);
}

private class Label {
    text: String,

    fn new(text: str) -> Label => { text: text as String };
    fn view(self) -> str => self.text;

    fn replace(&self, text: str) {
        self.text = text as String;
    }
}

test "Classes: private owning storage retains ordinary copy and borrow behavior" {
    var label = Label::new("first");
    let copy = label;
    label.replace("second");
    check(copy.view() == "first");
    check(label.view() == "second");
}

private class TextBuilder {
    text: String,

    fn new() -> TextBuilder => { text: {} };

    fn append(&self, text: str) {
        self.text.append(text);
    }

    fn build(&&self) -> String => (&&self).text;
}

test "Classes: Take builder delivers its owning string" {
    var builder = TextBuilder::new();
    builder.append("Car");
    builder.append("ven");
    let result = builder.build();
    check(result.as_str() == "Carven");
    check(TextBuilder::new().build().as_str() == "");
}

private class StaticCounter {
    value: i32,

    private const fn initial(value: i32) -> i32 => if value < 0 { 0 } else { value };

    const fn new(value: i32) -> StaticCounter => { value: StaticCounter::initial(value) };

    const fn increment(&self) {
        self.value += 1;
    }

    const fn read(self) -> i32 => self.value;

    const fn default_value() -> i32 {
        const value = StaticCounter { value: StaticCounter::initial(4) }.value;
        return value;
    }
}

private const fn static_counter_value() -> i32 {
    var counter = StaticCounter::new(-1);
    counter.increment();
    var copy = counter;
    copy.increment();
    return counter.read() * 10 + copy.read();
}

private class Cell<T> {
    value: T,

    const fn new(&&value: T) -> Cell<T> => { value: &&value };
    const fn take(&&self) -> T => (&&self).value;
    const fn view(&self) -> ptr<T> => addressof(self.value);

    const fn replace(&self, &&value: T) {
        self.value = &&value;
    }

    private const fn forward<U>(self, &&value: U) -> U => &&value;
    const fn pass<U>(self, &&value: U) -> U => self.forward<U>(&&value);
}

private class Key<T: Hash> {

    const fn hash(value: T) -> u64 => Hash::hash(value);
    const fn pass<Hash>(&&value: Hash) -> Hash => &&value;
}

const test "Classes: const operations preserve private construction, mutation and independent copies" {
    check(static_counter_value() == 12);
    var cell = Cell<i32>::new(&&17);
    cell.replace(&&42);
    let view = cell.view();
    if view != nullptr { check(*view == 42); }
    check(cell.pass<String>(&&("value" as String)).as_str() == "value");
    check(cell.take() == 42);
    let text = Cell<String>::new(&&("Carven" as String));
    check(text.take().as_str() == "Carven");
    check(Key<i32>::hash(42) == Hash::hash(42));
    check(Key<i32>::pass<String>(&&("key" as String)).as_str() == "key");
}

private const direct_counter = StaticCounter::new(7);
private const direct_counter_value = direct_counter.read();

private fn direct_counter_array() -> [i32; StaticCounter::new(3).read() as usize] {
    const value = StaticCounter::new(5).read();
    return [value; 3];
}

const test "Classes: constant roots call associated and receiver operations" {
    check(direct_counter_value == 7);
    check(StaticCounter::new(-1).read() == 0);
    check(StaticCounter::default_value() == 4);
}

test "Classes: local constants and type extents call const operations" {
    check(direct_counter_array() == [5, 5, 5]);
}
