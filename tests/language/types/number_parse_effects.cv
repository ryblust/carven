import std::core using { i32 as Count, NumberParseError as InvalidNumber }

const forward_value = forward()?;

private const fn forward() -> i32 throw InvalidNumber => parse_later("42")?;

private const fn parse_later(text: str) -> i32 throw InvalidNumber => i32::parse(text)?;

const fn observe(&count: i32, text: str) -> str {
    count += 1;
    return text;
}

const fn checked_count(text: str) -> i32 throw InvalidNumber => Count::parse(text)?;

private const fn effects() -> bool throw InvalidNumber {
    if forward_value != 42 { return false; }
    var count = 0;
    let parsed = Count::parse(observe(&count, "123"))?;
    if parsed != 123 || count != 1 { return false; }
    try {
        Count::parse(observe(&count, "invalid"))?;
        return false;
    } catch {
        InvalidNumber(error) => {
            if error != InvalidNumber::Invalid || count != 2 { return false; }
        },
    }
    var text: String = "456";
    let independent = checked_count(text)?;
    text.clear();
    return independent == 456;
}

const test "Numeric parsing: static aliases failures and input effects" {
    check(
        try {
            effects()?
        } catch {
            InvalidNumber(_) => false
        }
    );
}

test "Numeric parsing: native aliases failures and independent results" {
    check(
        try {
            effects()?
        } catch {
            InvalidNumber(_) => false
        }
    );
}
