fn private_answer() -> i32 {
    return 42;
}

fn check(value: bool) -> bool {
    return value;
}

#[cpp] {
    inline int cv_test_inline_operation_trace = 0;

    inline auto cv_test_inline_condition(int digit, bool value) noexcept -> bool {
        cv_test_inline_operation_trace = cv_test_inline_operation_trace * 10 + digit;
        return value;
    }

    inline auto cv_test_inline_message(int digit, std::string_view value) noexcept
        -> std::string_view {
        cv_test_inline_operation_trace = cv_test_inline_operation_trace * 10 + digit;
        return value;
    }
}

fn traced_condition(digit: i32, value: bool) -> bool {
    return #[cpp] { cv_test_inline_condition }(digit, value);
}

fn traced_message(digit: i32, value: str) -> str {
    return #[cpp] { cv_test_inline_message }(digit, value);
}

test "Testing: inline tests access module-private declarations" {
    check(private_answer() == 42);
    require(true);
}

test "Testing: inline-test operands are eager, ordered, and evaluated once" {
    #[cpp] { cv_test_inline_operation_trace = 0; }
    check(traced_condition(1, true), traced_message(2, "check message"));
    require(traced_condition(3, true), traced_message(4, "require message"));
    check(#[cpp] { cv_test_inline_operation_trace } == 1234);
}

test "Testing: inline-test context reaches control blocks but not lambdas" {
    if true {
        check(true);
    }
    for value in [1, 2] {
        require(value > 0);
    }
    match 1 {
        1 => { check(true); },
        _ => { fail("unselected arm"); },
    }
    let callback = []() { return check(true); };
    let ordinary = check(callback());
    check(ordinary);
}
