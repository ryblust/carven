fn private_answer() -> i32 => 42;

fn ordinary_check(value: bool) -> bool => value;

fn traced_condition(&trace: i32, digit: i32, value: bool) -> bool {
    trace = trace * 10 + digit;
    return value;
}

fn traced_message(&trace: i32, digit: i32, value: str) -> str {
    trace = trace * 10 + digit;
    return value;
}

test "Testing: inline tests access module-private declarations" {
    check(private_answer() == 42);
    require(true);
}

test "Testing: inline-test operands are eager, ordered, and evaluated once" {
    var trace = 0;
    check(traced_condition(&trace, 1, true), traced_message(&trace, 2, "check message"));
    require(traced_condition(&trace, 3, true), traced_message(&trace, 4, "require message"));
    check(trace == 1234);
}

test "Testing: test calls compose with control blocks and lambdas" {
    if true {
        check(true);
    }
    for value in [1, 2] {
        require(value > 0);
    }
    match 1 {
        1 => { check(true); },
        _ => { fail("unselected arm"); },
    }
    let callback = []() { check(true); };
    callback();
    let ordinary = ordinary_check(true);
    check(ordinary);
}

test "Testing: test exits do not participate in value-region merges" {
    let selected_if = if true {
        require(true);
        11
    } else {
        fail("unselected value-if branch");
    };

    let selected_match = match 1 {
        1 => {
            require(true);
            22
        },
        _ => { fail("unselected value-match arm"); },
    };

    let selected_try = try {
        require(true);
        33
    } catch {
        _ => { fail("unreachable value-try handler"); },
    };

    check(selected_if == 11);
    check(selected_match == 22);
    check(selected_try == 33);
}

test "Testing: local callable names shadow builtins in every position" {
    let assertion: fn(bool) -> void = check;
    let check = [](value: bool) -> bool { return !value; };
    let fail = []() -> i32 { return 17; };
    let println = [](value: i32) -> i32 { return value + 1; };
    assertion(check(false));
    check(false);
    assertion(fail() == 17);
    fail();
    assertion(println(4) == 5);
    println(4);
}
