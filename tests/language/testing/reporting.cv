import "testing/reporting.hpp";

private import(cpp) fn cv_test_reporting_mark(bit: i32);
private import(cpp) fn cv_test_reporting_condition(bit: i32, value: bool) -> bool;

fn traced_reporting_condition(bit: i32, value: bool) -> bool {
    return cv_test_reporting_condition(bit, value);
}

fn traced_reporting_message(bit: i32, value: str) -> str {
    cv_test_reporting_mark(bit);
    return value;
}

test "Testing: check failure reports and continues" {
    check(
        traced_reporting_condition(
            0,
            // The source contract preserves comments inside the expression span.
            false,
        ),
        traced_reporting_message(1, "check message"),
    );
    cv_test_reporting_mark(2);
}

test "Testing: require failure reports and exits" {
    require(traced_reporting_condition(3, false), traced_reporting_message(4, "require message"));
    cv_test_reporting_mark(5);
}

test "Testing: fail reports and exits" {
    fail(traced_reporting_message(6, "fail message"));
    cv_test_reporting_mark(7);
}

test "Testing: require exits across nested control" {
    while true {
        if true {
            require(traced_reporting_condition(8, false));
        }
    }
    cv_test_reporting_mark(9);
}

private import(cpp) fn cv_test_reporting_verify();

// Entry points: ordinary results are discarded after local cleanup.
fn main() -> i32 {
    let owner = ::cv_test_entry_begin();
    cv_test_reporting_verify();
    return 29;
}

fn stop_in_helper(action: fn() -> void) -> i32 {
    let owner = ::ReportingOwner(10);
    action();
    cv_test_reporting_mark(11);
    return 42;
}

test "Testing: callback failure leaves helpers and cleans up" {
    let owner = ::ReportingOwner(12);
    let stop: fn() -> void = fail;
    let value = stop_in_helper(stop);
    cv_test_reporting_mark(13);
    check(value == 42);
}

struct ReportingFailure {}

fn stop_with_failure_view(action: fn() -> void throw ReportingFailure) -> i32 throw ReportingFailure {
    action()?;
    cv_test_reporting_mark(14);
    return 1;
}

test "Testing: test exit bypasses typed catches and widened views" {
    let stop: fn() -> void = fail;
    let widened: fn() -> void throw ReportingFailure = stop;
    let value = try { stop_with_failure_view(widened)? } catch {
        _ => { cv_test_reporting_mark(15); 2 },
    };
    cv_test_reporting_mark(16);
    check(value == 1);
}

test "Testing: runner continues after failed helpers" {
    cv_test_reporting_mark(17);
    let assertion: fn(bool, String) -> void = check;
    assertion(true, "owned test message");
}

fn stop_in_result() -> i32 { return fail("no result"); }

test "Testing: a non-completing builtin can occupy a result position" {
    let value = stop_in_result();
    cv_test_reporting_mark(18);
    check(value == 0);
}

fn require_in_helper(value: bool) {
    let owner = ::ReportingOwner(19);
    require(value);
    cv_test_reporting_mark(20);
}

test "Testing: require failure leaves helpers and the current test" {
    let owner = ::ReportingOwner(21);
    require_in_helper(false);
    cv_test_reporting_mark(22);
}

test "Testing: temporary messages survive direct and callable reports" {
    check(false, String::from_str("direct temporary message with enough text for owned storage"));
    require(false, String::from_str("explicit temporary message with enough text for owned storage").as_str());
}

test "Testing: callable reports retain temporary messages" {
    let assertion: fn(bool, String) -> void = check;
    assertion(false, String::from_str("callable temporary message with enough text for owned storage"));
}
