import std::async using { cancel_requested, yield_once, wait_ready, close }
import std::time using { timeout as deadline, Duration, TimeRangeError, sleep, Timeout }

async fn delayed(value: i32, duration: Duration) -> i32 throw TimeRangeError {
    await sleep(duration)?;
    return value;
}

async fn touch(&started: i32) -> i32 {
    ++started;
    return 42;
}

async fn cooperative(&started: i32, &closed: i32) -> i32 {
    ++started;
    while cancel_requested() == false {
        await yield_once();
    }
    ++closed;
    return 17;
}

async fn protected(&started: i32, &closed: i32) -> i32 throw Timeout + TimeRangeError {
    return await deadline(cooperative(&started, &closed), 86400s)?;
}

async test "Async timeout: expiration, completion, and cooperative cleanup" {
    try {
        var started = 0;
        let zero = try {
            let _ = await deadline(touch(&started), 0ns)?;
            false
        } catch {
            Timeout(_) => true,
            TimeRangeError(_) => false,
        };
        let negative = try {
            let _ = await deadline(touch(&started), -9223372036854775808ns)?;
            false
        } catch {
            Timeout(_) => true,
            TimeRangeError(_) => false,
        };
        let expired = try {
            let _ = await deadline(delayed(7, 100ms), 1ms)?;
            false
        } catch {
            Timeout(_) => true,
            TimeRangeError(_) => false,
        };
        let completed = try {
            await deadline(touch(&started), 86400s)? == 42
        } catch {
            Timeout(_) => false,
            TimeRangeError(_) => false,
        };
        check(zero && negative && expired && completed && started == 1);
        var closed = 0;
        let drained = try {
            let _ = await deadline(cooperative(&started, &closed), 1ms)?;
            false
        } catch {
            Timeout(_) => true,
            TimeRangeError(_) => false,
        };
        check(drained && started == 2 && closed == 1);

        async let parent = protected(&started, &closed);
        // cooperative() increments started through a mutable borrow while this task yields.
        // Generated C++ triggers bugprone-infinite-loop, which misses that coroutine update.
        while started != 3 {
            await yield_once();
        }
        cancel parent;
        let (_, cancelled) = await wait_ready(parent);
        await close(parent);
        check(cancelled && closed == 2);
    } catch {
        TimeRangeError(_) => fail("unexpected time range failure"),
    }
}
