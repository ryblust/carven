struct LoopStepFailure {}

const fn read_temporary_values() -> String {
    let first = "first" as String;
    let second = "second" as String;
    var result: String = {};
    var index = 0;
    for value in [first, second, first] {
        ++index;
        if index == 2 { continue; }
        result.append_format(f"{value}");
        if index == 3 { break; }
    }
    return &&result;
}

const fn read_temporary_snapshots() -> String {
    var first = "old" as String;
    let second = "tail" as String;
    var result: String = {};
    for value in [first, second] {
        first.clear();
        result.append(value);
    }
    first = "alias" as String;
    let address = addressof(&first);
    for value in [first] {
        address->clear();
        result.append(value);
    }
    return &&result;
}

const fn separate_read_object(value: String, original: ptr<String>) -> bool {
    return addressof(value) != original;
}

const fn read_temporary_identity() -> bool {
    let original = "object" as String;
    let address = addressof(original);
    var separate = true;
    for value in [original, original] {
        separate = separate && separate_read_object(value, address);
    }
    return separate;
}

const test "Read traversal: temporary elements retain values through source writes and exits" {
    check(read_temporary_values().as_str() == "firstfirst");
    check(read_temporary_snapshots().as_str() == "oldtailalias");
    check(read_temporary_identity());
}

test "Read traversal: native temporary elements retain snapshots through source writes and exits" {
    check(read_temporary_values().as_str() == "firstfirst");
    check(read_temporary_snapshots().as_str() == "oldtailalias");
    check(read_temporary_identity());
}

fn record_loop_effect(&trace: i32, result: i32) -> i32 {
    trace += 1;
    return result;
}

fn advance_loop_step(&value: i32, fail: bool) throw LoopStepFailure {
    if fail { throw LoopStepFailure {}; }
    value += 1;
}

fn loop_condition(&checks: i32, remaining: i32) -> bool {
    checks += 1;
    return remaining > 0;
}

const fn returning_loop(enabled: bool, &trace: i32) -> i32 {
    for trace = trace * 10 + 1;
        if true {
            trace = trace * 10 + 2;
            enabled
        } else {
            false
        };
        trace = trace * 10 + 4 {
        trace = trace * 10 + 3;
        if true { return 42; }
    }
    return 7;
}

const fn known_true_returning_loop(&trace: i32) -> i32 {
    for trace = trace * 10 + 1;
        if true {
            trace = trace * 10 + 2;
            true
        } else {
            false
        };
        trace = trace * 10 + 4 {
        trace = trace * 10 + 3;
        return 42;
    }
    return 7;
}

const fn returning_loop_effects() -> bool {
    var trace = 0;
    let skipped = (returning_loop(false, &trace), trace);
    trace = 0;
    let entered = (returning_loop(true, &trace), trace);
    trace = 0;
    let known_true = (known_true_returning_loop(&trace), trace);
    return skipped == (7, 12) && entered == (42, 123) && known_true == (42, 123);
}

const test "Loops: returns preserve initialization and condition order and skip steps" {
    check(returning_loop_effects());
}

test "Loops: native returns preserve initialization and condition order and skip steps" {
    check(returning_loop_effects());
}

test "Loops: loops support clauses iteration and control transfer" {
    var total: i32 = 0;
    for var index: i32 = 0; index < 4; ++index {
        total += index;
    }

    var odd_total: i32 = 0;
    for var index: i32 = 0; index < 6; ++index {
        if index % 2 == 0 { continue; }
        odd_total += index;
    }

    let values: [i32; 3] = [1, 2, 3];
    for value: i32 in values {
        total += value;
    }

    let shadowed: [i32; 2] = [20, 22];
    var shadowed_total: i32 = 0;
    for shadowed in shadowed {
        shadowed_total += shadowed;
    }

    var writable_values: [i32; 3] = [1, 2, 3];
    for &value in writable_values {
        value += 10;
    }

    var countdown: i32 = 2;
    while countdown > 0 {
        --countdown;
    }

    var remaining = 3;
    var condition_checks = 0;
    while loop_condition(&condition_checks, remaining) {
        remaining -= 1;
        continue;
    }
    check(condition_checks == 4);
    check(remaining == 0);

    var assigned: i32 = 7;
    for assigned = 0; assigned < 2; assigned = assigned + 1 {
    }

    var multi_index: i32 = 0;
    var accumulated: i32 = 0;
    var flipped = false;
    for ; multi_index < 3; ++multi_index, accumulated += multi_index, flipped = !flipped {
    }

    var mutation_values: [i32; 1] = [0];
    var mutation_trace: i32 = 0;
    var mutation_index: i32 = 0;
    for ;
        mutation_index < 1;
        mutation_values[record_loop_effect(&mutation_trace, 0)] += record_loop_effect(
            &mutation_trace,
            1
        ),
        ++mutation_index {
    }

    var recovered_index: i32 = 0;
    var recovered_visits: i32 = 0;
    try {
        for ; recovered_index < 2; advance_loop_step(&recovered_index, false)? {
            recovered_visits += 1;
            if recovered_visits == 1 { continue; }
        }
    } catch {
        LoopStepFailure(_) => {},
    }

    var constant_false_trace: i32 = 0;
    for record_loop_effect(&constant_false_trace, 0);
        false;
        record_loop_effect(&constant_false_trace, 0) {
        constant_false_trace += 100;
    }

    check(total == 12);
    check(odd_total == 9);
    check(shadowed_total == 42);
    check(writable_values[0] == 11);
    check(writable_values[1] == 12);
    check(writable_values[2] == 13);
    check(countdown == 0);
    check(assigned == 2);
    check(multi_index == 3);
    check(accumulated == 6);
    check(flipped);
    check(mutation_trace == 2);
    check(mutation_values[0] == 1);
    check(mutation_index == 1);
    check(recovered_index == 2);
    check(recovered_visits == 2);
    check(constant_false_trace == 1);
}
