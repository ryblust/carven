import .expression_bodies using { expression_closure, expression_nested };

fn imported_closure() => expression_closure(10);

fn imported_nested() => []() => expression_closure(5);

fn imported_capture() => []() {
    let callback = expression_closure(9);
    return [callback](value: i32) => callback(value);
}();

test "Functions: inferred closure results cross module interfaces" {
    let first = imported_closure();
    check(first(2) == 12);
    let factory = imported_nested();
    let second = factory();
    check(second(3) == 8);
    let captured = imported_capture();
    check(captured(1) == 10);
    let nested = expression_nested();
    let last = nested(4);
    check(last(2) == 6);
}
