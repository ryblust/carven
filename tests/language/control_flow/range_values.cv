const fn sum_interval(values: Range<i32>) -> i32 {
    var sum = 0;
    for value in values {
        sum += value;
    }
    return sum;
}

const fn make_interval(end: i32) -> Range<i32> => 1..=end;

const fn sum_size_interval(values: Range<usize>) -> usize {
    var sum = 0usize;
    for value in values {
        sum += value;
    }
    return sum;
}

const fn make_size_interval() -> Range<usize> => 0..4;

const range_end = 4usize;
const frozen_size_interval = 0..range_end;

const fn check_literal_bounds(end: usize) {
    let exclusive = 0..end;
    let inclusive = 0..=end;
    check(sum_size_interval(exclusive) == 6usize);
    check(sum_size_interval(inclusive) == 10usize);
    let grouped: Range<usize> = (0)..end;
    check(sum_size_interval(grouped) == 6usize);
    let begin = 1usize;
    let right_literal = begin..4;
    check(sum_size_interval(right_literal) == 6usize);

    let defaulted = 0..4;
    check(sum_interval(defaulted) == 6);
    let contextual: Range<usize> = 0..=4;
    check(sum_size_interval(contextual) == 10usize);
    check(sum_size_interval(0..4) == 6usize);
    check(sum_size_interval(make_size_interval()) == 6usize);
    check(sum_size_interval(frozen_size_interval) == 6usize);
}

fn range_endpoint(&trace: i32, digit: i32, value: usize) -> usize {
    trace = trace * 10 + digit;
    return value;
}

fn check_bound_evaluation() {
    var trace = 0;
    let exclusive = 0..range_endpoint(&trace, 1, 4usize);
    check(trace == 1);
    check(sum_size_interval(exclusive) == 6usize);
    check(trace == 1);

    trace = 0;
    let inclusive = 0..=range_endpoint(&trace, 2, 4usize);
    check(trace == 2);
    check(sum_size_interval(inclusive) == 10usize);
    check(trace == 2);

    trace = 0;
    let ordered = range_endpoint(&trace, 1, 1usize)..range_endpoint(&trace, 2, 4usize);
    check(trace == 12);
    check(sum_size_interval(ordered) == 6usize);
    check(trace == 12);

    trace = 0;
    var sum = 0usize;
    for value in range_endpoint(&trace, 1, 1usize)..range_endpoint(&trace, 2, 4usize) {
        sum += value;
        continue;
    }
    check(sum == 6usize && trace == 12);
}

const test "Range values: literal bounds adopt endpoint and destination types" {
    check_literal_bounds(4usize);
}

test "Range values: native literal bounds preserve contextual types and evaluation" {
    var end = 3usize;
    end += 1usize;
    check_literal_bounds(end);
    check_bound_evaluation();
}

const test "Range values: constants and calls share interval semantics" {
    let interval = make_interval(4);
    check(sum_interval(interval) == 10);
    check(sum_interval(4..1) == 0);
    check(sum_interval(1..1) == 0);
    check(sum_interval(1..=1) == 1);
    var count = 0;
    for _ in 254u8..=255u8 {
        count += 1;
        continue;
    }
    check(count == 2);
}

test "Range values: construction and iteration retain independent snapshots" {
    var end = 4;
    var interval = 1..end;
    end = 8;
    check(sum_interval(interval) == 6);
    var sum = 0;
    for value in interval {
        interval = 10..20;
        sum += value;
    }
    check(sum == 6);
    check(sum_interval(make_interval(4)) == 10);
    var count = 0;
    for _ in 18446744073709551614u64..=18446744073709551615u64 {
        count += 1;
        continue;
    }
    check(count == 2);
}

const fn count_signed_interval(values: Range<i64>) -> usize {
    var count = 0usize;
    for _ in values {
        count += 1usize;
        continue;
    }
    return count;
}

test "Range values: inclusive snapshots reach signed maxima through continue" {
    var interval = 9223372036854775806i64..=9223372036854775807i64;
    check(count_signed_interval(interval) == 2usize);
    var count = 0usize;
    for _ in interval {
        interval = 10i64..20i64;
        count += 1usize;
        continue;
    }
    check(count == 2usize);
}

test "Ranges: ranges preserve bounds expressions and iteration semantics" {
    var ascending_total: i32 = 0;
    for value: i32 in 1..4 {
        ascending_total += value;
    }

    let begin: i32 = 1;
    let end: i32 = 6;
    var expression_total: i32 = 0;
    for value in (begin + 1)..(end - 1) {
        expression_total += value;
    }

    var empty_total: i32 = 0;
    for value in begin..begin {
        empty_total += value;
    }
    for value in end..begin {
        empty_total += value;
    }

    var filtered_total: i32 = 0;
    for value in begin..end {
        match value {
            2 => continue,
            5 => break,
            _ => {},
        }
        filtered_total += value;
    }

    check(ascending_total == 6);
    check(expression_total == 9);
    check(empty_total == 0);
    check(filtered_total == 8);
}
