import std::json using {
    JSONError,
    JSONErrorKind,
    JSONValueError,
    decode_string,
    validate,
    JSONValue,
}

import std::utf using UTF8Error;

test "JSON: decoded strings own independent Unicode text" {
    try {
        var plain: String = r#""你好😀""#;
        let decoded_plain = decode_string(plain)?;
        plain.clear();
        check(decoded_plain == "你好😀");
        var escaped: String = r#""a\u0000\u00e9\uD83D\uDE00\"\\\/\b\f\n\r\t""#;
        let decoded_escaped = decode_string(escaped)?;
        escaped.clear();
        check(decoded_escaped == "a\u{0}é😀\"\\/\u{8}\u{c}\n\r\t");
        check(decode_string("\"\"")? == "");
    } catch {
        JSONError(_) => fail("valid strings must decode"),
    }
}

private struct InvalidString {
    text: str,
    kind: JSONErrorKind,
    offset: usize,
}

test "JSON: decoding checks its quoted-string boundary and preserves scanner errors" {
    let inputs = [
        InvalidString {
            text: "",
            kind: .UnexpectedEnd,
            offset: 0
        },
        {
            text: "true",
            kind: .UnexpectedByte,
            offset: 0
        },
        {
            text: " \"a\"",
            kind: .UnexpectedByte,
            offset: 0
        },
        {
            text: "\"a\" ",
            kind: .TrailingInput,
            offset: 3
        },
        {
            text: r#""\x""#,
            kind: .InvalidEscape,
            offset: 2
        },
    ];
    for input in inputs {
        var rejected = false;
        try {
            let _ = decode_string(input.text)?;
        } catch {
            JSONError(error) => {
                rejected = error.kind == input.kind && error.offset == input.offset;
            },
        }
        check(rejected, f"JSON string: {input.text}");
    }
}

test "JSON: escape and UTF sequences cross block boundaries" {
    for length in [0usize, 15, 16, 17, 31, 32, 33, 63] {
        var input: String = "\"";
        var expected = String {};
        for _ in 0..length {
            input.push('a');
            expected.push('a');
        }
        input.append(r#"\"\uD83D\uDE00你好"#);
        input.push('"');
        expected.append("\"😀你好");
        try {
            check(decode_string(input)? == expected);
            check(JSONValue::parse(input)?.as_str()? == expected);
        } catch {
            JSONError(_) => fail("block boundaries must preserve decoding"),
            JSONValueError(_) => fail("a quoted document must produce a string"),
        }
    }
}

private fn same_syntax_error(text: str) -> bool {
    var expected = JSONError {
        kind: .UnexpectedEnd,
        offset: 0
    };
    var invalid = false;
    try {
        validate(text)?;
    } catch {
        JSONError(error) => {
            expected = error;
            invalid = true;
        },
    }
    if invalid == false { return false; }
    try {
        let _ = JSONValue::parse(text)?;
    } catch {
        JSONError(error) => return error.kind == expected.kind && error.offset == expected.offset,
    }
    return false;
}

test "JSON parse: events build independent owners and preserve nested value kinds" {
    var input: String = r#"{"\u006b":[null,true,{"s":"owned","n":123}],"empty":{"":[]}}"#;
    try {
        let document = JSONValue::parse(input)?;
        input.clear();
        check(document.kind() == .Object);
        check(document.length()? == 2);
        check(document.key_at(0)? == "k" && document.key_at(1)? == "empty");
        let values = document.member_value_at(0)?;
        check(values.length()? == 3);
        check(values.at(0)?.kind() == .Null);
        check(values.at(1)?.as_bool()?);
        let object = values.at(2)?;
        check(object.get("s")?.as_str()? == "owned");
        check(object.get("n")?.number_text()? == "123");
        let empty = document.member_value_at(1)?;
        check(empty.get("")?.length()? == 0);
    } catch {
        JSONError(error) => fail(f"parse rejected valid input at byte {error.offset}"),
        JSONValueError(_) => fail("parsed value has an unexpected shape"),
    }
}

test "JSON parse: syntax failures retain the validator's kind and byte position" {
    check(same_syntax_error(r#"{"key":[null,{"\u00x0":1}]}"#));
    check(same_syntax_error("{} false"));
}

test "JSON parse: byte ingress rejects encoding before document syntax" {
    let bytes = [0x5bu8, 0x31, 0x2c, 0x5d, 0xff];
    var rejected_encoding = false;
    try {
        let _ = JSONValue::parse_bytes(bytes)?;
    } catch {
        UTF8Error(error) => { rejected_encoding = error.offset == 4; },
        JSONError(_) => {},
    }
    check(rejected_encoding);
}

// Every escaped ASCII byte must recover its scalar, including embedded NUL.
test "JSON: serialization preserves scalars and escapes controls" {
    try {
        var text = String {};
        for scalar in 0u32..32u32 {
            text.push(char::from_u32_unchecked(scalar));
        }
        text.append("\"\\/é你好😀");
        let value = JSONValue::string(text);
        let encoded = value.to_json()?;
        validate(encoded)?;
        check(JSONValue::parse(encoded)?.as_str()? == text.as_str());
        check(JSONValue::string("").to_json()? == "\"\"");
        check(JSONValue::null().to_json()? == "null");
        check(JSONValue::boolean(true).to_json()? == "true");
        check(JSONValue::boolean(false).to_json()? == "false");
    } catch {
        JSONError(_) => check(false),
        JSONValueError(_) => check(false),
    }
}

test "JSON: serialization preserves member order, duplicates and number spelling" {
    try {
        let input = r#"{"x":1E400,"x":-0,"items":[[],{},1.2300e+04]}"#;
        let value = JSONValue::parse(input)?;
        let encoded = value.to_json()?;
        check(encoded.as_str() == input);
        check(JSONValue::parse(encoded)?.to_json()?.as_str() == input);
    } catch {
        JSONError(_) => check(false),
        JSONValueError(_) => check(false),
    }
}

test "JSON: writing checks the container depth of constructed values" {
    try {
        var nested = JSONValue::null();
        for _ in 0..64 {
            var parent = JSONValue::array();
            parent.push(&&nested)?;
            nested = &&parent;
        }
        validate(nested.to_json()?)?;
        var parent = JSONValue::array();
        parent.push(&&nested)?;
        var rejected = false;
        try {
            let _ = parent.to_json()?;
        } catch {
            JSONValueError(error) => {
                check(error == .DepthLimit);
                rejected = true;
            },
        }
        check(rejected);
    } catch {
        JSONError(_) => check(false),
        JSONValueError(_) => check(false),
    }
}
