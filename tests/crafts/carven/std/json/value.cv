import std::json using { JSONError, JSONValueError, JSONValue, JSONValueKind }

// Owning values and mutation are runtime contracts.
test "JSON values: numeric construction and conversion preserve their one spelling" {
    try {
        let signed = JSONValue::integer(-9223372036854775807i64 - 1);
        let unsigned = JSONValue::unsigned_integer(18446744073709551615u64);
        check(signed.kind() == .Number);
        check(signed.number_text()? == "-9223372036854775808");
        check(signed.as_i64()? == -9223372036854775807i64 - 1);
        check(unsigned.number_text()? == "18446744073709551615");
        check(unsigned.as_u64()? == 18446744073709551615u64);
        let real = JSONValue::real(1.25)?;
        check(real.number_text()? == "1.25");
        check(real.as_f64()? == 1.25);
        let exact = JSONValue::number("1E400")?;
        check(exact.number_text()? == "1E400");
        check(exact.to_json()? == "1E400");
        let negative_zero = JSONValue::number("-0")?;
        check(negative_zero.number_text()? == "-0");
        check(negative_zero.as_i64()? == 0);
        let decimal = JSONValue::number("1.00e+02")?;
        check(decimal.number_text()? == "1.00e+02");
        check(decimal.as_f64()? == 100.0);
        check(decimal.number_text()? == "1.00e+02");
    } catch {
        JSONError(_) => fail("valid numeric spelling must construct"),
        JSONValueError(_) => fail("representable conversions must succeed"),
    }
}

test "JSON values: unrepresentable numeric conversions and nonfinite construction fail" {
    try {
        let inputs = ["1E400", "9223372036854775808", "1.5", "1e2"];
        for input in inputs {
            let value = JSONValue::number(input)?;
            var rejected = false;
            try {
                let _ = value.as_i64()?;
            } catch {
                JSONValueError(error) => { rejected = error == .NumberConversion; },
            }
            check(rejected);
            check(value.number_text()? == input);
        }
        let negative = JSONValue::number("-1")?;
        var rejected = false;
        try {
            let _ = negative.as_u64()?;
        } catch {
            JSONValueError(error) => { rejected = error == .NumberConversion; },
        }
        check(rejected);
        let huge = JSONValue::number("1E400")?;
        rejected = false;
        try {
            let _ = huge.as_f64()?;
        } catch {
            JSONValueError(error) => { rejected = error == .NumberConversion; },
        }
        check(rejected);
        for value in [1.0f64 / 0.0, -1.0f64 / 0.0, 0.0f64 / 0.0] {
            rejected = false;
            try {
                let _ = JSONValue::real(value)?;
            } catch {
                JSONValueError(error) => { rejected = error == .NumberConversion; },
            }
            check(rejected);
        }
    } catch {
        JSONError(_) => fail("number grammar must accept conversion failures"),
        JSONValueError(_) => fail("reading valid numeric spelling must succeed"),
    }
}

test "JSON values: array edits change their selected elements and preserve owned reads" {
    try {
        var array = JSONValue::array();
        array.push(&&JSONValue::integer(1))?;
        array.push(&&JSONValue::string("你好"))?;
        check(array.kind() == .Array && array.length()? == 2);
        let snapshot = array.at(1)?;
        let selected = array.elements()?[1];
        var text = String {};
        for child in array.elements()? {
            text.append(
                if child.kind() == .Number { child.number_text()? } else { child.as_str()? }
            );
        }
        check(text == "1你好");
        array.set_at(1, &&JSONValue::boolean(true))?;
        check(snapshot.as_str()? == "你好");
        check(selected.as_str()? == "你好");
        check(array.at(1)?.as_bool()?);
        array.remove_at(0)?;
        check(array.length()? == 1 && array.at(0)?.as_bool()?);
        let copied = array;
        array.set_at(0, &&JSONValue::null())?;
        check(copied.at(0)?.as_bool()?);
        check(array.at(0)?.kind() == .Null);
    } catch {
        JSONValueError(_) => fail("array edits within bounds must succeed"),
    }
}

test "JSON values: ordered duplicate members use last lookup and complete erase" {
    try {
        var object = JSONValue::object();
        object.append_member("x", &&JSONValue::integer(1))?;
        object.append_member("y", &&JSONValue::integer(2))?;
        object.append_member("x", &&JSONValue::integer(3))?;
        check(object.length()? == 3);
        check(object.members()?[0].0.as_str() == "x" && object.members()?[1].0.as_str() == "y");
        check(object.members()?[0].1.as_i64()? == 1);
        var keys = String {};
        var sum = 0i64;
        for (key, value) in object.members()? {
            keys.append(key);
            sum += value.as_i64()?;
        }
        check(keys == "xyx" && sum == 6);
        let snapshot = object.get("x")?;
        object.set("x", &&JSONValue::integer(4))?;
        check(snapshot.as_i64()? == 3);
        check(object.get("x")?.as_i64()? == 4);
        check(object.members()?[0].1.as_i64()? == 1);
        check(object.length()? == 3 && object.members()?[2].0.as_str() == "x");
        object.set("z", &&JSONValue::boolean(false))?;
        check(object.length()? == 4 && object.members()?[3].0.as_str() == "z");
        check(object.has("x")? && object.has("missing")? == false);
        check(object.erase("x")? == 2);
        check(object.erase("x")? == 0);
        check(object.length()? == 2);
        check(object.members()?[0].0.as_str() == "y" && object.members()?[1].0.as_str() == "z");
    } catch {
        JSONValueError(_) => fail("object lookup and mutation must preserve the member contract"),
    }
}

test "JSON values: wrong kinds absent keys and invalid indices are typed failures" {
    let scalar = JSONValue::null();
    var rejected = false;
    try {
        let _ = scalar.as_bool()?;
    } catch {
        JSONValueError(error) => { rejected = error == .WrongKind; },
    }
    check(rejected);
    let text = JSONValue::string("42");
    check(try {
        let _ = text.as_f64()?;
        false
    } catch {
        JSONValueError(error) => error == .WrongKind,
    });
    var array = JSONValue::array();
    rejected = false;
    try {
        let _ = array.at(0)?;
    } catch {
        JSONValueError(error) => { rejected = error == .IndexOutOfBounds; },
    }
    check(rejected);
    rejected = false;
    try {
        array.set_at(0, &&JSONValue::null())?;
    } catch {
        JSONValueError(error) => { rejected = error == .IndexOutOfBounds; },
    }
    check(rejected);
    let object = JSONValue::object();
    rejected = false;
    try {
        let _ = object.get("missing")?;
    } catch {
        JSONValueError(error) => { rejected = error == .MissingKey; },
    }
    check(rejected);
}

test "JSON values: string construction owns input and text reads borrow that owner" {
    try {
        var input: String = "你好😀";
        let value = JSONValue::string(input);
        input.clear();
        let text: str = value.as_str()?;
        check(text == "你好😀");
        var decoded = value.as_str()? as String;
        decoded.clear();
        check(value.as_str()? == "你好😀");
    } catch {
        JSONValueError(_) => fail("owned values must remain available after input mutation"),
    }
}

private fn borrow_text(value: JSONValue) -> str throw JSONValueError => value.as_str()?;

private fn borrow_number(value: JSONValue) -> str throw JSONValueError => value.number_text()?;

private fn borrow_key(value: JSONValue) -> str throw JSONValueError =>
    value.members()?[0].0.as_str();

test "JSON values: text queries retain caller storage through ordinary functions" {
    try {
        let text = JSONValue::string("borrowed");
        let number = JSONValue::integer(42);
        var object = JSONValue::object();
        object.set("key", &&JSONValue::null())?;
        let text_view: str = borrow_text(text)?;
        let number_view: str = borrow_number(number)?;
        let key_view: str = borrow_key(object)?;
        check(text_view == "borrowed");
        check(number_view == "42");
        check(key_view == "key");
    } catch {
        JSONValueError(_) => fail("text views must retain their caller's storage"),
    }
}

test "JSON values: explicit text copies survive replacing their source values" {
    try {
        var text = JSONValue::string("independent");
        var number = JSONValue::integer(42);
        var object = JSONValue::object();
        object.set("key", &&JSONValue::null())?;
        let text_copy = text.as_str()? as String;
        let number_copy = number.number_text()? as String;
        let key_copy = object.members()?[0].0.as_str() as String;
        text = JSONValue::null();
        number = JSONValue::null();
        object.erase("key")?;
        check(text_copy == "independent");
        check(number_copy == "42");
        check(key_copy == "key");
        let temporary_copy = JSONValue::string("temporary").as_str()? as String;
        check(temporary_copy == "temporary");
    } catch {
        JSONValueError(_) => fail("explicit copies must own their text"),
    }
}

test "JSON values: number spelling construction accepts exactly one number" {
    for input in ["", "null", "\"3\"", "1 ", "+1", "1,2"] {
        var rejected = false;
        try {
            let _ = JSONValue::number(input)?;
        } catch {
            JSONError(_) => { rejected = true; },
        }
        check(rejected, f"number input: {input}");
    }
}

test "JSON values: nested edits use an owned child and replace the selected member" {
    try {
        var array = JSONValue::array();
        array.push(&&JSONValue::integer(1))?;
        var parent = JSONValue::object();
        parent.set("items", &&array)?;
        parent.set("untouched", &&JSONValue::string("stay"))?;
        var child = parent.get("items")?;
        child.push(&&JSONValue::integer(2))?;
        check(parent.get("items")?.length()? == 1);
        parent.set("items", &&child)?;
        check(parent.get("items")?.length()? == 2);
        check(parent.get("items")?.at(1)?.as_i64()? == 2);
        check(parent.get("untouched")?.as_str()? == "stay");
    } catch {
        JSONValueError(_) => fail("nested owned edits must update only their selected member"),
    }
}
