import std::number.parse using { ParseError, parse };

test "Number parsing: complete representable decimal inputs produce scalars" {
    try {
        check(parse<i64>("-9223372036854775808")? == -9223372036854775807i64 - 1);
        check(parse<u64>("18446744073709551615")? == 18446744073709551615u64);
        check(parse<f64>("1.25e2")? == 125.0);
        check(parse<f64>("inf")?.is_finite() == false);
        check(parse<f64>("nan")?.is_finite() == false);
    } catch {
        ParseError(_) => fail("representable inputs must parse"),
    }
}

test "Number parsing: incomplete malformed and unrepresentable inputs fail" {
    for input in ["", " 1", "+1", "1x", "1.5", "9223372036854775808"] {
        var rejected = false;
        try {
            let _ = parse<i64>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["-0", "-1", "18446744073709551616"] {
        var rejected = false;
        try {
            let _ = parse<u64>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["", " 1", "+1", "1e", "1x", "1e400"] {
        var rejected = false;
        try {
            let _ = parse<f64>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
}

private fn parsed_number<T>(text: str) -> T throw ParseError => parse<T>(text)?;

test "Number parsing: target types establish integer and floating range checks" {
    try {
        check(parsed_number<i8>("-128")? == -128i8);
        check(parse<i8>("127")? == 127i8);
        check(parse<u8>("255")? == 255u8);
        check(parse<i16>("-32768")? == -32768i16);
        check(parse<i16>("32767")? == 32767i16);
        check(parse<u16>("65535")? == 65535u16);
        check(parse<i32>("-2147483648")? == -2147483647i32 - 1);
        check(parse<i32>("2147483647")? == 2147483647i32);
        check(parse<u32>("4294967295")? == 4294967295u32);
        check(parse<isize>("-123")? == -123isize);
        check(parsed_number<usize>("123")? == 123usize);
        check(parse<f32>("1.25e2")? == 125.0f32);
        check(parse<f32>("3.4028235e38")?.is_finite());
        check(parse<f32>("inf")?.is_finite() == false);
        check(parse<f32>("nan")?.is_finite() == false);
    } catch {
        ParseError(_) => fail("values within the requested type must parse"),
    }

    for input in ["-129", "128"] {
        var rejected = false;
        try {
            let _ = parse<i8>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["-0", "256", "1.0"] {
        var rejected = false;
        try {
            let _ = parse<u8>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["-1", "65536"] {
        var rejected = false;
        try {
            let _ = parse<u16>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["-1", "18446744073709551616"] {
        var rejected = false;
        try {
            let _ = parse<usize>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
    for input in ["3.5e38", "1e-50", "1e", "1x"] {
        var rejected = false;
        try {
            let _ = parse<f32>(input)?;
        } catch {
            ParseError(_) => { rejected = true; },
        }
        check(rejected);
    }
}
