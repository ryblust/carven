import std::time.duration using RangeError;
import std::time.clock using TimePoint;
import std::time.sleep using { sleep, sleep_until };

fn local_wait() -> AsyncOperation<void> throw RangeError {
    let point = TimePoint::after(-1ns)?;
    return point.wait();
}

fn temporary_wait() -> AsyncOperation<void> throw RangeError => TimePoint::after(-1ns)?.wait();

async fn main() throw RangeError {
    await sleep(0ns)?;
    await sleep(-1ns)?;
    await sleep(-9223372036854775808ns)?;

    let local_operation = local_wait()?;
    await local_operation;
    let temporary_operation = temporary_wait()?;
    await temporary_operation;

    var point = TimePoint::after(-1ns)?;
    let snapshot = point.wait();
    point = TimePoint::now();
    await snapshot;
    assert(point.has_passed());

    let past = TimePoint::after(-1ns)?;
    await sleep_until(past);
    assert(past.has_passed());

    let absolute = TimePoint::after(1ms)?;
    let absolute_operation = sleep_until(absolute);
    await absolute_operation;
    assert(absolute.has_passed());

    // Constructing a relative delay does not begin its clock.
    let deferred = sleep(2ms);
    await sleep(3ms)?;
    let started = TimePoint::now();
    let earliest_completion = started.shifted(2ms)?;
    await deferred?;
    assert(earliest_completion.has_passed());

    // A far-future timer cannot win and must be unregistered by explicit close.
    async let far = sleep(86400s);
    async let near = sleep(1ns);
    let (selected, selected_cancelled) = await wait_ready(far, near);
    assert(selected == 1 && !selected_cancelled);
    await near?;
    await close(far);

    // Cancellation reaches an already parked timer through the default entry pump.
    async let parked = sleep(86400s);
    await yield_once();
    cancel parked;
    let (parked_position, parked_cancelled) = await wait_ready(parked);
    assert(parked_position == 0 && parked_cancelled);
    await close(parked);

    // Nonpositive relative delays and past absolute deadlines still accept intent.
    async let nonpositive = sleep(-9223372036854775808ns);
    cancel nonpositive;
    let (_, nonpositive_cancelled) = await wait_ready(nonpositive);
    assert(nonpositive_cancelled);
    await close(nonpositive);

    async let already_due = sleep_until(past);
    cancel already_due;
    let (_, already_due_cancelled) = await wait_ready(already_due);
    assert(already_due_cancelled);
    await close(already_due);

    async let direct_due = past.wait();
    cancel direct_due;
    let (_, direct_due_cancelled) = await wait_ready(direct_due);
    assert(direct_due_cancelled);
    await close(direct_due);

    println(true);
}
