import std::time.duration using { Duration, RangeError };
import std::time.sleep using sleep;
import std::time.timeout using Timeout;

async fn delayed(value: i32, duration: Duration) -> i32 throw RangeError {
    await sleep(duration)?;
    return value;
}

async fn touch(&started: i32) -> i32 {
    ++started;
    return 42;
}

async fn cooperative(&started: i32, &closed: i32) -> i32 {
    ++started;
    while cancellation_requested() == false {
        await yield_once();
    }
    ++closed;
    return 17;
}

async fn protected(&started: i32, &closed: i32) -> i32 throw Timeout + RangeError {
    return await timeout(cooperative(&started, &closed), 1s)?;
}

async fn run_timeout() throw RangeError {
    var started = 0;
    let zero = try {
        let _ = await timeout(touch(&started), 0ns)?;
        false
    } catch {
        Timeout(_) => true,
        RangeError(_) => false,
    };
    let negative = try {
        let _ = await timeout(touch(&started), -9223372036854775808ns)?;
        false
    } catch {
        Timeout(_) => true,
        RangeError(_) => false,
    };
    let expired = try {
        let _ = await timeout(delayed(7, 100ms), 1ms)?;
        false
    } catch {
        Timeout(_) => true,
        RangeError(_) => false,
    };
    let completed = try {
        await timeout(touch(&started), 100ms)? == 42
    } catch {
        Timeout(_) => false,
        RangeError(_) => false,
    };
    assert(zero && negative && expired && completed && started == 1);
    var closed = 0;
    let drained = try {
        let _ = await timeout(cooperative(&started, &closed), 1ms)?;
        false
    } catch {
        Timeout(_) => true,
        RangeError(_) => false,
    };
    assert(drained && started == 2 && closed == 1);

    async let parent = protected(&started, &closed);
    while started != 3 {
        await yield_once();
    }
    cancel parent;
    let (_, cancelled) = await wait_ready(parent);
    await close(parent);
    assert(cancelled && closed == 2);
    println(true);
}
