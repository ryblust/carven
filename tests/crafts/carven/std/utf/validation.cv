import std::utf.codec using decode_utf8_prefix;
import std::utf.error using { UTF8Error, UTF8ErrorKind };
import std::utf.validation using { validate_utf8, UTF8Validator };

test "UTF8: chunk boundaries preserve state and errors identify the sequence" {
    let bytes: [u8; 5] = [0x61, 0xf0, 0x9f, 0x98, 0x80];
    let view = bytes.as_slice();
    for split in 0..=view.len() {
        var state = UTF8Validator::create();
        try {
            state.feed(view.slice(0, split))?;
            state.feed(view.slice(split, view.len()))?;
            state.check_complete()?;
            check(state.processed_bytes() == 5);
        } catch {
            UTF8Error(_) => check(false),
        }
    }
    var state = UTF8Validator::create();
    var rejected = false;
    try {
        state.push(0x61)?;
        state.push(0xe2)?;
        state.push(0x28)?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == UTF8ErrorKind::InvalidContinuation
                && error.offset == 2
                && error.sequence_start == 1;
        },
    }
    check(rejected);
    check(state.processed_bytes() == 2);
    rejected = false;
    try {
        state.check_complete()?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == UTF8ErrorKind::Truncated
                && error.offset == 2
                && error.sequence_start == 1;
        },
    }
    check(rejected);
}

private struct UTFCase {
    bytes: [u8; 5],
    length: usize,
    error: UTF8Error,
}

private const rejection_cases: [UTFCase] = [
    {
        bytes: [0x61, 0x80, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc0, 0x80, 0x00, 0x00],
        length: 3,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc1, 0xbf, 0x00, 0x00],
        length: 3,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf5, 0x80, 0x80, 0x80],
        length: 5,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xff, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x28, 0xa1, 0x00],
        length: 4,
        error: {
            kind:.InvalidContinuation,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x21, 0x00],
        length: 4,
        error: {
            kind:.InvalidContinuation,
            offset: 3,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x21],
        length: 5,
        error: {
            kind:.InvalidContinuation,
            offset: 4,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe0, 0x9f, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x8f, 0x80, 0x80],
        length: 5,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xed, 0xa0, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Surrogate,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xed, 0xbf, 0xbf, 0x00],
        length: 4,
        error: {
            kind:.Surrogate,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf4, 0x90, 0x80, 0x80],
        length: 5,
        error: {
            kind:.TooLarge,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc2, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.Truncated,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.Truncated,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x82, 0x00, 0x00],
        length: 3,
        error: {
            kind:.Truncated,
            offset: 3,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.Truncated,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x00, 0x00],
        length: 3,
        error: {
            kind:.Truncated,
            offset: 3,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x00],
        length: 4,
        error: {
            kind:.Truncated,
            offset: 4,
            sequence_start: 1
        }
    },
];

test "UTF8: chunk partitions preserve error positions and accepted progress" {
    for item in rejection_cases {
        let bytes = item.bytes.as_slice().slice(0, item.length);
        var rejected = false;
        for first in 0..=bytes.len() {
            for second in first..=bytes.len() {
                var state = UTF8Validator::create();
                rejected = false;
                try {
                    state.feed(bytes.slice(0, first))?;
                    state.feed(bytes.slice(first, second))?;
                    state.feed(bytes.slice(second, bytes.len()))?;
                    state.check_complete()?;
                } catch {
                    UTF8Error(error) => {
                        rejected = error.kind
                            == item.error.kind
                            && error.offset == item.error.offset
                            && error.sequence_start == item.error.sequence_start;
                    },
                }
                check(rejected);
                check(state.processed_bytes() == item.error.offset);
            }
        }
        if item.error.offset < bytes.len() {
            var state = UTF8Validator::create();
            try {
                state.feed(bytes.slice(0, item.error.offset))?;
            } catch {
                UTF8Error(_) => check(false),
            }
            let before = state;
            rejected = false;
            try {
                state.push(bytes[item.error.offset])?;
            } catch {
                UTF8Error(error) => {
                    rejected = error.kind
                        == item.error.kind
                        && error.offset == item.error.offset
                        && error.sequence_start == item.error.sequence_start;
                },
            }
            check(rejected);
            check(state.processed_bytes() == before.processed_bytes());
            check(state.is_complete() == before.is_complete());
        }
    }
}

const test "UTF8: whole-buffer validation accepts valid text and reports exact errors" {
    try {
        let empty: [u8; 0] = [];
        validate_utf8(empty)?;
        validate_utf8("a\u{0}é你😀\u{ffff}\u{10ffff}".bytes)?;
    } catch {
        UTF8Error(_) => fail("valid constant bytes were rejected"),
    }
    for item in rejection_cases {
        var rejected = false;
        try {
            validate_utf8(item.bytes.as_slice().slice(0, item.length))?;
        } catch {
            UTF8Error(error) => {
                rejected = error.kind
                    == item.error.kind
                    && error.offset == item.error.offset
                    && error.sequence_start == item.error.sequence_start;
            },
        }
        check(rejected);
    }
}

const test "UTF8: prefix decoding reports errors relative to its input" {
    for item in rejection_cases {
        // Each fixture has one ASCII byte before the invalid sequence.
        let bytes = item.bytes.as_slice().slice(1, item.length);
        var rejected = false;
        try {
            let _ = decode_utf8_prefix(bytes)?;
        } catch {
            UTF8Error(error) => {
                rejected = error.kind
                    == item.error.kind
                    && error.offset == item.error.offset - 1
                    && error.sequence_start == 0;
            },
        }
        check(rejected);
    }
}

test "UTF8: copied validators and rejected operations preserve pending constraints" {
    var state = UTF8Validator::create();
    try {
        state.push(0xe0)?;
        var copy = state;
        var rejected = false;
        try {
            state.push(0x9f)?;
        } catch {
            UTF8Error(error) => { rejected = error.kind == .Overlong; },
        }
        require(rejected);
        rejected = false;
        try {
            state.check_complete()?;
        } catch {
            UTF8Error(error) => { rejected = error.kind == .Truncated; },
        }
        require(rejected);
        state.feed([0xa0, 0x80])?;
        state.check_complete()?;
        state.check_complete()?;
        check(state.processed_bytes() == 3);
        check(state.is_complete());
        check(copy.processed_bytes() == 1);
        check(!copy.is_complete());
        copy.feed([0xbf, 0xbf])?;
        copy.check_complete()?;
        check(copy.processed_bytes() == 3);
    } catch {
        UTF8Error(_) => fail("a failed operation must preserve the pending sequence"),
    }
}

private const fn verify_simd_rejections(prefixes: [usize]) -> bool {
    for prefix in prefixes {
        for item in rejection_cases {
            var data: [u8; 72] = {};
            for index in 0..prefix {
                data[index] = 0x61;
            }
            for index in 0..item.length {
                data[prefix + index] = item.bytes[index];
            }
            var rejected = false;
            try {
                validate_utf8(data.as_slice().slice(0, prefix + item.length))?;
            } catch {
                UTF8Error(error) => {
                    rejected = error.kind
                        == item.error.kind
                        && error.offset == prefix + item.error.offset
                        && error.sequence_start == prefix + item.error.sequence_start;
                },
            }
            assert(rejected);
        }
    }
    return true;
}

const test "UTF8: constant errors preserve offsets before the narrow block boundary" {
    check(verify_simd_rejections([0, 15]));
}

const test "UTF8: constant errors preserve offsets across the narrow block boundary" {
    check(verify_simd_rejections([16, 17]));
}

const test "UTF8: constant errors preserve offsets across the wide block boundary" {
    check(verify_simd_rejections([31, 32]));
}

const test "UTF8: constant errors preserve offsets after the wide block boundary" {
    check(verify_simd_rejections([33]));
}

const test "UTF8: wide block validation accepts valid constant text" {
    try {
        validate_utf8("0123456789abcdef0123456789abcdef你好😀\u{0}abcdefghijklmnop".bytes)?;
    } catch {
        UTF8Error(_) => fail("valid SIMD constant input rejected"),
    }
}

test "UTF8: SIMD and byte pushes agree across block boundaries and recovery" {
    check(verify_simd_rejections([0, 15, 16, 17, 31, 32, 33, 63, 64, 65]));
    for prefix in 0usize..=33 {
        for item in rejection_cases {
            var data: [u8; 40] = {};
            for index in 0..prefix {
                data[index] = 0x61;
            }
            for index in 0..item.length {
                data[prefix + index] = item.bytes[index];
            }
            let bytes = data.as_slice().slice(0, prefix + item.length);
            for split in 0..=bytes.len() {
                var vector = UTF8Validator::create();
                var scalar = UTF8Validator::create();
                var vector_rejected = false;
                var scalar_rejected = false;
                var vector_error = item.error;
                var scalar_error = item.error;
                try {
                    vector.feed(bytes.slice(0, split))?;
                    vector.feed(bytes.slice(split, bytes.len()))?;
                    vector.check_complete()?;
                } catch {
                    UTF8Error(error) => {
                        vector_rejected = true;
                        vector_error = error;
                    },
                }
                try {
                    for byte in bytes {
                        scalar.push(byte)?;
                    }
                    scalar.check_complete()?;
                } catch {
                    UTF8Error(error) => {
                        scalar_rejected = true;
                        scalar_error = error;
                    },
                }
                check(vector_rejected && scalar_rejected);
                check(vector_error.kind == scalar_error.kind);
                check(vector_error.offset == scalar_error.offset);
                check(vector_error.sequence_start == scalar_error.sequence_start);
                check(vector.processed_bytes() == scalar.processed_bytes());
                check(vector.is_complete() == scalar.is_complete());
                // Resume both states with identical bytes, including failures.
                for byte in [0xa0u8, 0x80, 0x80, 0x61] {
                    var vector_failed = false;
                    var scalar_failed = false;
                    try {
                        vector.push(byte)?;
                    } catch {
                        UTF8Error(_) => { vector_failed = true; },
                    }
                    try {
                        scalar.push(byte)?;
                    } catch {
                        UTF8Error(_) => { scalar_failed = true; },
                    }
                    check(vector_failed == scalar_failed);
                    check(vector.processed_bytes() == scalar.processed_bytes());
                    check(vector.is_complete() == scalar.is_complete());
                }
            }
        }
    }
    let valid = "0123456789abcde😀0123456789abcdef你abcdefghijklmnop\u{0}abcdefghijklmnop".bytes;
    for split in 0..=valid.len() {
        var validator = UTF8Validator::create();
        try {
            validator.feed(valid.slice(0, split))?;
            validator.feed(valid.slice(split, valid.len()))?;
            validator.check_complete()?;
            check(validator.processed_bytes() == valid.len());
        } catch {
            UTF8Error(_) => fail("valid split stream rejected"),
        }
    }
}
