import std::utf.error using { UTF8Error, UTF8ErrorKind };
import std::utf.validation using { validate_utf8, UTF8Validator };

private const fn incremental_static_state() -> bool {
    var state = UTF8Validator::new();
    if state.is_complete() == false || state.processed_bytes() != 0 { return false; }
    try {
        state.push(0xe2)?;
        state.feed([0x82])?;
    } catch {
        UTF8Error(_) => return false,
    }
    var copy = state;
    var truncated = false;
    try {
        state.check_complete()?;
    } catch {
        UTF8Error(error) => {
            truncated = error.kind == .Truncated && error.offset == 2 && error.sequence_start == 0;
        },
    }
    if truncated == false || state.is_complete() || state.processed_bytes() != 2 { return false; }
    try {
        state.push(0xac)?;
        state.check_complete()?;
    } catch {
        UTF8Error(_) => return false,
    }
    if state.is_complete() == false || state.processed_bytes() != 3 { return false; }
    if copy.is_complete() || copy.processed_bytes() != 2 { return false; }
    try {
        copy.feed([0xad])?;
        copy.check_complete()?;
    } catch {
        UTF8Error(_) => return false,
    }
    return copy.is_complete() && copy.processed_bytes() == 3;
}

const test "UTF8: incremental class state executes statically with independent copies" {
    check(incremental_static_state());
}

test "UTF8: chunk boundaries preserve state and errors identify the sequence" {
    let bytes: [u8; 5] = [0x61, 0xf0, 0x9f, 0x98, 0x80];
    let view = bytes.as_slice();
    for split in 0..=view.length() {
        var state = UTF8Validator::new();
        try {
            state.feed(view.slice(0, split))?;
            state.feed(view.slice(split, view.length()))?;
            state.check_complete()?;
            check(state.processed_bytes() == 5);
        } catch {
            UTF8Error(_) => check(false),
        }
    }
    var state = UTF8Validator::new();
    var rejected = false;
    try {
        state.push(0x61)?;
        state.push(0xe2)?;
        state.push(0x28)?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == UTF8ErrorKind::InvalidContinuation
                && error.offset == 2
                && error.sequence_start == 1;
        },
    }
    check(rejected);
    check(state.processed_bytes() == 2);
    rejected = false;
    try {
        state.check_complete()?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == UTF8ErrorKind::Truncated
                && error.offset == 2
                && error.sequence_start == 1;
        },
    }
    check(rejected);
}

private struct UTFCase {
    bytes: [u8; 5],
    length: usize,
    error: UTF8Error,
}

private const rejection_cases: [UTFCase] = [
    {
        bytes: [0x61, 0x80, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc0, 0x80, 0x00, 0x00],
        length: 3,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf5, 0x80, 0x80, 0x80],
        length: 5,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x28, 0xa1, 0x00],
        length: 4,
        error: {
            kind:.InvalidContinuation,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x21],
        length: 5,
        error: {
            kind:.InvalidContinuation,
            offset: 4,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe0, 0x9f, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x8f, 0x80, 0x80],
        length: 5,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xed, 0xa0, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Surrogate,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf4, 0x90, 0x80, 0x80],
        length: 5,
        error: {
            kind:.TooLarge,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc2, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.Truncated,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x82, 0x00, 0x00],
        length: 3,
        error: {
            kind:.Truncated,
            offset: 3,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x00],
        length: 4,
        error: {
            kind:.Truncated,
            offset: 4,
            sequence_start: 1
        }
    },
];

test "UTF8: chunk boundaries preserve error positions and accepted progress" {
    for item in rejection_cases {
        let bytes = item.bytes.as_slice().slice(0, item.length);
        for split in 0..=bytes.length() {
            var state = UTF8Validator::new();
            var rejected = false;
            try {
                state.feed(bytes.slice(0, split))?;
                state.feed(bytes.slice(split, bytes.length()))?;
                state.check_complete()?;
            } catch {
                UTF8Error(error) => {
                    rejected = error.kind
                        == item.error.kind
                        && error.offset == item.error.offset
                        && error.sequence_start == item.error.sequence_start;
                },
            }
            check(rejected);
            check(state.processed_bytes() == item.error.offset);
        }
    }
}

test "UTF8: whole-buffer validation accepts valid text and reports exact errors" {
    try {
        let empty: [u8; 0] = [];
        validate_utf8(empty)?;
        validate_utf8("a\u{0}é你😀\u{ffff}\u{10ffff}".bytes)?;
    } catch {
        UTF8Error(_) => fail("valid bytes were rejected"),
    }
    for item in rejection_cases {
        var rejected = false;
        try {
            validate_utf8(item.bytes.as_slice().slice(0, item.length))?;
        } catch {
            UTF8Error(error) => {
                rejected = error.kind
                    == item.error.kind
                    && error.offset == item.error.offset
                    && error.sequence_start == item.error.sequence_start;
            },
        }
        check(rejected);
    }
}

test "UTF8: copied validators and rejected operations preserve pending constraints" {
    var state = UTF8Validator::new();
    try {
        state.push(0xe0)?;
        var copy = state;
        var rejected = false;
        try {
            state.push(0x9f)?;
        } catch {
            UTF8Error(error) => { rejected = error.kind == .Overlong; },
        }
        require(rejected);
        rejected = false;
        try {
            state.check_complete()?;
        } catch {
            UTF8Error(error) => { rejected = error.kind == .Truncated; },
        }
        require(rejected);
        state.feed([0xa0, 0x80])?;
        state.check_complete()?;
        check(state.processed_bytes() == 3);
        check(state.is_complete());
        check(copy.processed_bytes() == 1);
        check(!copy.is_complete());
        copy.feed([0xbf, 0xbf])?;
        copy.check_complete()?;
        check(copy.processed_bytes() == 3);
    } catch {
        UTF8Error(_) => fail("a failed operation must preserve the pending sequence"),
    }
}

private fn verify_simd_rejections(prefixes: [usize]) -> bool {
    for prefix in prefixes {
        for item in rejection_cases {
            var data: [u8; 72] = {};
            for index in 0..prefix {
                data[index] = 0x61;
            }
            for index in 0..item.length {
                data[prefix + index] = item.bytes[index];
            }
            var rejected = false;
            try {
                validate_utf8(data.as_slice().slice(0, prefix + item.length))?;
            } catch {
                UTF8Error(error) => {
                    rejected = error.kind
                        == item.error.kind
                        && error.offset == prefix + item.error.offset
                        && error.sequence_start == prefix + item.error.sequence_start;
                },
            }
            assert(rejected);
        }
    }
    return true;
}

const test "UTF8: wide block validation accepts valid constant text" {
    try {
        validate_utf8("0123456789abcdef0123456789abcdef你好😀\u{0}abcdefghijklmnop".bytes)?;
    } catch {
        UTF8Error(_) => fail("valid SIMD constant input rejected"),
    }
}

test "UTF8: block boundaries preserve validation errors and partial sequences" {
    check(verify_simd_rejections([15, 16, 31, 32, 63, 64]));
    let valid = "0123456789abcde😀0123456789abcdef你abcdefghijklmnop\u{0}abcdefghijklmnop".bytes;
    for split in [0usize, 15, 16, 17, 31, 32, valid.length()] {
        var validator = UTF8Validator::new();
        try {
            validator.feed(valid.slice(0, split))?;
            validator.feed(valid.slice(split, valid.length()))?;
            validator.check_complete()?;
            check(validator.processed_bytes() == valid.length());
        } catch {
            UTF8Error(_) => fail("valid split stream rejected"),
        }
    }
}
