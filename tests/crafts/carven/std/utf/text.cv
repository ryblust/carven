import std::utf using {
    UTF8Error,
    to_string,
    substring,
    split_once,
    split,
    lines,
    starts_with,
    SplitCursor,
    SplitField,
    TextError,
};

private const fn copied_text() -> String throw UTF8Error {
    let bytes = [0xffu8, 0x61, 0, 0xc3, 0xa9, 0xe4, 0xbd, 0xa0, 0xff];
    let selected = bytes.slice(1, 8);
    let view = str::from_utf8(selected)?;
    assert(view.bytes.length() == selected.length());
    assert(view.bytes[0] == 0x61);
    assert(view.bytes[1] == 0);
    assert(str::from_utf8(selected.slice(2, 2))?.is_empty());
    return view as String;
}

private const fn independent_text() -> String throw UTF8Error {
    var bytes = [0x61u8];
    let result = to_string(bytes)?;
    bytes[0] = 0x62;
    return &&result;
}

private const fn changed_backing() -> String {
    var bytes = [97u8, 98];
    let slot = addressof(&bytes[0]);
    let view = str::from_utf8_unchecked(bytes);
    let selected = view.bytes;
    if slot != nullptr { *slot = 99; }
    assert(view == "cb");
    assert(selected[0] == 99);
    return view as String;
}

private const fn fields(text: str, separator: str) -> Vector<String> throw TextError {
    var cursor = SplitCursor::new();
    var result: Vector<String> = [];
    while {
        let field: SplitField = cursor.next(text, separator)?;
        match field {
            .End => break,
            .Value(value) => result.push(value as String),
        }
    }
    return &&result;
}

private const fn same(left: [String], right: [String]) -> bool {
    if left.length() != right.length() { return false; }
    for index in 0..left.length() {
        if left[index] != right[index] { return false; }
    }
    return true;
}

private const copied = copied_text()?;
private const owned = to_string([0xf0u8, 0x9f, 0x98, 0x80])?;
private const independent = independent_text()?;
private const changed = changed_backing();

const test "UTF8: checked byte views and owned results execute at compilation" {
    check(copied == "a\u{0}é你");
    check(owned == "😀");
    check(independent == "a");
    check(changed == "cb");
    var rejected = false;
    let invalid = [0xe2u8, 0x28];
    try {
        let _ = str::from_utf8(invalid)?;
    } catch {
        UTF8Error(error) => { rejected = error.kind == .InvalidContinuation && error.offset == 1; },
    }
    check(rejected);
}

test "UTF8: byte slices construct borrowed and owning text" {
    check(changed_backing() == "cb");
    let bytes: [u8; 7] = [0x61, 0, 0xc3, 0xa9, 0xe4, 0xbd, 0xa0];
    try {
        let text = str::from_utf8(bytes)?;
        check(text == "a\u{0}é你");
        check(text.bytes[1] == 0);
        let copy = to_string(text.bytes)?;
        check(copy.as_str() == text);
        var count = 0;
        for _ in text.chars {
            count += 1;
        }
        check(count == 4);
    } catch {
        UTF8Error(_) => fail("valid bytes must construct text"),
    }

    var original: [u8; 1] = [0x61];
    try {
        let copy = to_string(original)?;
        original[0] = 0x62;
        check(copy == "a");
    } catch {
        UTF8Error(_) => fail("valid bytes must construct an independent copy"),
    }
}

test "UTF8: borrowed and owning text construction report invalid bytes" {
    let input: [u8; 2] = [0xe2, 0x28];
    let bytes = input.slice();
    let expected = UTF8Error {
        kind:.InvalidContinuation,
        offset: 1,
        sequence_start: 0
    };
    var rejected = false;
    try {
        let _ = str::from_utf8(bytes)?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == expected.kind
                && error.offset == expected.offset
                && error.sequence_start == expected.sequence_start;
        },
    }
    check(rejected);
    rejected = false;
    try {
        let _ = to_string(bytes)?;
    } catch {
        UTF8Error(error) => {
            rejected = error.kind
                == expected.kind
                && error.offset == expected.offset
                && error.sequence_start == expected.sequence_start;
        },
    }
    check(rejected);
}

private const fn processed_text() -> bool throw TextError {
    let text = "aé世界😀z";
    if substring(text, 1, 9)? != "é世界" { return false; }
    if substring(text, 9, 13)? != "😀" { return false; }
    if !substring(text, 3, 3)?.is_empty() { return false; }
    if !starts_with(text, "aé") || starts_with(text, "é") { return false; }
    let pair = split_once("key=世界=value", "=")?;
    if !pair.found || pair.before != "key" || pair.after != "世界=value" { return false; }
    let absent = split_once(text, "missing")?;
    if absent.found || absent.before != text || !absent.after.is_empty() { return false; }
    let fields = split("世界::a::::", "::")?;
    if fields.length()
        != 4
        || fields[0] != "世界"
        || fields[1] != "a"
        || !fields[2].is_empty()
        || !fields[3].is_empty() {
        return false;
    }
    let empty = split("", ",")?;
    if empty.length() != 1 || !empty[0].is_empty() { return false; }
    let separated = split("a世b世界c", "世界")?;
    if separated.length() != 2 || separated[0] != "a世b" || separated[1] != "c" { return false; }
    let records = lines("a\r\n\n世界\nlast\r");
    return records.length()
        == 4
        && records[0] == "a"
        && records[1].is_empty()
        && records[2] == "世界"
        && records[3] == "last\r"
        && lines("").is_empty()
        && lines("\n").length() == 1
        && lines("a\n").length() == 1;
}

const test "Text: byte boundaries and exact splitting execute at compilation" {
    check(
        try {
            processed_text()?
        } catch {
            TextError(_) => false
        }
    );
}

test "Text: processing preserves UTF8 boundaries and empty fields" {
    check(
        try {
            processed_text()?
        } catch {
            TextError(_) => false
        }
    );
    let rejected = try {
        let _ = substring("é", 1, 2)?;
        false
    } catch {
        TextError(error) => error == .NotCharBoundary,
    };
    check(rejected);
    check(
        try {
            let _ = substring("é", 3, 3)?;
            false
        } catch {
            TextError(error) => error == .OutOfBounds
        }
    );
    check(
        try {
            let _ = substring("é", 2, 0)?;
            false
        } catch {
            TextError(error) => error == .OutOfBounds
        }
    );
    check(
        try {
            let _ = split("abc", "")?;
            false
        } catch {
            TextError(error) => error == .EmptySeparator
        }
    );

    var source: String = "first=世界";
    let owned = try {
        split(source, "=")?
    } catch {
        TextError(_) => {
            fail("valid separator");
            []
        }
    };
    source.clear();
    check(owned.length() == 2 && owned[0] == "first" && owned[1] == "世界");
}

const test "Split cursor: empty fields and multibyte separator" {
    try {
        check(same(fields("世界a世界世界", "世界")?, ["", "a", "", ""]));
    } catch {
        _ => fail("unexpected library failure"),
    }
}

test "Split cursor: borrowed traversal preserves exact owning split behavior" {
    try {
        for text in ["", " ", "  token=abc  ", "a b", "世界 a", "a世界b世界"] {
            check(same(fields(text, " ")?, split(text, " ")?));
        }
        check(
            try {
                let _ = fields("", "")?;
                false
            } catch {
                TextError(error) => error == .EmptySeparator
            }
        );
    } catch {
        _ => fail("unexpected library failure"),
    }
}
