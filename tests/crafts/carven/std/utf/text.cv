import std::utf.text using {from_utf8, to_string};
import std::utf.codec using decode_utf8;
import std::utf.validation using {UTF8Error, validate_utf8};

test "UTF8: byte slices construct borrowed and owning text" {
    let bytes: [u8; 7] = [0x61, 0, 0xc3, 0xa9, 0xe4, 0xbd, 0xa0];
    var accepted = false;
    try {
        validate_utf8(bytes.as_slice())?;
        let text = from_utf8(bytes.as_slice())?;
        check(text == "a\u{0}é你");
        check(text.bytes[1] == 0);
        let copy = to_string(text.bytes)?;
        check(copy.as_str() == text);
        var count = 0;
        for _ in text.chars { count += 1; }
        check(count == 4);
        accepted = true;
    } catch { UTF8Error(_) => {}, }
    check(accepted);

    var original: [u8; 1] = [0x61];
    try {
        let copy = to_string(original.as_slice())?;
        original[0] = 0x62;
        check(copy.as_str() == "a");
    } catch { UTF8Error(_) => { check(false); }, }
}

test "UTF8: text construction and prefix decoding reject invalid bytes" {
    let input: [u8; 2] = [0xe2, 0x28];
    let bytes = input.as_slice();
    let expected = UTF8Error { kind: .InvalidContinuation, offset: 1, sequence_start: 0 };
    var rejected = false;
    try { let _ = from_utf8(bytes)?; }
    catch { UTF8Error(error) => { rejected = error == expected; }, }
    check(rejected);
    rejected = false;
    try { let _ = to_string(bytes)?; }
    catch { UTF8Error(error) => { rejected = error == expected; }, }
    check(rejected);
    rejected = false;
    try { let _ = decode_utf8(bytes)?; }
    catch { UTF8Error(error) => { rejected = error == expected; }, }
    check(rejected);
}
