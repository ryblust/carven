import std::utf.error using UTF8Error;

export struct UTF8Rejection {
    bytes: [u8; 5],
    length: usize,
    error: UTF8Error,
}

export const rejection_cases: [UTF8Rejection] = [
    {
        bytes: [0x61, 0x80, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc0, 0x80, 0x00, 0x00],
        length: 3,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf5, 0x80, 0x80, 0x80],
        length: 5,
        error: {
            kind:.InvalidLead,
            offset: 1,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x28, 0xa1, 0x00],
        length: 4,
        error: {
            kind:.InvalidContinuation,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x21],
        length: 5,
        error: {
            kind:.InvalidContinuation,
            offset: 4,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe0, 0x9f, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x8f, 0x80, 0x80],
        length: 5,
        error: {
            kind:.Overlong,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xed, 0xa0, 0x80, 0x00],
        length: 4,
        error: {
            kind:.Surrogate,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf4, 0x90, 0x80, 0x80],
        length: 5,
        error: {
            kind:.TooLarge,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xc2, 0x00, 0x00, 0x00],
        length: 2,
        error: {
            kind:.Truncated,
            offset: 2,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xe2, 0x82, 0x00, 0x00],
        length: 3,
        error: {
            kind:.Truncated,
            offset: 3,
            sequence_start: 1
        }
    },
    {
        bytes: [0x61, 0xf0, 0x9f, 0x98, 0x00],
        length: 4,
        error: {
            kind:.Truncated,
            offset: 4,
            sequence_start: 1
        }
    },
];
