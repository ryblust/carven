import std::utf.scalar using { UnicodeScalarError, char_from_u32 };
import std::utf.codec using { decode_utf8_prefix, encode_utf8, encoded_bytes };
import std::utf.error using UTF8Error;
import std::utf.validation using validate_utf8;

const test "UTF8: prefix decoding stops before later bytes" {
    try {
        let empty: [u8; 0] = [];
        match decode_utf8_prefix(empty)? {
            .End => {},
            .Scalar(_, _) => fail("empty input must have no scalar"),
        }
        let prefix: [u8; 2] = [0x61, 0xff];
        match decode_utf8_prefix(prefix)? {
            .End => fail("nonempty input must have a scalar"),
            .Scalar(value, width) => {
                check(value == 'a');
                check(width == 1);
            },
        }
    } catch {
        UTF8Error(_) => fail("valid encoding must be accepted"),
    }
}

private struct ScalarCase {
    scalar: u32,
    width: usize,
    bytes: [u8; 4],
}

const test "UTF8: scalar boundaries have the specified encoding and decoding" {
    let cases = [
        ScalarCase {
            scalar: 0,
            width: 1,
            bytes: [0, 0, 0, 0]
        },
        {
            scalar: 0x7f,
            width: 1,
            bytes: [0x7f, 0, 0, 0]
        },
        {
            scalar: 0x80,
            width: 2,
            bytes: [0xc2, 0x80, 0, 0]
        },
        {
            scalar: 0x7ff,
            width: 2,
            bytes: [0xdf, 0xbf, 0, 0]
        },
        {
            scalar: 0x800,
            width: 3,
            bytes: [0xe0, 0xa0, 0x80, 0]
        },
        {
            scalar: 0xd7ff,
            width: 3,
            bytes: [0xed, 0x9f, 0xbf, 0]
        },
        {
            scalar: 0xe000,
            width: 3,
            bytes: [0xee, 0x80, 0x80, 0]
        },
        {
            scalar: 0xffff,
            width: 3,
            bytes: [0xef, 0xbf, 0xbf, 0]
        },
        {
            scalar: 0x10000,
            width: 4,
            bytes: [0xf0, 0x90, 0x80, 0x80]
        },
        {
            scalar: 0x1f600,
            width: 4,
            bytes: [0xf0, 0x9f, 0x98, 0x80]
        },
        {
            scalar: 0x10ffff,
            width: 4,
            bytes: [0xf4, 0x8f, 0xbf, 0xbf]
        },
    ];
    for item in cases {
        try {
            let character = char_from_u32(item.scalar)?;
            check((character as u32) == item.scalar);
            let encoded = encode_utf8(character);
            check(encoded.width == item.width);
            check(encoded.bytes == item.bytes);
            let bytes = encoded_bytes(encoded);
            validate_utf8(bytes)?;
            match decode_utf8_prefix(bytes)? {
                .End => fail("nonempty input must have a scalar"),
                .Scalar(value, width) => {
                    check((value as u32) == item.scalar);
                    check(width == item.width);
                },
            }
        } catch {
            UTF8Error(_) => fail("valid encoding must be accepted"),
            UnicodeScalarError(_) => fail("valid scalar must be accepted"),
        }
    }
}

const test "UTF8: surrogate and out-of-range values are rejected" {
    let invalid: [u32; 4] = [0xd800, 0xdfff, 0x110000, 0xffffffff];
    for value in invalid {
        var rejected = false;
        try {
            let _ = char_from_u32(value)?;
        } catch {
            UnicodeScalarError(error) => { rejected = error.value == value; },
        }
        check(rejected);
    }
}

const test "UTF8: encoded arrays freeze as constant slices" {
    const encoded = encode_utf8('😀');
    check(encoded.width == 4);
    check(encoded.bytes == [0xf0, 0x9f, 0x98, 0x80]);
    const padded: [u8] = encode_utf8('é').bytes;
    check(padded.len() == 4);
    check(padded[0] == 0xc3);
    check(padded[1] == 0xa9);
    check(padded[2] == 0);
    check(padded[3] == 0);
    const bytes = encoded_bytes(encoded);
    check(bytes.len() == 4);
    check(bytes[0] == 0xf0 && bytes[1] == 0x9f && bytes[2] == 0x98 && bytes[3] == 0x80);
}

test "UTF8: every Unicode scalar round trips through encoding and prefix decoding" {
    // Keep the scalar domain exhaustive. Block placement and byte-class
    // combinations are covered by the native and portable block tests.
    for value in 0u32..=0x10ffffu32 {
        if value >= 0xd800 && value <= 0xdfff { continue; }
        try {
            let character = char_from_u32(value)?;
            let encoded = encode_utf8(character);
            let bytes = encoded_bytes(encoded);
            validate_utf8(bytes)?;
            match decode_utf8_prefix(bytes)? {
                .End => fail("a scalar encoding cannot be empty"),
                .Scalar(decoded, width) => {
                    require((decoded as u32) == value);
                    require(width == encoded.width);
                },
            }
        } catch {
            UTF8Error(_) => fail("valid scalar encoding was rejected"),
            UnicodeScalarError(_) => fail("valid Unicode scalar was rejected"),
        }
    }
}

const test "UTF8: scalar and decoded results freeze as public constants" {
    const character = char_from_u32(0x1f600)?;
    check(character == '😀');
    const decoded = decode_utf8_prefix([0xf0, 0x9f, 0x98, 0x80, 0xff])?;
    match decoded {
        .Scalar(value, width) => {
            check(value == character);
            check(width == 4);
        },
        .End => fail("nonempty prefix must produce a scalar"),
    }
}

test "UTF8: encoded views contain exactly the scalar encoding" {
    let characters = ['\u{0}', 'a', 'é', '你', '😀'];
    let widths: [usize; 5] = [1, 1, 2, 3, 4];
    var index: usize = 0;
    for character in characters {
        let encoded = encode_utf8(character);
        let bytes = encoded_bytes(encoded);
        check(bytes.len() == widths[index]);
        index += 1;
    }
}
