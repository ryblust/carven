import std::async using { yield_once, close }

import std::process using {
    Process,
    ProcessGroup,
    ProcessError,
    OperatingSystem,
    arguments as host_arguments,
    executable,
    find_executable,
    operating_system,
    environment,
    run,
}

fn host_platform() -> OperatingSystem => operating_system();

private async fn read_payload(child: Process) -> Vector<u8> throw ProcessError {
    var bytes: Vector<u8> = [];
    while bytes.length() < 262144 {
        match await child.read(65536)? {
            .End => assert(false),
            .Data(chunk) => { bytes.append(chunk); },
        }
    }
    assert(bytes.length() == 262144 && bytes[0] == 0 && bytes[262143] == 255);
    return bytes;
}

private async fn check_transport(&&program: String) throw ProcessError {
    let quoted = Process::spawn_in(
        program,
        [
            "-c",
            r#"import os,sys; assert os.path.isfile('bridge.cv'); assert sys.argv[1:] == ['', 'a b', 'a\"b', 'tail\\', '我😀']; sys.stdout.buffer.write(b'K')"#,
            "",
            "a b",
            "a\"b",
            "tail\\",
            "我😀"
        ],
        "tests/crafts/process"
    )?;
    match await quoted.read(1)? {
        .Data(bytes) => assert(bytes.length() == 1 && bytes[0] == 75),
        .End => assert(false),
    }
    assert(await quoted.wait()? == 0);
    quoted.close_input()?;

    // Transfer more than a pipe buffer in both directions. The child checks all
    // bytes, including NUL, CR/LF, and values that are not UTF-8.
    let echo = Process::spawn(
        program,
        [
            "-c",
            "import sys; data=bytes(range(256))*1024; sys.stdout.buffer.write(data); sys.stdout.buffer.flush(); assert sys.stdin.buffer.read() == data"
        ]
    )?;
    let payload = await read_payload(echo)?;
    await echo.write_all(&&payload)?;
    echo.close_input()?;
    assert(await echo.wait()? == 0);

    // A blocked write must leave the driver free to cancel it. Cancelling a wait
    // leaves the child alive; terminating it still yields a reusable exit status.
    let stalled = Process::spawn(
        program,
        [
            "-c",
            "import sys,time; sys.stdout.buffer.write(bytes(range(256))*1024); sys.stdout.buffer.flush(); time.sleep(30)"
        ]
    )?;
    let blocked_bytes = await read_payload(stalled)?;
    async let writing = stalled.write_all(&&blocked_bytes);
    async let waiting = stalled.wait();
    await yield_once();
    await close(writing);
    await close(waiting);
    stalled.close_input()?;
    stalled.terminate()?;
    let status = await stalled.wait()?;
    assert(status != 0);
    assert(await stalled.wait()? == status);
    stalled.terminate()?;
}

async fn probe(&&program: String) -> i32 {
    return try {
        let arguments = host_arguments()?;
        assert(arguments.length() == 3);
        assert(arguments[0] == program && arguments[1].is_empty() && arguments[2] == "我😀");
        let current = executable()?;
        assert(
            !current.is_empty() && find_executable(current)? == current,
            "executable must round trip through find_executable"
        );
        let path = environment("PATH")?;
        assert(run(
            program,
            [
                "-c",
                "import os,sys; assert os.environ.get('PATH','') == sys.argv[1]; sys.exit(9)",
                path
            ]
        )? == 9);
        let missing = try {
            run("carven-test-missing-program", [])?;
            false
        } catch {
            ProcessError(error) => match error {
                .System(code) => code != 0
            }
        };
        assert(missing);
        let group = ProcessGroup::new();
        var statuses: Vector<i32> = [3, 7];
        for status in statuses {
            group.spawn_inherited(program, ["-c", f"import sys; sys.exit({status})"])?;
        }
        while !statuses.is_empty() {
            let finished = group.wait()?;
            assert(finished.index < statuses.length());
            assert(finished.status == statuses.remove(finished.index));
        }
        let child = Process::spawn(
            program,
            [
                "-c",
                "import sys; data=sys.stdin.buffer.read(); sys.stdout.buffer.write(data); sys.stdout.buffer.flush(); sys.exit(7)"
            ]
        )?;
        let alias = child;
        async let pending = child.read(32);
        await yield_once();
        await close(pending);
        var bytes: Vector<u8> = [0, 255, 10, 128, 65];
        await child.write_all(&&bytes)?;
        child.close_input()?;
        var result: Vector<u8> = [];
        while {
            match await child.read(4096)? {
                .End => break,
                .Data(data) => { result.append(data); },
            }
        }
        assert(result.length() == 5 && result[0] == 0 && result[1] == 255 && result[3] == 128);
        let status = await child.wait()?;
        assert(await alias.wait()? == status);
        child.close_input()?;
        // A child can exit before the parent half-closes its stdin.
        let exited = Process::spawn(program, ["-c", "pass"])?;
        match await exited.read(1)? {
            .End => {},
            .Data(_) => assert(false),
        }
        assert(await exited.wait()? == 0);
        exited.close_input()?;
        exited.close_input()?;
        await check_transport(&&program)?;
        status
    } catch {
        ProcessError(_) => -1,
    };
}

async fn main(args) {
    assert(args.length() == 3);
    let program = args[0] as String;
    assert(await probe(&&program) == 7);
    println("process: roundtrip, cancellation, shared handle, exit status");
}
