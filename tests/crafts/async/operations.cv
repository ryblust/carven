import std::async using { close, yield_once }
import std::channel using ByteChannel;
import std::io using { IOError, write_stdout_async }

private const async fn check_channel() {
    let channel = ByteChannel::new(1);
    let bytes: Vector<u8> = [0, 255, 65];
    let sending = channel.send(&&bytes);
    match channel.try_receive() {
        .Pending => {},
        _ => fail("send must remain cold"),
    }
    require(await sending);
    match await channel.receive() {
        .Data(data) => check(data.length() == 3 && data[1] == 255),
        .End => check(false),
    }
    check(channel.try_send(&&[]));
    match channel.try_receive() {
        .Data(data) => check(data.is_empty()),
        _ => check(false),
    }
    async let waiting = channel.receive();
    await yield_once();
    await close(waiting);
    channel.close();
    match channel.try_receive() {
        .End => {},
        _ => check(false),
    }
    match await channel.receive() {
        .End => {},
        .Data(_) => check(false),
    }
}

const test "Byte channel: static send, receive, and cancellation" {
    await check_channel();
}

async test "Byte channel: native send, receive, and cancellation" {
    await check_channel();
}

async test "Async output: native stdout write completes" {
    let output = Vector<u8>::from_slice("native async: stdout, channel, cancellation\n".bytes);
    try {
        await write_stdout_async(&&output)?;
    } catch {
        IOError(_) => fail("unexpected stdout failure"),
    }
}
