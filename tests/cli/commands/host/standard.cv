import std::fs using { FileError, read_text, write_text }
import std::process using Process;

const {
    write_text("observed.txt", "static input")?;
    let child = Process::spawn_inherited("carven", ["--version"])?;
    assert(await child.wait()? == 0);
    println("static standard capabilities");
}

fn main() throw FileError {
    assert(read_text("observed.txt")? == "static input");
    println("interpreted standard capabilities");
}
