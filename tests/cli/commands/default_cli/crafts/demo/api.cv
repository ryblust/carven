import "demo/native.hpp";

#[cpp] ---
#include <cstdio>

namespace {
struct Lifetime final {
    Lifetime() noexcept { std::puts("fragment initialized"); }
    ~Lifetime() noexcept { std::puts("fragment destroyed"); }
};
const auto lifetime = Lifetime();
} // namespace
---

private import(cpp) fn native_answer() -> i32;

private fn parse(text: str) -> i32 => i32::parse(text)?;

export fn answer(use_native: bool) -> i32 {
    if use_native { return native_answer(); }
    return try {
        parse("42")?
    } catch {
        _ => 0,
    };
}
