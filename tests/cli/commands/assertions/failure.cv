fn verify() {
    var actual = [1, 11];
    let expected = [2, 22];
    assert(
        actual == expected,
        if true {
            actual[0] = 99;
            eprintln("message evaluated");
            "array mismatch"
        } else {
            "unused"
        }
    );
    eprintln("unreachable");
}

verify();
