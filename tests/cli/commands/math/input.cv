const root = 9.0f32.sqrt();
const lanes = f32x4::from_array([1.0, 4.0, 9.0, 16.0]).sqrt().clamp(2.0, 3.0);

fn main() {
    println(root, 16.0f64.sqrt(), (-1.0f64).sqrt().is_finite());
    let nan = 0.0f32 / 0.0;
    println(lanes.lane(0), lanes.lane(3), lanes.is_finite().all());
    let values = f32x8::splat(-4.0).with_lane(7, nan);
    println(values.abs().sqrt().max(1.0).min(3.0).is_finite().bits());
}
