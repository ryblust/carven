import .helper using { DisplayCell, show_cells };

struct Money {
    cents: i64
}

struct Pair {
    first: Money,
    second: Money
}

fn make_money(value: i64) -> Money {
    println(value);
    return Money { value };
}

struct Empty {}

struct Order {
    price: Money,
    names: [str; 2]
}

enum Status {
    Pending,
    Done(i32)
}

const fn display() {
    println(
        Order {
            Money { 1250 },
            ["a", "b\n"]
        }
    );
    println(Status::Done(42));
    println([1, 2, 3]);
    println([',', '我']);
    println(1..=3);
    println([Money { 7 }]);
    let empty: [i32; 0] = [];
    println(Empty {}, empty, Status::Pending);
}

const {
    display();
}

println(Pair { make_money(1), make_money(2) });
display();

class Token {
    secret: i32,

    fn create(secret: i32) -> Token => { secret: secret };
}

class EmptyToken {

    fn create() -> EmptyToken => {};
}

struct Envelope {
    token: Token,
    empty: EmptyToken,
}

println(Token::create(42), EmptyToken::create());
println(Envelope { Token::create(7), EmptyToken::create() });
println([Token::create(1), Token::create(2)]);

// Aggregate fields retain distinct identities through C++ naming and display.
struct __A {
    __A: i32,
    A_cv: i32,
    a__b: i32,
    a__b_cv: i32,
    cv_name_5f5f41: i32,
    cv_name_member_5f5f41: i32,
}

var encoded_fields = __A { 1, 2, 3, 4, 5, 6 };
encoded_fields.__A += encoded_fields.A_cv;
encoded_fields.a__b += encoded_fields.a__b_cv;
encoded_fields.cv_name_5f5f41 += encoded_fields.cv_name_member_5f5f41;
println(encoded_fields);

// Both modules display the same nominal type inside arrays and slices.
let rows = [[DisplayCell { 9 }]];
show_cells(rows.as_slice());
println(rows);
let ranges = [1..=2, 3..4];
println(ranges.as_slice());

enum Single {
    Only
}

enum Code {
    First = -1,
    Last = 7
}

enum PayloadOnly {
    Value(i32)
}

enum OptionalValue {
    Value(i32),
    Empty
}

println(Single::Only, Code::First, Code::Last);
println(PayloadOnly::Value(5), OptionalValue::Empty);

struct Branch {
    children: [Branch]
}

const leaf = Branch { [] };
const twig = Branch { [leaf] };
const branch = Branch { [twig] };
const crown = Branch { [branch] };

println(Branch { [crown] });
println(leaf);
