test "failed" {
    eprintln("before failures");
    var actual = [
        1,
        2
    ];
    let expected = [
        1,
        3
    ];
    check(actual == expected, "first line\nsecond line");
    eprintln("between failures");
    var calls = 0;
    check(
        false,
        if true {
            ++calls;
            "CLI failure"
        } else {
            "unused"
        }
    );
    check(calls == 1);
    check(
        false
            && if true {
                ++calls;
                true
            } else {
                false
            },
        "second failure"
    );
    check(calls == 1);
    eprintln("after failures");
}

test "required" {
    require(false, "required condition");
}

test "explicit\nfailure" {
    fail("");
}

test "passed" {
    println("next");
}

println("unexpected program entry");

test {
    check(false, "first anonymous failure");
}

test {
    check(false, "second anonymous failure");
}

test "" {
    check(false, "explicit empty label");
}

const test {
    check(true);
}

const test "compile" {
    check(true);
}
