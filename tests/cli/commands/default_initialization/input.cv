struct Foo {
    a: i32,
    b: String
}

struct Values {
    items: [Foo; 2],
    enabled: bool
}

const {
    println(Foo {});
    println(
        Values {
            items: [
                Foo {
                    a: 0,
                    ...
                },
                Foo {
                    b: String {},
                    ...
                }
            ],
            enabled: true
        }
    );
}

println(Foo {});

println(
    Values {
        items: [
            Foo {
                a: 0,
                ...
            },
            Foo {
                b: String {},
                ...
            }
        ],
        enabled: true
    }
);
