import carven::fixture using scalar;
import demo::api using answer;

const fn prepare() {
    println("compiled");
    return 1;
}

const prepared = prepare();

const test "static execution" {
    println("static test");
}

const {
    println("const block");
}

test "unselected test entry" {
    println("unexpected runtime test");
}

struct Failure {}

fn main(args) throw Failure {
    println("running", prepared);
    println(char::from_u32_unchecked(scalar()));
    println(answer());
    for argument in args {
        println(argument);
    }
    throw Failure {};
}
