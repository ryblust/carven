import std::utf.scalar using { char_from_u32, UnicodeScalarError };
import demo::api using answer;

const fn prepare() {
    println("compiled");
    return 1;
}

const prepared = prepare();

const test "static execution" {
    println("static test");
}

const {
    println("const block");
}

test "unselected test entry" {
    println("unexpected runtime test");
}

struct Failure {}

fn main(args) throw Failure + UnicodeScalarError {
    println("running", prepared);
    println(char_from_u32(65)?);
    println(answer());
    for argument in args {
        println(argument);
    }
    throw Failure {};
}
