struct Pair {
    values: [f64; 2]
}

fn scale(value: f32) -> f64 => (value as f64) * 2.0;

fn main() {
    var pair = Pair {
        values: [scale(1.5f32), 0.0]
    };
    pair.values[1] = -pair.values[0] / 2.0;
    let infinity = 1.0 / 0.0;
    let nan = 0.0 / 0.0;
    println(pair.values[0] == 3.0 && pair.values[1] == -1.5);
    println(infinity > 0.0 && nan != nan && !(nan >= 0.0));
    println(1.0 / -0.0 < 0.0);
    println(pair.values[0], pair.values[1]);
    let precision = 2;
    println(f"{pair.values[0]:.{precision}f}/{pair.values[1]:.1f}");
}
