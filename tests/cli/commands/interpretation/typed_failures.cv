import std::utf using UTF8Error;

enum Failure {
    Invalid(i32),
    Empty
}

fn read(ok: bool) -> i32 throw Failure {
    if ok { return 42; }
    throw Failure::Invalid(7);
}

fn relay() -> i32 throw Failure => try {
    read(false)?
} catch {
    Failure(_) => rethrow,
};

let result = try {
    relay()?
} catch {
    Failure(.Invalid(code)) => code,
    Failure(.Empty) => 0,
};

println(result);

let success = try {
    read(true)?
} catch {
    _ => -1,
};

println(success);

fn view(bytes: [u8]) -> str throw UTF8Error => str::from_utf8(bytes)?;

println(view([65u8, 66])?);

let invalid = [0xffu8];

let offset = try {
    let _ = view(invalid)?;
    99usize
} catch {
    UTF8Error(error) => error.offset,
};

println(offset);
