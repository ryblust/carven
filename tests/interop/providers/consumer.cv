import .header_bridge using { header_twice, twice_via_header };
import "providers/providers.hpp";
import <cstdint>;

#[cpp] -----
    inline constexpr auto provider_forms_fence_text = R"(
---
)";
    std::int32_t provider_forms_trace = 0;

    template<typename Type>
    struct ProviderFormsCounter;

    template<>
    struct ProviderFormsCounter<std::int32_t> final {
        static auto record(std::int32_t value) noexcept -> std::int32_t {
            ++provider_forms_trace;
            return value;
        }
    };

    auto native_counted(std::int32_t value) noexcept -> std::int32_t {
        return ProviderFormsCounter<std::int32_t>::record(value);
    }
-----

#[cpp] ---
    auto native_trace() noexcept -> std::int32_t {
        return provider_forms_trace;
    }
---

private import(cpp) fn native_counted(value: i32) -> i32;
private import(cpp) fn native_observe(value: usize);
private import(cpp) fn native_trace() -> i32;
private import(cpp) fn linked_offset(value: i32) -> i32;

test "C++ provider forms execute import bridges and Carven wrappers" {
    check(native_counted(7) == 7);
    check(native_trace() == 1);

    let callback: fn(i32) -> i32 = native_counted;
    check(callback(8) == 8);
    check(native_trace() == 2);

    native_observe(40usize);
    check(native_trace() == 42);
    check(header_twice(21) == 42);
    check(twice_via_header(21) == 42);
    check(linked_offset(40) == 42);
}
