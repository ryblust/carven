private async fn failure_producer(
    recover: bool,
    stop_on_release: bool
) -> i32 throw PayloadFailure {
    if stop_on_release {
        let lease = StopOnRelease {};
        return await reject_payload(7)?;
    }
    let lease = Lease {};
    return try {
        await reject_payload(7)?
    } catch {
        PayloadFailure(error) => {
            record('l', error.value);
            if !recover { rethrow; }
            error.payload.get() as i32
        },
    };
}

