import std::async using { yield_once, wait_ready, close, when_all, when_any, first_successful }
import "async/bridge.hpp" using async_bridge::{ Context, TrivialContext }

struct IOError {
    code: i32
}

#[cpp] ---
#include "async/bridge_provider.hpp"
---

import(cpp) async fn bridge_read_byte(
    context: Context
) -> i32 throw IOError = ::async_bridge::bridge_read_byte;

import(cpp) async fn bridge_write_byte(
    context: Context,
    value: i32
) throw IOError = ::async_bridge::bridge_write_byte;

import(cpp) async fn bridge_trivial_byte(
    context: TrivialContext,
    marker: i32
) -> i32 throw IOError = ::async_bridge::bridge_trivial_byte;

import(cpp) async fn bridge_native_character(
    value: i32,
    fail: bool
) -> char throw IOError = ::async_bridge::bridge_native_character;

import(cpp) fn bridge_note(context: Context, stage: i32) = ::async_bridge::bridge_note;

export(cpp) async fn source_read(context: Context) -> i32 throw IOError => await bridge_read_byte(
    context
)?;

export(cpp) async fn source_exchange(
    reader: Context,
    writer: Context,
    value: i32
) -> i32 throw IOError {
    await bridge_write_byte(writer, value)?;
    return await bridge_read_byte(reader)?;
}

export(cpp) async fn source_stored(context: Context) -> i32 throw IOError {
    bridge_note(context, 1);
    let operation = bridge_read_byte(context);
    bridge_note(context, 2);
    await yield_once();
    let value = await operation?;
    bridge_note(context, 3);
    return value;
}

export(cpp) async fn source_recover(context: Context) -> i32 {
    try {
        return await bridge_read_byte(context)?;
    } catch {
        IOError(error) => { return error.code; },
    }
}

export(cpp) async fn source_close(context: Context) -> i32 {
    async let child = bridge_read_byte(context);
    await yield_once();
    cancel child;
    return 17;
}

export(cpp) async fn source_explicit_close(context: Context) -> i32 {
    async let child = bridge_read_byte(context);
    await yield_once();
    cancel child;
    let (index, cancelled) = await wait_ready(child);
    assert(index == 0 && cancelled);
    await close(child);
    await close(child);
    return 17;
}

export(cpp) async fn source_drain(context: Context) -> i32 {
    async let child = bridge_read_byte(context);
    await yield_once();
    // The native read is still registered; close must request cancellation
    // and await provider quiescence itself before returning.
    await close(child);
    return 17;
}

private async fn later_marker() -> i32 {
    await yield_once();
    return 23;
}

private fn trivial_factory(
    const offset: i32,
    context: TrivialContext,
    marker: i32
) => bridge_trivial_byte(context, marker + offset);

private fn trivial_outer_factory(
    context: TrivialContext,
    const offset: i32,
    marker: i32
) => trivial_factory(offset, context, marker);

export(cpp) async fn source_trivial(context: TrivialContext) -> i32 throw IOError {
    let operation = trivial_outer_factory(context, 0, await later_marker());
    await yield_once();
    return await operation?;
}

export(cpp) async fn source_character(value: i32, fail: bool) -> char throw IOError {
    return await bridge_native_character(value, fail)?;
}

export(cpp) async fn source_discard_character(value: i32, fail: bool) throw IOError {
    await bridge_native_character(value, fail)?;
}

export(cpp) async fn source_join_characters(value: i32, fail: bool) throw IOError {
    await when_all(bridge_native_character(value, fail), bridge_native_character(90, false))?;
}

export(cpp) async fn source_race_characters(value: i32, fail: bool) throw IOError {
    await when_any(bridge_native_character(value, fail), bridge_native_character(90, false))?;
}

export(cpp) async fn source_first_character(value: i32, fail: bool) throw IOError {
    await first_successful(
        bridge_native_character(value, fail),
        bridge_native_character(90, false)
    )?;
}

// A consumed success must be checked even when a later input fails the join.
export(cpp) async fn source_join_character_then_failure(value: i32) throw IOError {
    await when_all(bridge_native_character(value, false), bridge_native_character(0xd800, true))?;
}
