import std::async using yield_once;
import "async/tracked.hpp";

import(cpp) fn make_tracked() -> ::Tracked = ::make_tracked;
import(cpp) fn tracked_created() -> i32 = ::tracked_created;
import(cpp) fn tracked_copied() -> i32 = ::tracked_copied;
import(cpp) fn tracked_moved() -> i32 = ::tracked_moved;
import(cpp) fn tracked_destroyed() -> i32 = ::tracked_destroyed;
import(cpp) fn tracked_live() -> i32 = ::tracked_live;

private async fn tracked() -> ::Tracked => make_tracked();

private async fn local_after_yield(value: i32) -> i32 {
    let held = make_tracked();
    if tracked_live() != 1 {
        return -1;
    }
    await yield_once();
    if tracked_live() != 1 {
        return -2;
    }
    if value < 0 {
        return value;
    }
    return value + 1;
}

private fn local_factory(value: i32) {
    let held = make_tracked();
    return local_after_yield(value);
}

async test "Async native values: transfer and local destruction" {
    check(
        (tracked_created(), tracked_copied(), tracked_moved(), tracked_destroyed(), tracked_live())
            == (0, 0, 0, 0, 0)
    );
    if true {
        let held = await tracked();
        check(tracked_created() == 1 && tracked_copied() == 0 && tracked_live() == 1);
    }
    check(tracked_live() == 0 && tracked_destroyed() == tracked_created() + tracked_moved());

    let created_before = tracked_created();
    let selected = await local_after_yield(-7);
    check((selected, tracked_live(), tracked_created() - created_before) == (-7, 0, 1));
    check(tracked_copied() == 0 && tracked_destroyed() == tracked_created() + tracked_moved());

    let factory_created_before = tracked_created();
    let factory_selected = await local_factory(-7);
    check(
        (factory_selected, tracked_live(), tracked_created() - factory_created_before) == (-7, 0, 2)
    );
    check(tracked_copied() == 0 && tracked_destroyed() == tracked_created() + tracked_moved());
}
