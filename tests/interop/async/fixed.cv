import std::async using { wait_ready, close }
import std::time using { timeout, TimeRangeError, Timeout }
import "async/fixed.hpp";

import(cpp) fn make_fixed() -> ::Fixed = ::make_fixed;
import(cpp) fn make_declared() -> ::Fixed throw ParentFailure = ::make_fixed_outcome;
import(cpp) fn fixed_created() -> i32 = ::fixed_created;
import(cpp) fn fixed_destroyed() -> i32 = ::fixed_destroyed;
import(cpp) fn fixed_live() -> i32 = ::fixed_live;
import(cpp) fn fixed_trace() -> i32 = ::fixed_trace;
import(cpp) fn fixed_identity_stable() -> i32 = ::fixed_identity_stable;
import(cpp) async fn fixed_cancel_on_destroy() -> i32 = ::fixed_cancel_on_destroy;
import(cpp) fn fixed_completion_cancel_observed() -> bool = ::fixed_completion_cancel_observed;
import(cpp) async fn fixed_aligned_frames() -> bool = ::fixed_aligned_frames;

struct ParentFailure {}

private fn sync_fixed() -> ::Fixed => make_fixed();

private fn nominal_fixed(fail: bool) -> ::Fixed throw ParentFailure {
    if fail { throw ParentFailure {}; }
    return ::Fixed {};
}

private fn sync_widened() -> ::Fixed throw ParentFailure => make_declared()?;

private fn sync_selected(flag: bool) -> ::Fixed {
    if flag {
        return try {
            sync_widened()?
        } catch {
            ParentFailure(_) => make_fixed()
        };
    }
    return sync_fixed();
}

private async fn fixed() -> ::Fixed => sync_selected(true);

private async fn forward() -> ::Fixed {
    return await fixed();
}

// Different failure sets require success-only carrier adoption, not T movement.
private async fn parent() -> ::Fixed throw ParentFailure {
    return await forward();
}

async test "Async native values: immovable identity and completion cleanup" {
    try {
        check(await fixed_aligned_frames());
        check(
            (
                fixed_created(),
                fixed_destroyed(),
                fixed_live(),
                fixed_trace(),
                fixed_identity_stable()
            )
                == (0, 0, 0, 0, 0)
        );
        if true {
            let held = await parent()?;
            check(held.at_construction_address() as bool);
            check(
                (
                    fixed_created(),
                    fixed_destroyed(),
                    fixed_live(),
                    fixed_trace(),
                    fixed_identity_stable()
                )
                    == (1, 0, 1, 1, 1)
            );
        }
        check(
            (
                fixed_created(),
                fixed_destroyed(),
                fixed_live(),
                fixed_trace(),
                fixed_identity_stable()
            )
                == (1, 1, 0, 12, 0)
        );
        if true {
            let held = await timeout(parent(), 1s)?;
            check(held.at_construction_address() as bool);
            check(fixed_created() == 2 && fixed_destroyed() == 1 && fixed_live() == 1);
            check(fixed_identity_stable() == 1);
        }
        check(fixed_destroyed() == 2 && fixed_live() == 0);
        if true {
            let held = sync_selected(false);
            check(held.at_construction_address() as bool);
            check(fixed_created() == 3 && fixed_destroyed() == 2 && fixed_live() == 1);
            check(fixed_identity_stable() == 1);
        }
        check(fixed_destroyed() == 3 && fixed_live() == 0);
        if true {
            let held = if fixed_created() != 3 { sync_fixed() } else { ::Fixed {} };
            check(held.at_construction_address() as bool);
            check(fixed_created() == 4 && fixed_destroyed() == 3 && fixed_live() == 1);
            check(fixed_identity_stable() == 1);
        }
        check(fixed_destroyed() == 4 && fixed_live() == 0);
        if true {
            let held = try {
                nominal_fixed(false)?
            } catch {
                ParentFailure(_) => ::Fixed {}
            };
            check(held.at_construction_address() as bool);
            check(fixed_created() == 5 && fixed_destroyed() == 4 && fixed_live() == 1);
            check(fixed_identity_stable() == 1);
        }
        check(fixed_destroyed() == 5 && fixed_live() == 0);

        async let candidate = timeout(fixed_cancel_on_destroy(), 1s);
        let (_, cancelled) = await wait_ready(candidate);
        await close(candidate);
        check(cancelled && fixed_completion_cancel_observed());
    } catch {
        ParentFailure(_) => fail("unexpected parent failure"),
        Timeout(_) => fail("unexpected native value timeout"),
        TimeRangeError(_) => fail("unexpected native value time range failure"),
    }
}
