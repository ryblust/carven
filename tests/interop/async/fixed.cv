import std::time.timeout using Timeout;
import std::time.duration using RangeError;
import "async/fixed.hpp";

// These declarations publish scalar native results to source analysis without
// inferring a borrowing contract from an opaque C++ expression result.
import(cpp) fn make_fixed() -> ::Fixed;
import(cpp) fn fixed_created() -> i32;
import(cpp) fn fixed_destroyed() -> i32;
import(cpp) fn fixed_live() -> i32;
import(cpp) fn fixed_trace() -> i32;
import(cpp) fn fixed_identity_stable() -> i32;
import(cpp) async fn fixed_cancel_on_destroy() -> i32;
import(cpp) fn fixed_completion_cancel_observed() -> bool;

private struct ParentFailure {}

private async fn fixed() -> ::Fixed => make_fixed();

private async fn forward() -> ::Fixed {
    return await fixed();
}

// Different failure sets require success-only carrier adoption, not T movement.
private async fn parent() -> ::Fixed throw ParentFailure {
    return await forward();
}

private async fn main() throw ParentFailure + Timeout + RangeError {
    println(
        fixed_created(),
        fixed_destroyed(),
        fixed_live(),
        fixed_trace(),
        fixed_identity_stable()
    );
    if true {
        let held = await parent()?;
        println(
            fixed_created(),
            fixed_destroyed(),
            fixed_live(),
            fixed_trace(),
            fixed_identity_stable()
        );
    }
    println(
        fixed_created(),
        fixed_destroyed(),
        fixed_live(),
        fixed_trace(),
        fixed_identity_stable()
    );
    if true {
        let held = await timeout(parent(), 1s)?;
        assert(fixed_created() == 2 && fixed_destroyed() == 1 && fixed_live() == 1);
        assert(fixed_identity_stable() == 1);
    }
    assert(fixed_destroyed() == 2 && fixed_live() == 0);

    async let candidate = timeout(fixed_cancel_on_destroy(), 1s);
    let (_, cancelled) = await wait_ready(candidate);
    await close(candidate);
    assert(cancelled && fixed_completion_cancel_observed());
}
