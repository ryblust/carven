import std::async using { cancel_point, yield_once }
import "async/tail.hpp";
import "lifetimes/lifetimes.hpp" using lifetime_probe;

import(cpp) fn tail_reset() = ::tail_reset;
import(cpp) fn tail_mark(digit: i32) = ::tail_mark;
import(cpp) fn tail_actual(value: i32, digit: i32) -> i32 = ::tail_actual;
import(cpp) fn tail_trace() -> i32 = ::tail_trace;
import(cpp) fn tail_owner(digit: i32) -> ::TailOwner = ::tail_owner;
import(cpp) fn tail_address(&value: i32) = ::tail_address;
import(cpp) fn tail_addresses() -> i32 = ::tail_addresses;
import(cpp) async fn tail_native() -> i32 = ::tail_native;

export(cpp) async fn bounded_tail(depth: i32, accumulator: i32) -> i32 {
    if depth == 0 { return accumulator; }
    return await bounded_tail(depth - 1, accumulator + 1);
}

private async fn yielding_increment(value: i32) -> i32 {
    await yield_once();
    await cancel_point();
    return value + 1;
}

private async fn retain_actual_owner(value: i32) -> i32 {
    if !(lifetime_probe::matches("3 13 ") as bool) { return -1; }
    await yield_once();
    if !(lifetime_probe::matches("3 13 ") as bool) { return -2; }
    return value;
}

export(cpp) async fn bounded_producer(count: i32, seed: i32) -> i32 {
    var result = seed;
    for var index = 0; index < count; ++index {
        result = await yielding_increment(result);
    }
    return result;
}

async fn effects(a: i32, b: i32, depth: i32, _: i32) -> i32 {
    if depth == 0 { return a * 10 + b; }
    return await effects(tail_actual(b, 1), tail_actual(a, 2), depth - 1, tail_actual(0, 3));
}

async fn sibling() {
    tail_mark(8);
}

async fn yielding(depth: i32) -> i32 {
    tail_mark(1);
    await yield_once();
    if depth == 0 { return 7; }
    return await yielding(depth - 1);
}

async fn owned(depth: i32) -> i32 {
    let _ = tail_owner(depth + 1);
    if depth == 0 { return 7; }
    return await owned(depth - 1);
}

fn expose(&value: i32) {
    tail_address(&value);
}

async fn addressed(depth: i32) -> i32 {
    var local = depth;
    expose(&local);
    if depth == 0 { return tail_addresses(); }
    return await addressed(depth - 1);
}

// Await initialization closes the native carrier before the next cold call.
async fn actual_cleanup(depth: i32) -> i32 {
    tail_mark(1);
    if depth == 0 { return tail_trace(); }
    return await actual_cleanup(depth - await tail_native());
}

fn combine(a: i32, b: i32) -> i32 => a + b;

async fn outer_cleanup(depth: i32) -> i32 {
    tail_mark(1);
    if depth == 0 { return tail_trace(); }
    return combine(await tail_native(), if depth > 0 { await outer_cleanup(depth - 1) } else { 0 });
}

async fn skipped_step(depth: i32) -> i32 {
    if depth == 0 { return tail_trace(); }
    for var index = 0; index < 1; tail_mark(9), ++index {
        return await skipped_step(depth - 1);
    }
    return -1;
}

async fn scalar_operation(value: i32) -> i32 {
    let _ = tail_owner(3);
    var text: String = "abc";
    tail_mark(1);
    if value < 0 { return tail_actual(text.byte_length() as i32, 2); }
    await yield_once();
    return tail_actual(value + text.byte_length() as i32, 4);
}

fn operation_factory(value: i32, _: i32) => scalar_operation(value);

async fn boolean_operation(value: bool) -> bool {
    let _ = tail_owner(6);
    await yield_once();
    return tail_actual(if value { 1 } else { 0 }, 5) > 0;
}

async fn character_operation(value: bool) -> char {
    let _ = tail_owner(7);
    if value { return 'a'; }
    await yield_once();
    return 'b';
}

async fn composed_results(value: i32) -> i32 {
    let selected = await operation_factory(tail_actual(value, 8), tail_actual(0, 9));
    await yield_once();
    let flag = await boolean_operation(selected > 3);
    let letter = await character_operation(flag);
    await yield_once();
    return if letter == 'a' { selected } else { selected * 10 };
}

async fn discarded_results() {
    tail_reset();
    await operation_factory(tail_actual(2, 8), tail_actual(0, 9));
    assert(tail_trace() == 89143);
    tail_reset();
    await boolean_operation(true);
    await character_operation(false);
    assert(tail_trace() == 567);
}

async fn run_tail() {
    lifetime_probe::reset();
    let retained = (
        await retain_actual_owner(lifetime_probe::Owner { 3 }.probe() as i32),
        lifetime_probe::matches("3 13 ") as bool
    );
    assert(retained == (1, true));
    assert(lifetime_probe::matches("3 13 -3 ") as bool);
    tail_reset();
    assert((await effects(1, 2, 2, 0), tail_trace()) == (12, 123123));
    tail_reset();
    let saved = effects(1, 2, 1, 0);
    assert((await saved, tail_trace()) == (21, 123));
    tail_reset();
    async let queued = sibling();
    assert((await yielding(2)) == 7);
    await queued;
    assert(tail_trace() == 1811);
    tail_reset();
    assert((await owned(3), tail_trace()) == (7, 1234));
    tail_reset();
    assert((await addressed(3)) == 4);
    tail_reset();
    assert((await actual_cleanup(2), tail_trace()) == (14141, 14141));
    tail_reset();
    assert((await outer_cleanup(2), tail_trace()) == (14143, 14141));
    tail_reset();
    assert((await skipped_step(3), tail_trace()) == (0, 0));
    tail_reset();
    assert((await composed_results(-1), tail_trace()) == (30, 89123567));
    tail_reset();
    assert((await composed_results(2), tail_trace()) == (5, 89143567));
    await discarded_results();
}
