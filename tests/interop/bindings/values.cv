import "bindings/values.hpp";
import <string>;
import <vector> using std::vector;

fn create() -> vector<i32> => vector<i32> { 1, 2, 3 };
fn count(values: vector<i32>) -> usize => values.size();

fn append(&values: vector<i32>, value: i32) {
    values.push_back(value);
}

test "C++ names preserve vector operations and owner bindings" {
    var values = create();
    append(&values, 42);
    check(count(values) == 4usize);
    values[0] = 5;
    values[0] += 1;
    ++values[0];
    check(values[0] == 7);
    let copied = values;
    values[0] = 9;
    check(copied[0] == 7);
    let moved = &&values;
    check(moved[0] == 9);
    let nested = vector<vector<i32>> {};
    check(nested.empty());
}

struct Entry {
    value: i32,
}

struct Entries {
    values: vector<Entry>,
}

fn entries() -> Entries => { values: vector<Entry> { Entry { value: 11 } } };

test "External owners in structure fields retain Carven template dependencies" {
    let result = entries();
    check(result.values[0].value == 11);
}

struct NativeValues {
    texts: Vector<::std::string>,
    references: Vector<::native_values::Ref>,
}

export(cpp) fn copy_native_values(values: NativeValues) -> NativeValues => values;

test "Vector native leaves preserve value copies and object identity" {
    var original = NativeValues {
        texts: {},
        references: {}
    };
    original.texts.push(::std::string { c"before" });
    original.references.push(::native_values::reference());
    let copied = copy_native_values(original);
    original.texts[0].clear();
    check(copied.texts[0].size() as usize == 6usize);
    check(original.texts[0].empty() as bool);
    check(copied.references[0].same_object(original.references[0]) as bool);
    check(copied.references[0].alive() as bool);
}
