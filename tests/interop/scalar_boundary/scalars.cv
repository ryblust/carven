import "scalar_boundary/providers.hpp";

private import(cpp) fn native_bool(value: bool) -> bool;
private import(cpp) fn native_char(value: char) -> char;
private import(cpp) fn native_i8(value: i8) -> i8;
private import(cpp) fn native_i16(value: i16) -> i16;
private import(cpp) fn native_i32(value: i32) -> i32;
private import(cpp) fn native_i64(value: i64) -> i64;
private import(cpp) fn native_u8(value: u8) -> u8;
private import(cpp) fn native_u16(value: u16) -> u16;
private import(cpp) fn native_u32(value: u32) -> u32;
private import(cpp) fn native_u64(value: u64) -> u64;
private import(cpp) fn native_isize(value: isize) -> isize;
private import(cpp) fn native_usize(value: usize) -> usize;
private import(cpp) fn native_f32(value: f32) -> f32;
private import(cpp) fn native_f64(value: f64) -> f64;

export(cpp) fn echo_bool(value: bool) -> bool {
    return native_bool(value);
}

export(cpp) fn echo_char(value: char) -> char {
    return native_char(value);
}

export(cpp) fn echo_i8(value: i8) -> i8 {
    return native_i8(value);
}

export(cpp) fn echo_i16(value: i16) -> i16 {
    return native_i16(value);
}

export(cpp) fn echo_i32(value: i32) -> i32 {
    return native_i32(value);
}

export(cpp) fn echo_i64(value: i64) -> i64 {
    return native_i64(value);
}

export(cpp) fn echo_u8(value: u8) -> u8 {
    return native_u8(value);
}

export(cpp) fn echo_u16(value: u16) -> u16 {
    return native_u16(value);
}

export(cpp) fn echo_u32(value: u32) -> u32 {
    return native_u32(value);
}

export(cpp) fn echo_u64(value: u64) -> u64 {
    return native_u64(value);
}

export(cpp) fn echo_isize(value: isize) -> isize {
    return native_isize(value);
}

export(cpp) fn echo_usize(value: usize) -> usize {
    return native_usize(value);
}

export(cpp) fn echo_f32(value: f32) -> f32 {
    return native_f32(value);
}

export(cpp) fn echo_f64(value: f64) -> f64 {
    return native_f64(value);
}

test "C++ scalar boundary crosses import and export directions" {
    check(native_bool(true));
    check(native_char('Z') == 'Z');
    check(native_i8(-8i8) == -8i8);
    check(native_i16(-16i16) == -16i16);
    check(native_i32(-32i32) == -32i32);
    check(native_i64(-64i64) == -64i64);
    check(native_u8(8u8) == 8u8);
    check(native_u16(16u16) == 16u16);
    check(native_u32(32u32) == 32u32);
    check(native_u64(64u64) == 64u64);
    check(native_isize(-7isize) == -7isize);
    check(native_usize(7usize) == 7usize);
    check(native_f32(1.25f32) == 1.25f32);
    check(native_f64(2.5f64) == 2.5f64);
}

test "C++ deduction: scalar expressions preserve canonical types" {
    let value_i8: i8 = 3;
    check(::native_exact_i8(1i8));
    check(::native_exact_i8(~value_i8));
    check(::native_exact_i8((value_i8 & 1i8) + 1i8));
    let value_u8: u8 = 3;
    check(::native_exact_u8(1u8));
    check(::native_exact_u8(~value_u8));
    check(::native_exact_u8((value_u8 & 1u8) + 1u8));
    let value_i64: i64 = 3;
    check(::native_exact_i64(1i64));
    check(::native_exact_i64(~value_i64));
    check(::native_exact_i64((value_i64 & 1i64) + 1i64));
    let value_u64: u64 = 3;
    check(::native_exact_u64(1u64));
    check(::native_exact_u64(~value_u64));
    check(::native_exact_u64((value_u64 & 1u64) + 1u64));
    let value_isize: isize = 3;
    check(::native_exact_isize(1isize));
    check(::native_exact_isize(~value_isize));
    check(::native_exact_isize((value_isize & 1isize) + 1isize));
    let value_usize: usize = 3;
    check(::native_exact_usize(1usize));
    check(::native_exact_usize(~value_usize));
    check(::native_exact_usize((value_usize & 1usize) + 1usize));
    check(::native_overload_i8(1i8));
    check(::native_overload_i8(~value_i8));
}

export(cpp) fn expression_scalar(value: i32) => value + 1;
export(cpp) fn expression_void() => expression_action();
fn expression_action() { ::scalar_boundary_detail::record_expression_call(); }
fn native_expression(value: i32) => ::native_i32(value);

test "C++ boundary: expression bodies retain native result queries" {
    check(native_expression(7) == 7);
}
