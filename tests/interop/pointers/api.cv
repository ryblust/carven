import "pointers/provider.hpp";

struct Link {
    value: i32,
    next: ptr<&Link>,
}

fn identity(p: ptr<Link>) -> ptr<Link> => p;
fn opaque() -> ptr<::pointer_probe::Incomplete> => ::pointer_probe::opaque();
fn accept_opaque(p: ptr<::pointer_probe::Incomplete>) -> bool => p == nullptr;

struct CallbackHolder {
    callback: ptr<fn(Later) -> void>,
}

struct Later {
    value: i32,
}
