import "pointers/provider.hpp";
import <vector>;
import <utility>;

fn read(p: ptr<i32>) -> i32 {
    if p == nullptr {
        return -1;
    }
    return *p;
}

fn writable_address() -> ptr<&i32> => ::pointer_probe::get();

test "Pointers: native slice projections preserve Read access" {
    var pairs = [::std::pair<i32, i32> { 1, 2 }];
    let pair_view = pairs.slice();
    let member = addressof(pair_view[0].first);
    check(*member == 1);
    var arrays = [::std::vector<i32> { 3, 4 }];
    let array_view = arrays.slice();
    let element = addressof(array_view[0][1]);
    check(*element == 4);
}

test "Pointers: Read calls snapshot addresses and dereference selects its target first" {
    var p: ptr<&i32> = ::pointer_probe::get();
    check(::pointer_probe::snapshot(p, &p));
    check(read(p) == 20);
    p = ::pointer_probe::get();
    let next: ptr<&i32> = ::pointer_probe::other();
    if p == nullptr {
        fail("missing address");
    }
    let old = *p;
    ::pointer_probe::increment(&*p, next, &p);
    check(read(p) == 20);
    let original: ptr<i32> = ::pointer_probe::get();
    check(read(original) == old + 1);
}

test "Pointers: noncopyable native targets can be observed through an address" {
    let p: ptr<::pointer_probe::Fixed> = ::pointer_probe::fixed_object();
    if p != nullptr {
        check(p->read() == 91);
    }
}

test "Pointers: native qualifiers aliases and incomplete targets retain their types" {
    let empty: ptr<i32> = nullptr;
    check(::pointer_probe::overload(empty) == 1);
    let null_write: ptr<&i32> = nullptr;
    check(::pointer_probe::overload(null_write) == 2);
    check(::pointer_probe::deduces_writable_pointer(null_write));
    check(!::pointer_probe::deduces_writable_pointer(empty));
    check(::pointer_probe::observes_const_lvalue(null_write));
    check(::pointer_probe::observes_const_lvalue(writable_address()));
    let native: ptr<::pointer_probe::NativePointer> = ::pointer_probe::nested_native();
    check(::pointer_probe::deduces_readonly_native_slot(native));
    check(native != nullptr);
    let opaque: ptr<::pointer_probe::Incomplete> = ::pointer_probe::opaque();
    check(opaque == nullptr);
    let nothing: ptr<void> = nullptr;
    check(nothing == nullptr);
    let opaque_address: ptr<void> = ::pointer_probe::opaque_address();
    check(::pointer_probe::observes_opaque(opaque_address));
    let native_argument = ::pointer_probe::NativeVoidArgument<void> {};
    check(native_argument.is_void());
    let output: ptr<&i32> = ::pointer_probe::output_adapter();
    check(output != nullptr);
    let owned: ptr<i32> = output;
    check(::pointer_probe::pair(owned, &&owned));
}

fn write_roundtrip(address: ptr<&void>) -> ptr<&void> {
    return ::pointer_probe::roundtrip(address);
}

fn read_roundtrip(address: ptr<void>) -> ptr<void> {
    return ::pointer_probe::roundtrip(address);
}

test "Pointer access: native void pointer protocols retain typed object access" {
    var value = 7;
    let erased = addressof(&value) as ptr<&void>;
    let returned = write_roundtrip(erased);
    let restored = returned as ptr<&i32>;
    if restored == nullptr {
        fail("native protocol lost its address");
    }
    *restored = 19;
    let read = read_roundtrip(returned as ptr<void>) as ptr<i32>;
    if read == nullptr {
        fail("native protocol lost its Read address");
    }
    check(*read == 19 && value == 19);
    check(read == addressof(value));
}
