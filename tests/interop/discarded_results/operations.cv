import "discarded_results/provider.hpp" using discarded_probe::{
    scalar,
    result,
    reset,
    call_count,
    owner_count,
};

private fn native_result() => result();

test "discarded native results preserve calls and destruction" {
    reset();
    scalar();
    check(call_count() == 1);
    result();
    check(call_count() == 2);
    check(owner_count() == 0);
    native_result();
    check(call_count() == 3);
    check(owner_count() == 0);
}
