import "interpolation/provider.hpp";

struct FormatError {
    code: i32,
}

fn fail_format(&count: i32) -> i32 throw FormatError {
    count += 1;
    throw FormatError { code: count };
}

fn after_format(&count: i32) -> i32 {
    count += 10;
    return count;
}

fn replace_format_text(&text: String) -> i32 {
    text.clear();
    text.append("after我\0value");
    return ::interpolation_probe::record_live() as i32;
}

test "Interpolation interop: builtin formatting retains String aliases backing and result ownership" {
    var text: String = "original text longer than a small string buffer";
    let formatted = f"{42:04}|{text}|{::interpolation_probe::make(7).value
            as i32}|{replace_format_text(&text)}";
    check(::interpolation_probe::observed() == 1);
    check(::interpolation_probe::alive() == 0);
    check(formatted.as_str() == "0042|after我\0value|7|1");
    text.clear();
    check(formatted.as_str() == "0042|after我\0value|7|1");
}

test "Interpolation interop: precomputed bytes retain native temporary backing" {
    check(
        f"{(::interpolation_probe::make(42).value == 42)
                && false} {::interpolation_probe::record_live() || true}"
            == "false true"
    );
    check(::interpolation_probe::observed() == 1);
    check(::interpolation_probe::alive() == 0);
}

test "Interpolation interop: precomputed bytes retain propagation and skip later effects" {
    var effects = 0;
    let result = try {
        f"{(fail_format(&effects)? == 0) && false} {(after_format(&effects) == 0) || true}"
    } catch {
        FormatError(error) => {
            check(error.code == 1);
            f"failed"
        },
    };
    check(effects == 1);
    check(result == "failed");
}

test "Interpolation interop: mixed contents retain backing across folded and dynamic holes" {
    ::interpolation_probe::record_live();
    check(
        f"{(::interpolation_probe::make(42).value == 42)
                && false} {::interpolation_probe::record_live() as bool}"
            == "false true"
    );
    check(::interpolation_probe::observed() == 1);
    check(::interpolation_probe::alive() == 0);
    ::interpolation_probe::record_live();
    check(
        f"{::interpolation_probe::make(42).value as i32} {::interpolation_probe::record_live()
                || true}"
            == "42 true"
    );
    check(::interpolation_probe::observed() == 1);
    check(::interpolation_probe::alive() == 0);
    ::interpolation_probe::record_live();
    f"{(::interpolation_probe::make(42).value == 42) && false} {::interpolation_probe::record_live()
            as bool}";
    check(::interpolation_probe::observed() == 1);
    check(::interpolation_probe::alive() == 0);
}

test "Interpolation interop: mixed folded failures clean backing before the handler" {
    var effects = 0;
    ::interpolation_probe::record_live();
    let result = try {
        f"{::interpolation_probe::make(42).value as i32} {::interpolation_probe::record_live()
                || true} {(fail_format(&effects)? == 0) && false} {after_format(&effects)}"
    } catch {
        FormatError(error) => {
            check(error.code == 1);
            check(::interpolation_probe::observed() == 1);
            check(::interpolation_probe::alive() == 0);
            f"failed"
        },
    };
    check(effects == 1);
    check(result == "failed");
    check(::interpolation_probe::alive() == 0);
}

test "Interpolation interop: native formatters retain access to original argument indices" {
    check(f"{42:04} {::interpolation_probe::context_value()} {7}" == "0042 42 7");
}

test "Interpolation interop: C++ formatter receives its specification and reads once" {
    let calls = ::interpolation_probe::calls();
    check(f"{::interpolation_probe::make(42):q04x}".as_str() == "002a");
    check(::interpolation_probe::calls() == calls + 1);
    check(::interpolation_probe::alive() == 0);
    f"{::interpolation_probe::make(7)}";
    check(::interpolation_probe::calls() == calls + 2);
    check(::interpolation_probe::alive() == 0);
}

test "Interpolation interop: propagation cleans pending values before the handler" {
    var effects = 0;
    let calls = ::interpolation_probe::calls();
    let result = try {
        f"{::interpolation_probe::make(1)} {fail_format(&effects)?} {after_format(&effects)}"
    } catch {
        FormatError(error) => {
            check(::interpolation_probe::alive() == 0);
            check(::interpolation_probe::calls() == calls);
            f"error {error.code}"
        },
    };
    check(effects == 1);
    check(result.as_str() == "error 1");
    check(::interpolation_probe::alive() == 0);
}

test "Interpolation interop: native specification braces remain opaque" {
    check(f"{42}/{::interpolation_probe::make(7):\u{7b}04d}" == "42/0007");
}

fn known_width(value: i32) -> String => f"{value:0{16}X}/{value:0{4}x}/{value:{0}}";

test "Interpolation: known dynamic widths preserve output bytes" {
    check(known_width(42) == "000000000000002A/002a/42");
}
