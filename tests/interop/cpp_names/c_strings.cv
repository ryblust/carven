import "cpp_names/c_strings.hpp" using c_strings::{same, pointer_value, const_pointer_reference, remember, remembered, unicode, select, Box};
import "cpp_names/c_strings.hpp" using c_strings::select;
import "cpp_names/c_strings.hpp" using c_other::*;

fn retain_literal() {
    let text = c"retained";
    remember(text);
}

test "C strings: static storage and exact native pointer values" {
    check(same(c"", c""));
    check(same(c"Hello\n", c"Hello\u{a}"));
    check(unicode(c"你好"));
    check(pointer_value(c"abc"));
    let text = c"abc";
    check(pointer_value(text));
    check(const_pointer_reference(text));
    retain_literal();
    check(remembered());
}

test "C++ selections: explicit paths precede open namespaces" {
    check(select(1) == 1);
    check(select(1.0) == 2);
    check(::c_other::select(1) == 3);
    let box = Box { 7 };
    check(box.value == 7);
}
