import "cpp_names/provider.hpp" using { native::record, native::observed, native::reset,
    native::pair, native::argument_access, native::AccessProbe, native::identity,
    native::Owner, native::consume, native::live, native::copies, native::moves,
    native::reset_owner_counts, };

import "cpp_names/provider.hpp" using plain;

test "C++ calls: arguments preserve evaluation order" {
    reset();
    check(plain(17) == 17);
    let result = pair(record(1), record(2));
    check(result == 12);
    check(observed() == 12);
}

test "C++ access: receivers preserve binding mutability" {
    let immutable = AccessProbe {};
    var mutable = AccessProbe {};
    check(immutable.access() == 1);
    check(mutable.access() == 2);
}

test "C++ access: Read and Write select distinct reference overloads" {
    var value = 7;
    check(argument_access(value) == 1);
    check(value == 7);
    check(argument_access(&value) == 2);
    check(value == 8);
}

test "C++ results: returned references materialize owned values" {
    var value = 8;
    let snapshot = identity(value);
    value = 9;
    check(snapshot == 8);
    let captured = [snapshot]() -> i32 { return snapshot; };
    check(captured() == 8);
}

test "C++ owners: copies moves and destruction preserve lifetime" {
    check(live() == 0);
    reset_owner_counts();
    if true {
        let owner = Owner { 42 };
        let copy = owner;
        check(live() == 2);
        check(copies() == 1);
        check(moves() == 0);
        check(copy.read() == 42);
        check(consume(&&owner) == 42);
        check(copies() == 1);
        check(moves() >= 1);
    }
    check(live() == 0);
}
