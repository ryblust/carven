import "lifetimes/tail_outcomes.hpp" using tail_outcome_probe::{
    CopyTrivial,
    CopyOnly,
    Self,
    Tracked,
    Guard,
    reset,
    matches,
    matches_value_lifetime,
    move_count,
}

private struct Failure {}

private struct PayloadFailure {
    payload: Tracked
}

private fn copy_result(value: i32) -> CopyTrivial throw Failure => CopyTrivial { value };
private fn forward_copy(value: i32) -> CopyTrivial throw Failure => copy_result(value)?;
private fn self_result() -> Self throw Failure => Self {};
private fn forward_self() -> Self throw Failure => self_result()?;

test "Tail outcomes: native trivial copies do not invoke observable move constructors" {
    reset();
    let captured = 43;
    let closure = [captured]() => copy_result(captured)?;
    try {
        check(forward_copy(41)?.get() == 41);
        check(closure()?.get() == 43);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(move_count() == 0);
}

test "Tail outcomes: success payloads retain their original construction identity" {
    let captured = 1;
    let closure = [captured]() -> Self throw Failure {
        let _ = captured;
        return self_result()?;
    };
    try {
        check(forward_self()?.at_construction_address() as bool);
        check(closure()?.at_construction_address() as bool);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    let original = Self {};
    let copied = original;
    let taken = &&original;
    check(!(copied.at_construction_address() as bool));
    check(!(taken.at_construction_address() as bool));
}

private fn tracked_result(value: i32) -> Tracked throw Failure => Tracked { value };

private fn forward_tracked(value: i32) -> Tracked throw Failure {
    let local = Guard { 1 };
    return tracked_result(value)?;
}

test "Tail outcomes: success transfer preserves source and function-local cleanup" {
    reset();
    try {
        check(forward_tracked(41)?.get() == 41);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches_value_lifetime("G1 c41 g1 r41 d41 "));

    reset();
    let captured = 43;
    let closure = [captured]() -> Tracked throw Failure {
        let local = Guard { 2 };
        return tracked_result(captured)?;
    };
    try {
        check(closure()?.get() == 43);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches_value_lifetime("G2 c43 g2 r43 d43 "));

    reset();
    if true {
        let original = Tracked { 61 };
        let copied = original;
        check(copied.get() == 61);
        let taken = &&original;
        check(taken.get() == 61);
    }
    check(matches("c61 p61 r61 m61 r61 d61 d61 s-61 "));
}

private fn borrowed_result(guard: Guard, value: i32) -> Tracked throw Failure {
    return Tracked { value };
}

private fn forward_borrowed() -> Tracked throw Failure {
    let local = Guard { 1 };
    return borrowed_result(Guard { 2 }, 47)?;
}

test "Tail outcomes: borrowed argument temporaries outlive result transfer" {
    reset();
    try {
        check(forward_borrowed()?.get() == 47);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches_value_lifetime("G1 G2 c47 g2 g1 r47 d47 "));
}

private fn rejected_result(guard: Guard, value: i32) -> i32 throw PayloadFailure {
    throw PayloadFailure { payload: Tracked { value } };
}

private fn forward_rejected() -> i32 throw PayloadFailure {
    let local = Guard { 1 };
    return rejected_result(Guard { 2 }, 53)?;
}

test "Tail outcomes: Read catch borrowing preserves failure transfer and argument cleanup" {
    reset();
    try {
        let _ = forward_rejected()?;
        fail("expected payload failure");
    } catch {
        PayloadFailure(error) => check(error.payload.get() == 53),
    }
    // The Read catch binding observes the delivered failure without copying it.
    check(matches_value_lifetime("G1 G2 c53 g2 g1 r53 d53 "));
}

private fn take_copy(&&value: CopyTrivial) -> i32 => value.get();
private fn read_copy(value: CopyTrivial) -> i32 => value.get();

private struct OtherFailure {}

private fn rethrow_payload() -> i32 throw PayloadFailure {
    return try {
        rejected_result(Guard { 3 }, 59)?
    } catch {
        PayloadFailure(error) if error.payload.get() == 0 => 0,
        PayloadFailure(_) => rethrow,
    };
}

test "Failure slots: Read guards and rethrow preserve the original payload" {
    reset();
    let value = try {
        rethrow_payload()?
    } catch {
        PayloadFailure(error) => error.payload.get(),
    };
    check(value == 59);
    check(matches_value_lifetime("G3 c59 g3 r59 r59 d59 "));
}

test "Callable delivery: values and widened results preserve trivial copying" {
    reset();
    let take_view: fn(&&CopyTrivial) -> i32 = take_copy;
    let read_view: fn(CopyTrivial) -> i32 = read_copy;
    let result_view: fn(i32) -> CopyTrivial throw Failure + OtherFailure = copy_result;
    let owner = CopyTrivial { 42 };
    check(read_view(owner) == 42);
    check(take_view(&&owner) == 42);
    try {
        check(result_view(43)?.get() == 43);
    } catch {
        Failure(_) => fail("unexpected failure"),
        OtherFailure(_) => fail("unexpected failure"),
    }
    check(move_count() == 0);
}

private fn take_copy_only(&&value: CopyOnly) -> i32 => value.get();
private fn copy_only_result() -> CopyOnly throw Failure => CopyOnly { 47 };

test "Callable delivery: deleted native move does not exclude ordinary transfer" {
    let take_view: fn(&&CopyOnly) -> i32 = take_copy_only;
    let result_view: fn() -> CopyOnly throw Failure + OtherFailure = copy_only_result;
    let owner = CopyOnly { 46 };
    check(take_view(&&owner) == 46);
    try {
        check(result_view()?.get() == 47);
    } catch {
        Failure(_) => fail("unexpected failure"),
        OtherFailure(_) => fail("unexpected failure"),
    }
}
