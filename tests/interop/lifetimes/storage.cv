import "lifetimes/lifetimes.hpp" using lifetime_probe::{
    FixedOwner,
    ResultMaker,
    event,
    mark,
    reset,
    matches,
};

import "lifetimes/storage.hpp" using storage_probe::Observer;

import .control using Failure;
import .construction using crossed_step;

private fn choose(flag: bool) -> bool {
    return ResultMaker { 1 }.make(2).probe(if flag { 3 } else { 4 }, event(5)) as bool;
}

private fn reference_choice(flag: bool) -> bool {
    return ::lifetime_probe::receiver_reference().probe(if flag { 3 } else { 4 }) as bool;
}

private fn const_reference_choice(flag: bool) -> bool {
    return ::lifetime_probe::receiver_const_reference().probe(if flag { 3 } else { 4 }) as bool;
}

test "Storage scopes: native prvalues and references retain category through scalar choices" {
    reset();
    check(choose(true));
    check(matches("1 2 5 9 -2 -1 "));
    reset();
    check(reference_choice(true));
    check(matches("1 9 "));
    reset();
    check(const_reference_choice(true));
    check(matches("1 9 "));
}

private fn combine(first: bool, second: bool, last: FixedOwner) -> bool {
    mark(8);
    return first && second && (last.id as i32) == 4;
}

private fn mixed(selected: bool, succeeds: bool) -> bool throw Failure {
    return combine(
        ResultMaker { 1 }.make(2).probe(0, 0) as bool,
        selected && (FixedOwner { 3 }.probe(crossed_step(5, succeeds)?, 0) as bool),
        FixedOwner { 4 }
    );
}

test "Storage scopes: mixed ordinary and conditional owners unwind in construction order" {
    reset();
    try {
        check(mixed(true, true)?);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches("1 2 9 3 5 9 4 8 -4 -3 -2 -1 "));
    reset();
    try {
        check(!mixed(false, false)?);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches("1 2 9 4 8 -4 -2 -1 "));
    reset();
    try {
        let _ = mixed(true, false)?;
    } catch {
        Failure(_) => mark(7),
    }
    check(matches("1 2 9 3 5 -3 -2 -1 7 "));
}

private fn stop() -> i32 throw Failure {
    mark(5);
    throw Failure::Stop;
}

private fn fails_after_receiver() throw Failure {
    let _ = ResultMaker { 1 }.make(2).probe(stop()?, event(6));
}

test "Storage scopes: an always failing operand cleans preceding immovable receivers" {
    reset();
    try {
        fails_after_receiver()?;
    } catch {
        Failure(_) => mark(7),
    }
    check(matches("1 2 5 -2 -1 7 "));
}

private fn exits_after_receiver(mode: i32) -> i32 throw Failure {
    let _ = ResultMaker { 1 }.make(2).probe(
        if mode == 1 { throw Failure::Stop; } else { 3 },
        event(5)
    );
    if mode == 0 { return 7; }
    return 9;
}

private fn continues_after_receiver(skip: bool) {
    for var n = 0; n < 2; n += 1 {
        let _ = ResultMaker { 1 }.make(2).probe(if skip { 3 } else { 4 }, event(5));
        if skip { continue; }
        mark(8);
    }
}

test "Storage scopes: outward transfers clean ordinary receiver storage before successors" {
    reset();
    try {
        check(exits_after_receiver(0)? == 7);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches("1 2 5 9 -2 -1 "));
    reset();
    try {
        let _ = exits_after_receiver(1)?;
    } catch {
        Failure(_) => mark(7),
    }
    check(matches("1 2 -2 -1 7 "));
    reset();
    try {
        check(exits_after_receiver(2)? == 9);
    } catch {
        Failure(_) => fail("unexpected failure"),
    }
    check(matches("1 2 5 9 -2 -1 "));
    reset();
    continues_after_receiver(true);
    check(matches("1 2 5 9 -2 -1 1 2 5 9 -2 -1 "));
    reset();
    continues_after_receiver(false);
    check(matches("1 2 5 9 -2 -1 8 1 2 5 9 -2 -1 8 "));
}

private fn pure(value: i32) -> i32 => value;

private fn observe_pending(selected: bool) -> bool {
    let observer = Observer {};
    return observer.observe(selected && (observer.remember(pure(3), event(5)) as bool)) as bool;
}

test "Storage scopes: native Read scalar backing survives selected evaluation" {
    reset();
    check(observe_pending(true));
    check(matches("5 "));
    reset();
    check(observe_pending(false));
    check(matches(""));
}
