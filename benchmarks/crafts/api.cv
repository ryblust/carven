import std::simd.scan using { one_of, byte_range, count_where, find_where, prefix_where };
import std::utf.validation using validate_utf8;
import std::utf.error using UTF8Error;
import std::json.validation using { validate, validate_bytes };
import std::json.string using decode_string;
import std::json.error using JSONError;

private const zero = one_of([0u8]);
private const whitespace = one_of(" \t\r\n".bytes);
private const digits = byte_range(0x30, 0x39);

export(cpp) fn count_zero(bytes: [u8]) -> usize => count_where(bytes, zero);
export(cpp) fn count_space(bytes: [u8]) -> usize => count_where(bytes, whitespace);
export(cpp) fn count_digits(bytes: [u8]) -> usize => count_where(bytes, digits);

export(cpp) fn find_zero(bytes: [u8]) -> usize {
    return match find_where(bytes, zero) {
        .Missing => bytes.len(),
        .Found(offset) => offset,
    };
}

export(cpp) fn find_space(bytes: [u8]) -> usize {
    return match find_where(bytes, whitespace) {
        .Missing => bytes.len(),
        .Found(offset) => offset,
    };
}

export(cpp) fn find_digits(bytes: [u8]) -> usize {
    return match find_where(bytes, digits) {
        .Missing => bytes.len(),
        .Found(offset) => offset,
    };
}

export(cpp) fn prefix_zero(bytes: [u8]) -> usize => prefix_where(bytes, zero);
export(cpp) fn prefix_space(bytes: [u8]) -> usize => prefix_where(bytes, whitespace);
export(cpp) fn prefix_digits(bytes: [u8]) -> usize => prefix_where(bytes, digits);

// Zero denotes success; a failure returns its byte offset plus one.
export(cpp) fn utf_status(bytes: [u8]) -> usize {
    try {
        validate_utf8(bytes)?;
    } catch {
        UTF8Error(error) => return error.offset + 1,
    }
    return 0;
}

export(cpp) fn json_text_status(text: str) -> usize {
    try {
        validate(text)?;
    } catch {
        JSONError(error) => return error.offset + 1,
    }
    return 0;
}

export(cpp) fn json_bytes_status(bytes: [u8]) -> usize {
    try {
        validate_bytes(bytes)?;
    } catch {
        JSONError(error) => return error.offset + 1,
        UTF8Error(error) => return error.offset + 1,
    }
    return 0;
}

// Decode workloads contain valid, complete JSON string literals.
export(cpp) fn decode(text: str) -> String {
    try {
        return decode_string(text)?;
    } catch {
        JSONError(_) => return String {},
    }
}
