import std::json using { JSONError, validate_bytes }
import std::utf using UTF8Error;

export(cpp) fn validate_document(bytes: [u8]) -> u64 {
    try {
        validate_bytes(bytes)?;
        return (bytes.length() as u64) * 4;
    } catch {
        JSONError(error) => return (error.offset as u64) * 4 + 1,
        UTF8Error(error) => return (error.offset as u64) * 4 + 2,
    }
}
