import std::async using yield_once;
import "measurement.hpp";

import(cpp) fn cv_async_bench_iterations() -> u64 = ::cv_async_bench_iterations;
import(cpp) fn cv_async_bench_seed() -> u64 = ::cv_async_bench_seed;
import(cpp) fn cv_async_bench_begin() = ::cv_async_bench_begin;
import(cpp) fn cv_async_bench_finish(checksum: u64) = ::cv_async_bench_finish;

async fn ready_leaf(value: u64) -> u64 {
    return value + 1;
}

async fn yielding_leaf(value: u64) -> u64 {
    await yield_once();
    return value + 1;
}

private fn static_leaf(value: u64, const deferred: bool) {
    const if deferred {
        return yielding_leaf(value);
    } else {
        return ready_leaf(value);
    }
}

async fn main() {
    let count = cv_async_bench_iterations();
    let initial = cv_async_bench_seed();
    var checksum: u64 = 0;
    cv_async_bench_begin();
    for index in 0..count {
        let value = (initial + index) % 1048576;
        checksum += await static_leaf(value, true);
    }
    cv_async_bench_finish(checksum);
}
