import std::async using yield_once;
import "probe.hpp";

import(cpp) fn cv_async_bench_iterations() -> u64;
import(cpp) fn cv_async_bench_seed() -> u64;
import(cpp) fn cv_async_bench_depth() -> u64;
import(cpp) fn cv_async_bench_begin();
import(cpp) fn cv_async_bench_finish(checksum: u64);
import(cpp) fn cv_async_bench_observe_stack();

async fn leaf(value: u64, deferred: bool) -> u64 {
    cv_async_bench_observe_stack();
    if deferred { await yield_once(); }
    return value + 1;
}

async fn chain(value: u64, remaining: u64) -> u64 {
    cv_async_bench_observe_stack();
    if remaining == 0 { return value; }
    return await chain(value + 1, remaining - 1);
}

async fn main() {
    let count = cv_async_bench_iterations();
    let initial = cv_async_bench_seed();
    let nesting = cv_async_bench_depth();
    var checksum: u64 = 0;
    cv_async_bench_begin();
    for var index: u64 = 0; index < count; ++index {
        let value = (initial + index) % 1048576;
        checksum += await WORKLOAD;
    }
    cv_async_bench_finish(checksum);
}
