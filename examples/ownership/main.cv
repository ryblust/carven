struct Stock {
    units: i32,
}

fn restock(&stock: Stock, units: i32) {
    stock.units += units;
}

fn dispatch(&&stock: Stock) -> i32 => stock.units;

fn main() {
    var stock = Stock { units: 4 };
    restock(&stock, 3);
    let snapshot = stock;
    restock(&stock, 2);
    println("Snapshot:", snapshot.units);
    println("Dispatched:", dispatch(&&stock));
    // Take transfers the owner; stock is unavailable until assigned again.
    stock = Stock { units: 1 };
    println("Replacement stock:", stock.units);
}
