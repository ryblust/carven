import std::json.value using Value;
import std::json.error using { JSONError, ValueError };

try {
    var document = Value::parse(r#"{"message":"你好\u0020JSON","ok":false}"#)?;
    println(document.get("message")?.as_string()?);
    document.set("ok", &&Value::boolean(true))?;
    document.set("attempts", &&Value::integer(3))?;
    println(document.to_json()?);
} catch {
    JSONError(error) => println(f"Invalid JSON at byte {error.offset}"),
    ValueError(_) => println("JSON value operation failed"),
}
