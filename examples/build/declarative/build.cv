import std::build using build;

build(
    {
        shared_sources: ["src/catalog.cv"],
        targets: [
            {
                name: "inventory",
                kind: .Executable,
                sources: ["src/main.cv"],
                ...
            },
            {
                name: "inventory-check",
                kind: .Executable,
                sources: ["src/check.cv"],
                ...
            },
        ],
        ...
    }
)?;
