struct MissingSetting {}

enum InvalidPort {
    BadDigit(usize),
    OutOfRange,
}

fn parse_port(text: str) -> i32 throw MissingSetting + InvalidPort {
    if text.is_empty() { throw MissingSetting {}; }
    var value: i32 = 0;
    var position: usize = 0;
    for byte in text.bytes {
        let digit = match byte {
            48..=57 => (byte as i32) - 48,
            _ => throw InvalidPort::BadDigit(position),
        };
        if value > (65535 - digit) / 10 { throw InvalidPort::OutOfRange; }
        value = value * 10 + digit;
        ++position;
    }
    return match value {
        0 => throw InvalidPort::OutOfRange,
        _ => value,
    };
}

enum ConfigError {
    Missing,
    Invalid(InvalidPort),
}

private fn select_port(primary: str, backup: str) -> i32 {
    return try {
        parse_port(primary)?
    } catch {
        // A failure in this handler propagates outward; it does not retry itself.
        MissingSetting(_) => parse_port(backup)?,
        InvalidPort(_) => rethrow,
    };
}

fn configured_port(primary: str, backup: str) -> i32 throw ConfigError {
    return try {
        select_port(primary, backup)?
    } catch {
        MissingSetting(_) => throw ConfigError::Missing,
        InvalidPort(error) => throw ConfigError::Invalid(error),
    };
}

fn port_or_default(primary: str, backup: str) -> i32 throw ConfigError {
    return try {
        configured_port(primary, backup)?
    } catch {
        ConfigError(.Missing) => 8080,
        ConfigError(.Invalid(_)) => rethrow,
    };
}
