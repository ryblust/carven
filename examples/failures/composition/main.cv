import .orders using quote;
import .catalog using { QuantityError, OutOfStock };
import .delivery using DeliveryError;

fn report(label: str, quantity: i32, available: i32, zone: i32) {
    println(label);
    try {
        let total = quote(quantity, available, zone)?;
        println("Quote in cents:", total);
    } catch {
        QuantityError(.NonPositive(value)) | QuantityError(.TooLarge(value)) => {
            println("Quantity must be between 1 and 100:", value);
        },
        OutOfStock(error) => {
            println("Requested:", error.requested);
            println("Available:", error.available);
        },
        DeliveryError(.UnknownZone(zone)) => {
            println("Unknown zone:", zone);
        },
        DeliveryError(.Unavailable(zone)) => {
            println("No carrier for zone:", zone);
        },
    }
}

fn main() {
    report("Standard delivery", 2, 5, 1);
    report("Alternate carrier", 2, 5, 2);
    report("Stock shortage", 6, 5, 1);
    report("Invalid quantity", 0, 5, 1);
    report("Oversized order", 101, 200, 1);
    report("Unknown destination", 2, 5, 9);
    report("Unavailable destination", 2, 5, 3);
}
