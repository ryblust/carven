import .settings using { ConfigError, port_or_default };

fn report(label: str, primary: str, backup: str) {
    println(label);
    try {
        let port = port_or_default(primary, backup)?;
        println("Port:", port);
    } catch {
        ConfigError(.Missing) => { println("No port configured"); },
        ConfigError(.Invalid(.BadDigit(position))) => {
            println("Bad digit at byte:", position as i32);
        },
        ConfigError(.Invalid(.OutOfRange)) => {
            println("Port must be between 1 and 65535");
        },
    }
}

fn main() {
    report("Primary setting", "443", "9000");
    report("Backup setting", "", "9000");
    report("Built-in default", "", "");
    report("Invalid primary is not hidden", "8x", "9000");
    report("Invalid backup propagates", "", "70000");
    report("Zero is not a port", "0", "9000");
}
