import .analysis using { analyze, to_json }
import std::io using IOError;
import std::json using JSONValueError;

enum AnalyzerError {
    Input(IOError),
    Report(JSONValueError),
    UnknownArgument(String)
}

const input_limit: usize = 16 * 1024 * 1024;
const usage = "Usage: log-analyzer [--stdin] [--help]";

const demo = """
    INFO 12 collector connected
    WARN 37 mixer token=demo clipped=2
    ERROR 42 upstream timed out
    INFO nope malformed
""";

async fn main(args) throw AnalyzerError {
    var from_stdin = false;
    for argument in args {
        if argument == "--help" {
            println(usage);
            return;
        }
        if argument == "--stdin" {
            from_stdin = true;
            continue;
        }
        eprintln(usage);
        throw AnalyzerError::UnknownArgument(argument as String);
    }
    try {
        if from_stdin {
            let bytes = await stdin().read_all(input_limit)?;
            println(to_json(analyze(bytes))?);
        } else {
            println(to_json(analyze(demo.bytes))?);
        }
    } catch {
        IOError(error) => throw AnalyzerError::Input(error),
        JSONValueError(error) => throw AnalyzerError::Report(error),
    }
}
