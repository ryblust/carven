import "parser.hpp";

struct InvalidPort {}

fn port(text: str) -> i32 throw InvalidPort {
    let value = ::parse_port(text) as i32;
    return match value {
        ..0 => throw InvalidPort {},
        _ => value,
    };
}

fn report(text: str) {
    try {
        let value = port(text)?;
        println("Port:", value);
    } catch {
        InvalidPort(_) => println("Invalid port"),
    }
}

report("8080");
report("http");
report("99999999999999999999");
report("80suffix");
