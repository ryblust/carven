import std::collections using HashSet;
import "stream.hpp" using collector::Stream;

private import(cpp) fn next_record(&stream: Stream) -> str = ::next_record;

struct Report {
    records: Vector<String>,
    total: usize,
    duplicates: usize
}

private fn collect_stream(&stream: Stream, &records: HashSet<String>) -> usize {
    var total = 0usize;
    while {
        let record = next_record(&stream);
        if record.is_empty() => break;
        ++total;
        records.insert(&&(record as String));
    }
    return total;
}

export(cpp) fn collect(&first: Stream, &second: Stream) -> Report {
    var records = HashSet<String>::new();
    let first_count = collect_stream(&first, &records);
    let total = first_count + collect_stream(&second, &records);
    return {
        records: Vector<String>::from_slice(records.values()),
        total: total,
        duplicates: total - records.length()
    };
}
