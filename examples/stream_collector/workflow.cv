import "stream.hpp" using collector::Stream;

private import(cpp) fn next_record(&stream: Stream) -> str = ::next_record;

struct Report {
    records: Vector<String>,
    total: usize,
    duplicates: usize
}

private fn contains(records: Vector<String>, candidate: str) -> bool {
    for record in records {
        if record == candidate { return true; }
    }
    return false;
}

private fn collect_stream(&stream: Stream, &report: Report) {
    while {
        let record = next_record(&stream);
        if record.is_empty() { break; }
        ++report.total;
        if contains(report.records, record) {
            ++report.duplicates;
        } else {
            report.records.push(record as String);
        }
    }
}

export(cpp) fn collect(&first: Stream, &second: Stream) -> Report {
    var report: Report = {};
    collect_stream(&first, &report);
    collect_stream(&second, &report);
    return &&report;
}
