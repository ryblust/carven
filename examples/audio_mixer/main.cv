import .mix using { gains, mix, rms, MixError }
import std::core using NumberParseError;
import std::utf using { split_once, TextError }

enum MixerError {
    UnknownArgument(String),
    InvalidGain(NumberParseError),
    InvalidOption(TextError),
    Mixing(MixError)
}

const usage = "Usage: audio-mixer [--logs] [--voice=NUMBER] [--music=NUMBER] [--help]";

const voice: [f32; 10] = [0.5, -0.5, 1.0, -1.0, 0.0, 0.25, -0.25, 0.5, 0.75, -0.75];
const music: [f32; 10] = [0.0, 0.0, 0.5, -0.5, 0.5, 0.5, -0.5, -0.5, 0.0, 0.0];

fn main(args) throw MixerError {
    try {
        var requested = gains;
        var logs = false;
        for argument in args {
            if argument == "--help" {
                println(usage);
                return;
            }
            if argument == "--logs" {
                logs = true;
                continue;
            }
            let option = split_once(argument, "=")?;
            match option.before {
                "--voice" if option.found => {
                    requested.voice = f32::parse(option.after)?;
                },
                "--music" if option.found => {
                    requested.music = f32::parse(option.after)?;
                },
                _ => {
                    eprintln(usage);
                    throw MixerError::UnknownArgument(argument as String);
                },
            }
        }
        let output = mix(voice, music, requested)?;
        if logs {
            println(f"WARN 37 mixer clipped={output.clipped} samples={output.samples.length()}");
            println(f"INFO 12 mixer peak={output.peak:.2f} rms={rms(output):.3f}");
        } else {
            println(f"Mixed {output.samples.length()} samples; clipped: {output.clipped}");
            println(f"Peak: {output.peak:.2f}; RMS: {rms(output):.3f}");
            println(output.samples);
        }
    } catch {
        NumberParseError(error) => {
            eprintln(usage);
            throw MixerError::InvalidGain(error);
        },
        TextError(error) => {
            eprintln(usage);
            throw MixerError::InvalidOption(error);
        },
        MixError(error) => {
            if error == .Gain { eprintln(usage); }
            throw MixerError::Mixing(error);
        },
    }
}
