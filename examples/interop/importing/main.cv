import "parser.hpp";
import "console.hpp" using example::print;

struct InvalidPort {}

fn port(text: str) -> i32 throw InvalidPort {
    let value = ::parse_port(text) as i32;
    if value < 0 { throw InvalidPort {}; }
    return value;
}

fn report(text: str) {
    try {
        let value = port(text)?;
        print("Port:");
        print(value);
    } catch {
        InvalidPort(_) => { print("Invalid port"); },
    }
}

fn main() {
    report("8080");
    report("http");
    report("99999999999999999999");
    report("80suffix");
}
