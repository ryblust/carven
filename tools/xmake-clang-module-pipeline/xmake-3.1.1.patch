+
+-- Build object and BMI jobs in one rule stage so the outer rule graph
+-- does not insert a whole-group barrier between them. Object jobs are added
+-- first because the BMI pass attaches their imported-BMI dependency edges.
+function build_module_pipeline(target, jobgraph, sourcebatch, opt)
+    if target:data("cxx.has_modules") then
+        local modules = scanner.get_modules(target)
+        local built_modules = scanner.sort_modules_by_dependencies(target, modules, {jobgraph = target:policy("build.jobgraph")})
+        _mark_prunable_leaf_modules(target, built_modules, {remove_bmifiles = true})
+    end
+    build_objectfiles(target, jobgraph, sourcebatch, opt)
+    build_bmis(target, jobgraph, sourcebatch, opt)
+end
+
+-- Keep ownership of module interface source batches in this rule. Their object
+-- jobs have already been added by build_module_pipeline in the before stage.
+function skip_module_pipeline_objectfiles()
+end
