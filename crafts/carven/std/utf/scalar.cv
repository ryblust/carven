import <carven/runtime/utf.hpp>;
import <cstdint>;

export struct UnicodeScalarError {
    value: u32,
}

export fn char_from_u32(value: u32) -> char throw UnicodeScalarError {
    if value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) {
        throw UnicodeScalarError { value: value };
    }
    return (value as ::carven::runtime::UnicodeScalarRepresentation) as char;
}

export fn char_to_u32(value: char) -> u32 => (value as ::std::uint32_t) as u32;
