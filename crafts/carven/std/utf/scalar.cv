export struct UnicodeScalarError {
    value: u32,
}

export fn char_from_u32(value: u32) -> char throw UnicodeScalarError {
    return match value {
        0xd800..=0xdfff | 0x110000.. => throw UnicodeScalarError { value: value },
        _ => char::from_u32_unchecked(value),
    };
}

export fn char_to_u32(value: char) -> u32 => value as u32;
