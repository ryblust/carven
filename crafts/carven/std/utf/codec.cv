import .error using UTF8Error;
import .scan using { UTF8State, push_utf8, check_utf8_complete };

export struct UTF8Encoded {
    bytes: [u8; 4],
    width: usize,
}

export enum UTF8DecodeResult {
    End,
    Scalar(char, usize),
}

export const fn decode_utf8_prefix(bytes: [u8]) -> UTF8DecodeResult throw UTF8Error {
    var state = UTF8State {};
    var scalar: u32 = 0;
    for byte in bytes {
        push_utf8(&state, byte)?;
        if state.offset == 1 {
            scalar = match byte {
                ..0x80 => byte as u32,
                0x80..0xe0 => (byte & 31) as u32,
                0xe0..0xf0 => (byte & 15) as u32,
                0xf0.. => (byte & 7) as u32,
            };
        } else {
            scalar = (scalar << 6) | ((byte & 63) as u32);
        }
        if state.remaining == 0 { return .Scalar(char::from_u32_unchecked(scalar), state.offset); }
    }
    check_utf8_complete(state)?;
    return .End;
}

private const fn continuation(value: u32, shift: u32) -> u8 {
    let payload = (value >> shift) & 63;
    return (0x80 | payload) as u8;
}

export const fn encode_utf8(character: char) -> UTF8Encoded {
    let value = character as u32;
    return match value {
        ..=0x7f => {
            bytes: [value as u8, 0, 0, 0],
            width: 1,
        },
        0x80..=0x7ff => {
            bytes: [(0xc0 | (value >> 6)) as u8, continuation(value, 0), 0, 0],
            width: 2,
        },
        0x800..=0xffff => {
            bytes: [
                (0xe0 | (value >> 12)) as u8,
                continuation(value, 6),
                continuation(value, 0),
                0
            ],
            width: 3,
        },
        0x10000.. => {
            bytes: [
                (0xf0 | (value >> 18)) as u8,
                continuation(value, 12),
                continuation(value, 6),
                continuation(value, 0),
            ],
            width: 4,
        },
    };
}

// Bind the encoding result before retaining this view; it borrows that result.
export const fn encoded_bytes(encoded: UTF8Encoded) -> [u8] {
    assert(encoded.width >= 1 && encoded.width <= 4);
    return encoded.bytes.as_slice().slice(0, encoded.width);
}
