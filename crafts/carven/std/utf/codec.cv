import .validation using {UTF8Error, validator, push, error};

export struct UTF8Encoded {
    bytes: [u8; 4],
    width: usize,
}

export enum UTF8Decode {
    End,
    Scalar(char, usize),
}

export fn decode_utf8(bytes: [u8]) -> UTF8Decode throw UTF8Error {
    if bytes.is_empty() { return .End; }
    var state = validator();
    var scalar: u32 = 0;
    for byte in bytes {
        push(&state, byte)?;
        if state.offset == 1 {
            scalar = match byte {
                ..0x80 => byte as u32,
                0x80..0xe0 => (byte & 31) as u32,
                0xe0..0xf0 => (byte & 15) as u32,
                0xf0.. => (byte & 7) as u32,
            };
        } else {
            scalar = (scalar << 6) | ((byte & 63) as u32);
        }
        if state.remaining == 0 { return .Scalar(char::from_u32_unchecked(scalar), state.offset); }
    }
    throw error(state, .Truncated);
}

private fn continuation(value: u32, shift: u32) -> u8 {
    let payload = (value >> shift) & 63;
    return (0x80 | payload) as u8;
}

export fn encode_utf8(character: char) -> UTF8Encoded {
    let value = character as u32;
    return match value {
        ..=0x7f => UTF8Encoded {
            bytes: [value as u8, 0, 0, 0],
            width: 1,
        },
        0x80..=0x7ff => UTF8Encoded {
            bytes: [(0xc0 | (value >> 6)) as u8, continuation(value, 0), 0, 0],
            width: 2,
        },
        0x800..=0xffff => UTF8Encoded {
            bytes: [
                (0xe0 | (value >> 12)) as u8,
                continuation(value, 6),
                continuation(value, 0),
                0
            ],
            width: 3,
        },
        0x10000.. => UTF8Encoded {
            bytes: [
                (0xf0 | (value >> 18)) as u8,
                continuation(value, 12),
                continuation(value, 6),
                continuation(value, 0),
            ],
            width: 4,
        },
    };
}
