import .validation using {UTF8Error, validate_utf8};
import <carven/runtime/utf.hpp>;

export fn from_utf8(bytes: [u8]) -> str throw UTF8Error {
    validate_utf8(bytes)?;
    return ::carven::runtime::utf8_text(bytes) as str;
}

export fn to_string(bytes: [u8]) -> String throw UTF8Error {
    return String::from_str(from_utf8(bytes)?);
}
