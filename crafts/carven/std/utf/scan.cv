import std::simd.bytes using ascii_prefix;
import .block using invalid_utf8_block;
import .error using { UTF8Error, UTF8ErrorKind };

// Craft-internal state. Zero initialization starts an empty stream.
// Block commits and byte transitions agree; rejected bytes leave every field unchanged.
struct UTF8State {
    remaining: u8,
    lead: u8,
    offset: usize,
    sequence_start: usize,
}

private const fn scan_error(state: UTF8State, kind: UTF8ErrorKind) -> UTF8Error {
    return {
        kind: kind,
        offset: state.offset,
        sequence_start: state.sequence_start
    };
}

const fn push_utf8(&state: UTF8State, byte: u8) throw UTF8Error {
    var next = state;
    if next.remaining == 0 {
        next.sequence_start = next.offset;
        match byte {
            0x00..=0x7f => {
                next.lead = 0;
            },
            0xc2..=0xdf => {
                next.remaining = 1;
                next.lead = 0;
            },
            0xe0..=0xef => {
                next.remaining = 2;
                next.lead = byte;
            },
            0xf0..=0xf4 => {
                next.remaining = 3;
                next.lead = byte;
            },
            _ => throw scan_error(next, .InvalidLead),
        }
    } else {
        match byte {
            ..0x80 | 0xc0.. => throw scan_error(next, .InvalidContinuation),
            ..0xa0 if next.lead == 0xe0 => throw scan_error(next, .Overlong),
            0xa0.. if next.lead == 0xed => throw scan_error(next, .Surrogate),
            ..0x90 if next.lead == 0xf0 => throw scan_error(next, .Overlong),
            0x90.. if next.lead == 0xf4 => throw scan_error(next, .TooLarge),
            _ => {},
        }
        next.lead = 0;
        next.remaining -= 1;
    }
    next.offset += 1;
    if next.remaining == 0 { next.sequence_start = next.offset; }
    state = next;
}

// Commit a prefix already checked by the vector algorithm. Only its last three
// bytes can belong to an unfinished scalar; all earlier bytes are complete.
private const fn commit_utf8_blocks(&state: UTF8State, bytes: [u8], start: usize, end: usize) {
    if end == start { return; }
    state.offset += end - start;
    state.sequence_start = state.offset;
    state.remaining = 0;
    state.lead = 0;
    let last = bytes[end - 1];
    if last < 0x80 { return; }
    let second = bytes[end - 2];
    let third = bytes[end - 3];
    if last >= 0xc2 {
        state.sequence_start -= 1;
        if last < 0xe0 {
            state.remaining = 1;
        } else {
            state.lead = last;
            if last < 0xf0 { state.remaining = 2; } else { state.remaining = 3; }
        }
    } else if second >= 0xe0 {
        state.sequence_start -= 2;
        if second < 0xf0 { state.remaining = 1; } else { state.remaining = 2; }
    } else if third >= 0xf0 {
        state.sequence_start -= 3;
        state.remaining = 1;
    }
}

const fn feed_utf8(&state: UTF8State, bytes: [u8]) throw UTF8Error {
    var index: usize = 0;
    // A previous feed may end inside a scalar. Its existing state is sufficient;
    // no access to the previous caller's input storage is needed.
    while index < bytes.len() && state.remaining != 0 {
        push_utf8(&state, bytes[index])?;
        index += 1;
    }
    let start = index;
    var previous = u8x32::splat(0);
    while bytes.len() - index >= 32 {
        let current = u8x32::load(bytes, index);
        if ((previous | current) >= 0x80).any() {
            if invalid_utf8_block(previous, current).any() { break; }
        }
        previous = current;
        index += 32;
    }
    commit_utf8_blocks(&state, bytes, start, index);
    // Short tails and failed blocks use the authoritative byte transition,
    // preserving exact error positions and recoverable streaming state.
    while index < bytes.len() {
        if state.remaining == 0 && bytes[index] < 0x80 {
            let count = ascii_prefix(bytes.slice(index, bytes.len()));
            state.offset += count;
            state.sequence_start = state.offset;
            state.lead = 0;
            index += count;
        } else {
            push_utf8(&state, bytes[index])?;
            index += 1;
        }
    }
}

const fn check_utf8_complete(state: UTF8State) throw UTF8Error {
    if state.remaining != 0 { throw scan_error(state, .Truncated); }
}
