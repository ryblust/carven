// Explicit 32-byte logical operations; no runtime dispatch.
export struct ByteBlock {
    value: u8x32,
    active: mask32,
    offset: usize,
    length: usize,
}

export const fn block_count(bytes: [u8]) -> usize {
    let full = bytes.length() / 32;
    if bytes.length() % 32 == 0 { return full; }
    return full + 1;
}

// offset may equal length: the returned block is empty and has no active lanes.
export const fn load_block(bytes: [u8], offset: usize) -> ByteBlock {
    let value = u8x32::load_partial(bytes, offset, 0);
    var count = bytes.length() - offset;
    if count > 32 { count = 32; }
    return {
        value: value,
        active: mask32::prefix(count),
        offset: offset,
        length: count
    };
}

export const fn count_byte(bytes: [u8], needle: u8) -> usize {
    var count: usize = 0;
    for index in 0..block_count(bytes) {
        let block = load_block(bytes, index * 32);
        count += ((block.value == needle) & block.active).count();
    }
    return count;
}

export const fn find_byte(bytes: [u8], needle: u8) -> usize {
    for index in 0..block_count(bytes) {
        let block = load_block(bytes, index * 32);
        let matched = (block.value == needle) & block.active;
        if matched.any() { return block.offset + matched.first_or(32); }
    }
    return bytes.length();
}

export const fn ascii_digit(bytes: u8x32) -> mask32 => (bytes >= 0x30) & (bytes <= 0x39);

export const fn ascii_lower(bytes: u8x32) -> u8x32 => ((bytes >= 0x41) & (bytes <= 0x5a)).select(
    bytes + 0x20,
    bytes
);

// Return the length of the leading ASCII run. Short tails use ordinary scalar reads.
export const fn ascii_prefix(bytes: [u8]) -> usize {
    var offset: usize = 0;
    while bytes.length() - offset >= 64 {
        let first = u8x32::load(bytes, offset);
        let second = u8x32::load(bytes, offset + 32);
        if ((first | second) >= 0x80).any() {
            let first_non_ascii = first >= 0x80;
            if first_non_ascii.any() { return offset + first_non_ascii.first_or(32); }
            return offset + 32 + (second >= 0x80).first_or(32);
        }
        offset += 64;
    }
    while bytes.length() - offset >= 32 {
        let non_ascii = u8x32::load(bytes, offset) >= 0x80;
        if non_ascii.any() { return offset + non_ascii.first_or(32); }
        offset += 32;
    }
    while offset < bytes.length() {
        if bytes[offset] >= 0x80 { return offset; }
        offset += 1;
    }
    return offset;
}
