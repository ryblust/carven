// Bit n denotes byte n; matching plans are derived from this set at compilation.
export struct ByteSet {
    words: [u64; 4],
}

export const fn one_of(values: [u8]) -> ByteSet {
    var set = ByteSet {};
    for byte in values {
        set.words[(byte >> 6) as usize] |= 1u64 << ((byte & 63) as u64);
    }
    return set;
}

export const fn byte_range(lower: u8, upper: u8) -> ByteSet {
    assert(lower <= upper);
    var set = ByteSet {};
    for value in (lower as u16)..=(upper as u16) {
        let byte = value as u8;
        set.words[(byte >> 6) as usize] |= 1u64 << ((byte & 63) as u64);
    }
    return set;
}

export const fn set_union(left: ByteSet, right: ByteSet) -> ByteSet {
    var result = ByteSet {};
    for index in 0usize..4 {
        result.words[index] = left.words[index] | right.words[index];
    }
    return result;
}

private const fn complement(set: ByteSet) -> ByteSet {
    var result = ByteSet {};
    for index in 0usize..4 {
        result.words[index] = ~set.words[index];
    }
    return result;
}

private const fn contains(set: ByteSet, byte: u8) -> bool {
    return (set.words[(byte >> 6) as usize] & (1u64 << ((byte & 63) as u64))) != 0;
}

private struct ByteRun {
    lower: u8,
    upper: u8,
}

private struct BytePlan {
    runs: [ByteRun; 4],
    // Five denotes more than four runs.
    count: usize,
    inverted: bool,
}

private const fn plan_runs(set: ByteSet, inverted: bool) -> BytePlan {
    var plan = BytePlan {
        runs: {},
        count: 0,
        inverted: inverted
    };
    var inside = false;
    var value: u16 = 0;
    for word in set.words {
        var bits = word;
        for _ in 0u8..64 {
            let byte = value as u8;
            if ((bits & 1u64) != 0) != inverted {
                if inside == false {
                    plan.count += 1;
                    if plan.count == 5 => return plan;
                    plan.runs[plan.count - 1].lower = byte;
                    inside = true;
                }
            } else if inside {
                plan.runs[plan.count - 1].upper = byte - 1;
                inside = false;
            }
            bits >>= 1;
            value += 1;
        }
    }
    if inside => plan.runs[plan.count - 1].upper = 255;
    return plan;
}

private const fn comparison_plan(set: ByteSet) -> BytePlan {
    // Runs alternate; the complement has fewer only when both endpoints are members.
    return plan_runs(set, contains(set, 0) && contains(set, 255));
}

private const fn is_empty(set: ByteSet) -> bool {
    return set.words == [0u64; 4];
}

private const fn is_complete(set: ByteSet) -> bool {
    return set.words
        == [0xffffffffffffffffu64, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff];
}

private struct GroupedTables {
    low: u8x16,
    high: u8x16,
    groups: usize,
}

private const fn grouped_tables(set: ByteSet) -> GroupedTables {
    var rows: [u16; 8] = {};
    var low: [u8; 16] = {};
    var high: [u8; 16] = {};
    var groups: usize = 0;

    for upper in 0usize..16 {
        let row = ((set.words[upper >> 2] >> (((upper & 3) * 16) as u64)) & 0xffffu64) as u16;
        if row == 0 => continue;
        var group: usize = 0;
        while group < groups && rows[group] != row {
            group += 1;
        }
        if group == groups {
            // A byte flag can distinguish at most eight nonempty rows.
            if groups == 8 {
                return GroupedTables {
                    low: u8x16::splat(0),
                    high: u8x16::splat(0),
                    groups: 9,
                };
            }
            rows[group] = row;
            groups += 1;
            for lower in 0usize..16 {
                if (row & (1u16 << (lower as u16))) != 0 => low[lower] |= 1u8 << (group as u8);
            }
        }
        high[upper] = 1u8 << (group as u8);
    }

    return GroupedTables {
        low: u8x16::from_array(low),
        high: u8x16::from_array(high),
        groups: groups,
    };
}

private const fn nibble_table(set: ByteSet, high: bool) -> u8x16 {
    var table: [u8; 16] = {};
    for value in 0u16..256 {
        let byte = value as u8;
        if (byte >= 128) == high && contains(set, byte) {
            table[(byte & 15) as usize] |= 1u8 << ((byte >> 4) & 7);
        }
    }
    return u8x16::from_array(table);
}

private const fn bit_table() -> u8x16 {
    var bytes: [u8; 16] = {};
    for index in 0usize..16 {
        bytes[index] = 1u8 << ((index as u8) & 7);
    }
    return u8x16::from_array(bytes);
}

private const powers = bit_table();

export const fn match_set(value: u8x32, const set: ByteSet) -> mask32 {
    const plan = comparison_plan(set);
    const if plan.count == 0 {
        const if plan.inverted => return mask32::prefix(32);
        else => return mask32::prefix(0);
    } else if plan.count <= 4 {
        var matched = mask32::prefix(0);
        const for index in 0..plan.count {
            const lower = plan.runs[index].lower;
            const upper = plan.runs[index].upper;
            const if lower == upper {
                matched |= value == lower;
            } else {
                // Wrapping subtraction maps this inclusive run to 0..(upper - lower).
                matched |= (value - lower) <= (upper - lower);
            }
        }
        const if plan.inverted => return ~matched;
        else => return matched;
    } else {
        const grouped = grouped_tables(set);
        let high_nibbles = value.shift_right(4);
        let low_nibbles = value & 15;
        const if grouped.groups <= 8 {
            return (grouped.low.lookup(low_nibbles) & grouped.high.lookup(high_nibbles)) != 0;
        } else {
            const low = nibble_table(set, false);
            const high = nibble_table(set, true);
            let flags = (high_nibbles < 8).select(
                low.lookup(low_nibbles),
                high.lookup(low_nibbles)
            );
            return (flags & powers.lookup(high_nibbles)) != 0;
        }
    }
}

private const fn contains_byte(byte: u8, const set: ByteSet) -> bool {
    const plan = comparison_plan(set);
    const if plan.count == 0 {
        return plan.inverted;
    } else if plan.count <= 4 {
        const for index in 0..plan.count {
            const lower = plan.runs[index].lower;
            const upper = plan.runs[index].upper;
            const if lower == upper {
                if byte == lower => return plan.inverted == false;
            } else {
                if (byte - lower) <= (upper - lower) => return plan.inverted == false;
            }
        }
        return plan.inverted;
    } else {
        return (set.words[(byte >> 6) as usize] & (1u64 << ((byte & 63) as u64))) != 0;
    }
}

export const fn count_where(bytes: [u8], const set: ByteSet) -> usize {
    const if is_empty(set) => return 0;
    const if is_complete(set) => return bytes.length();

    const chains = 2usize;
    const group_bytes = chains * 32;
    var offset: usize = 0;
    var count: usize = 0;
    let ones = u8x32::splat(1);
    let zero = u8x32::splat(0);

    while bytes.length() - offset >= group_bytes * 4 {
        var groups = (bytes.length() - offset) / group_bytes;
        // Each lane receives at most 255 increments before widening the sum.
        if groups > 255 => groups = 255;
        let batch_end = offset + groups * group_bytes;
        let batch = bytes.slice(offset, batch_end);
        var accumulators = [u8x32::splat(0); chains];
        for group in 0usize..groups {
            const for chain in 0usize..chains {
                let value = u8x32::load(batch, group * group_bytes + chain * 32);
                accumulators[chain] += match_set(value, set).select(ones, zero);
            }
        }
        offset = batch_end;
        const for chain in 0usize..chains {
            count += accumulators[chain].sum();
        }
    }

    while bytes.length() - offset >= 32 {
        count += match_set(u8x32::load(bytes, offset), set).count();
        offset += 32;
    }

    while offset < bytes.length() {
        if contains_byte(bytes[offset], set) => count += 1;
        offset += 1;
    }

    return count;
}

export const fn find_where(bytes: [u8], const set: ByteSet) -> usize {
    return find_from(bytes, 0, set);
}

// Positions refer to the supplied input; its length denotes no match.
export const fn find_from(bytes: [u8], start: usize, const set: ByteSet) -> usize {
    assert(start <= bytes.length());
    const if is_empty(set) => return bytes.length();
    const if is_complete(set) => return start;
    var offset = start;

    while bytes.length() - offset >= 32 {
        let matched = match_set(u8x32::load(bytes, offset), set);
        if matched.any() => return offset + matched.first_or(0);
        offset += 32;
    }

    while offset < bytes.length() {
        if contains_byte(bytes[offset], set) => return offset;
        offset += 1;
    }

    return bytes.length();
}

export const fn prefix_where(bytes: [u8], const set: ByteSet) -> usize {
    return prefix_end(bytes, 0, set);
}

export const fn prefix_end(bytes: [u8], start: usize, const set: ByteSet) -> usize =>
    find_from(bytes, start, complement(set));
