import .string using read_string;
import .syntax using { error, spaces }
import std::simd.scan using { one_of, byte_range, set_union, prefix_end }
import std::toml using TOMLError;

private const bare_key = set_union(
    set_union(byte_range(0x30, 0x39), byte_range(0x41, 0x5a)),
    set_union(byte_range(0x61, 0x7a), one_of([0x2d, 0x5f]))
);

const fn key_path(bytes: [u8], &offset: usize) -> Vector<String> throw TOMLError {
    var path: Vector<String> = [];
    while {
        spaces(bytes, &offset);
        if offset == bytes.length() { throw error(.UnexpectedEnd, offset); }
        var key = String {};
        if bytes[offset] == 0x22 || bytes[offset] == 0x27 {
            key = read_string(bytes, &offset, false)?;
        } else {
            let start = offset;
            offset = prefix_end(bytes, offset, bare_key);
            if start == offset { throw error(.InvalidKey, offset); }
            key.append(str::from_utf8_unchecked(bytes.slice(start, offset)));
        }
        path.push(&&key);
        if path.length() > 64 { throw error(.DepthLimit, offset); }
        spaces(bytes, &offset);
        if offset == bytes.length() || bytes[offset] != 0x2e { return &&path; }
        offset += 1;
    }
}

