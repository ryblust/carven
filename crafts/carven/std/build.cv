import .build.artifacts using {
    native_identity,
    compile_objects,
    required_implementations,
    index_implementations,
    index_providers,
    record_providers,
    append_paths,
    object_path,
    ImplementationIndex,
}

import .build.platform using {
    files,
    run,
    canonical,
    process_error,
    fingerprint,
    directory,
    remove,
    resolve,
}

import .build.cli using run_plan;
import std::collections using { HashMap, HashSet }
import std::compiler using { compile, CompiledImplementation, CompilerError }
import std::fs using { parent, join }

import std::process using {
    ProcessError,
    OperatingSystem,
    environment,
    find_executable,
    operating_system,
}

import std::utf using ends_with;

export struct BuildError {
    message: String,
}

export enum TargetKind {
    Executable,
    StaticLibrary,
}

export enum LinkLibrary {
    Name(String),
    File(String),
}

export struct NativeOptions {
    include_dirs: Vector<String>,
    defines: Vector<String>,
    compile_flags: Vector<String>,
    library_dirs: Vector<String>,
    link_flags: Vector<String>,
    libraries: Vector<LinkLibrary>,
}

export struct BuildTarget {
    name: String,
    kind: TargetKind,
    sources: Vector<String>,
    native_sources: Vector<String>,
    native: NativeOptions,
    dependencies: Vector<String>,
    output: String,
}

export struct BuildOutput {
    name: String,
    path: String,
    kind: TargetKind,
}

export struct BuildPlan {
    shared_sources: Vector<String>,
    targets: Vector<BuildTarget>,
    output_directory: String,
}

export const fn build(plan: BuildPlan) -> Vector<BuildOutput> throw BuildError {
    return run_plan(plan)?;
}

private const fn validate_name(value: str) throw BuildError {
    if value.is_empty() { throw BuildError { message: "target name is empty" }; }
    for byte in value.bytes {
        if !(byte >= 0x61 && byte <= 0x7a)
            && !(byte >= 0x41 && byte <= 0x5a)
            && !(byte >= 0x30 && byte <= 0x39)
            && byte != 0x2d
            && byte != 0x5f {
            throw BuildError {
                message: "target name must contain only letters, digits, '-' or '_'"
            };
        }
    }
}

// Output names must remain distinct on case-insensitive filesystems as well.
private const fn same_name(left: str, right: str) -> bool {
    if left.byte_length() != right.byte_length() { return false; }
    for index in 0..left.byte_length() {
        let a = left.bytes[index];
        let b = right.bytes[index];
        let folded_a = if a >= 0x41 && a <= 0x5a { a + 0x20 } else { a };
        let folded_b = if b >= 0x41 && b <= 0x5a { b + 0x20 } else { b };
        if folded_a != folded_b { return false; }
    }
    return true;
}

private const fn target_index(targets: [BuildTarget], name: str) -> usize throw BuildError {
    for index in 0..targets.length() {
        if targets[index].name == name { return index; }
    }
    throw BuildError { message: f"unknown build dependency '{name}'" };
}

// Declaration order resolves independent targets; dependencies precede their consumers.
private const fn target_order(targets: [BuildTarget]) -> Vector<usize> throw BuildError {
    var completed: Vector<bool> = [];
    for index in 0..targets.length() {
        validate_name(targets[index].name)?;
        for previous in 0..index {
            if same_name(targets[index].name, targets[previous].name) {
                throw BuildError { message: f"duplicate build target '{targets[index].name}'" };
            }
        }
        for dependency in targets[index].dependencies {
            let selected = target_index(targets, dependency)?;
            if targets[selected].kind != .StaticLibrary {
                throw BuildError { message: f"dependency '{dependency}' is not a static library" };
            }
        }
        completed.push(false);
    }
    var order: Vector<usize> = [];
    while order.length() < targets.length() {
        let before = order.length();
        for index in 0..targets.length() {
            if completed[index] { continue; }
            var ready = true;
            for dependency in targets[index].dependencies {
                if !completed[target_index(targets, dependency)?] { ready = false; }
            }
            if ready {
                completed[index] = true;
                order.push(index);
            }
        }
        if order.length() == before {
            throw BuildError { message: "build target dependencies contain a cycle" };
        }
    }
    return &&order;
}

private const fn native_tool(variable: str, fallback: str) -> String throw BuildError {
    let configured = try {
        environment(variable)?
    } catch {
        ProcessError(error) => throw process_error(f"cannot read {variable}", error),
    };
    let selected = if configured.is_empty() { fallback } else { configured.as_str() };
    return try {
        find_executable(selected)?
    } catch {
        ProcessError(error) => throw process_error(f"cannot find tool '{selected}'", error),
    };
}

private struct TargetSources {
    roots: HashSet<String>,
    objects: Vector<String>,
    implementations: HashSet<String>,
    dependencies: Vector<usize>,
}

private struct CompileGroup {
    key: String,
    arguments: Vector<String>,
    implementations: Vector<CompiledImplementation>,
    index: ImplementationIndex,
    completed: HashSet<String>,
    search_roots: HashSet<String>,
    identity: String,
}

private const fn inside(path: str, root: str) -> bool {
    var current = path as String;
    while !current.is_empty() {
        if current == root { return true; }
        let next = parent(current);
        if next == current { break; }
        current = next;
    }
    return false;
}

private const fn search_identity(
    roots: [String],
    excluded: str,
    artifacts: HashSet<String>,
    &inventories: HashMap<String, String>
) -> String throw BuildError {
    var values: Vector<String> = [];
    for root in roots {
        let found = inventories.find(root);
        if found != nullptr {
            values.append([root, *found]);
            continue;
        }
        // Explicit inputs below the work root remain inputs. Ancestor
        // searches exclude compiler and build products from their inventory.
        let excluded_root = if inside(root, excluded) { "" } else { excluded };
        let entries = files(
            {
                root: root,
                recursive: true,
                excluded_root: excluded_root
            }
        )?;
        var paths: Vector<String> = [];
        for path in entries {
            if !artifacts.contains(path) { paths.push(path); }
        }
        let identity = fingerprint([], paths);
        values.append([root, identity]);
        let key = root;
        inventories.insert(&&key, &&identity);
    }
    return fingerprint([], values);
}

private const fn provided_by_dependency(
    source: String,
    target: usize,
    selected: [TargetSources]
) -> bool {
    for dependency in selected[target].dependencies {
        if selected[dependency].implementations.contains(source) { return true; }
    }
    return false;
}

private const fn output_path(target: BuildTarget, root: str, windows: bool) -> String {
    if !target.output.is_empty() { return join(root, target.output); }
    let name = target.name;
    return match target.kind {
        .Executable => if windows { f"{root}/{name}.exe" } else { f"{root}/{name}" },
        .StaticLibrary => if windows { f"{root}/{name}.lib" } else { f"{root}/lib{name}.a" },
    };
}

const fn build_outputs(plan: BuildPlan) -> Vector<BuildOutput> throw BuildError {
    if plan.targets.is_empty() {
        throw BuildError { message: "a build needs at least one target" };
    }
    let targets = plan.targets;
    let order = target_order(targets)?;
    let output_root = if plan.output_directory.is_empty() {
        "build"
    } else {
        plan.output_directory.as_str()
    };
    let work_root = join(output_root, ".carven");
    let generated = join(work_root, "application/generated");
    let windows = operating_system() == OperatingSystem::Windows;
    var outputs: Vector<BuildOutput> = [];
    var artifact_index = HashSet<String>::with_capacity(targets.length());
    for target in targets {
        let path = output_path(target, output_root, windows);
        let identity = resolve(path)?;
        for previous in artifact_index.values() {
            if same_name(identity, previous) {
                throw BuildError { message: f"duplicate build output '{path}'" };
            }
        }
        let artifact = identity;
        artifact_index.insert(&&artifact);
        outputs.push(
            {
                name: target.name,
                path: path,
                kind: target.kind
            }
        );
    }
    let cxx = native_tool("CXX", "clang++")?;
    var common_sources = HashSet<String>::new();
    var common_native = HashSet<String>::new();
    directory(work_root)?;
    let work_identity = canonical(work_root)?;
    let project_root = canonical(".")?;
    let project_entries = files(
        {
            root: "crafts",
            recursive: true,
            excluded_root: work_identity
        }
    )?;
    var project_files: Vector<String> = [];
    var project_names: Vector<String> = [];
    for path in project_entries {
        let identity = resolve(path)?;
        if !artifact_index.contains(identity) {
            project_files.push(path);
            project_names.push(identity);
        }
    }
    let project_crafts = if project_entries.is_empty() {
        join(project_root, "crafts")
    } else {
        canonical("crafts")?
    };
    for path in project_files {
        if ends_with(path, ".cv") { append_paths(&common_sources, [canonical(path)?]); }
        if ends_with(path, ".cpp") { append_paths(&common_native, [canonical(path)?]); }
    }
    for source in plan.shared_sources {
        append_paths(&common_sources, [canonical(source)?]);
    }
    var all_sources = common_sources;
    var selected: Vector<TargetSources> = [];
    for target in targets {
        var roots = common_sources;
        for source in target.sources {
            let path = canonical(source)?;
            append_paths(&roots, [path]);
            append_paths(&all_sources, [path]);
        }
        var native_sources = common_native;
        for source in target.native_sources {
            append_paths(&native_sources, [canonical(source)?]);
        }
        if roots.is_empty() && native_sources.is_empty() && target.dependencies.is_empty() {
            throw BuildError { message: f"target '{target.name}' needs at least one source" };
        }
        append_paths(&roots, native_sources.values());
        selected.push(
            {
                roots: &&roots,
                objects: [],
                implementations: HashSet<String>::new(),
                dependencies: []
            }
        );
    }
    let compilation = try {
        compile(all_sources.values(), generated)?
    } catch {
        CompilerError(error) => throw BuildError { message: error.message },
    };
    let identity = native_identity(cxx, output_root)?;
    var implementations = compilation.implementations;
    var native_roots = HashSet<String>::new();
    for target in selected {
        for source in target.roots.values() {
            if !ends_with(source, ".cv") { append_paths(&native_roots, [source]); }
        }
    }
    for source in native_roots.values() {
        implementations.push(
            {
                file: source,
                source: source,
                dependencies: []
            }
        );
    }
    var groups: Vector<CompileGroup> = [];
    var target_groups: Vector<usize> = [];
    for index in 0..targets.length() {
        let options = targets[index].native;
        var search_roots = HashSet<String>::new();
        append_paths(&search_roots, [project_root, project_crafts]);
        append_paths(&search_roots, compilation.include_dirs);
        for source in selected[index].roots.values() {
            if !ends_with(source, ".cv") { append_paths(&search_roots, [parent(source)]); }
        }
        var arguments: Vector<String> = [cxx, "-std=c++20", f"-I{generated}"];
        for path in compilation.include_dirs {
            arguments.push(f"-I{path}");
        }
        arguments.append(["-Icrafts", "-I."]);
        for path in options.include_dirs {
            let directory = canonical(path)?;
            arguments.push(f"-I{directory}");
            append_paths(&search_roots, [directory]);
        }
        for definition in options.defines {
            arguments.push(f"-D{definition}");
        }
        arguments.append(options.compile_flags);
        let key = fingerprint([], arguments);
        var group = groups.length();
        for row in 0..groups.length() {
            if groups[row].key == key { group = row; }
        }
        if group == groups.length() {
            groups.push(
                {
                    key: key,
                    arguments: &&arguments,
                    implementations: implementations,
                    index: index_implementations(implementations),
                    completed: HashSet<String>::new(),
                    search_roots: HashSet<String>::new(),
                    identity: "",
                }
            );
        }
        append_paths(&groups[group].search_roots, search_roots.values());
        target_groups.push(group);
    }
    var inventories = HashMap<String, String>::with_capacity(groups.length());
    let crafts_key = project_crafts;
    let crafts_identity = fingerprint([], project_names);
    inventories.insert(&&crafts_key, &&crafts_identity);
    for group in 0..groups.length() {
        let inputs = search_identity(
            groups[group].search_roots.values(),
            work_identity,
            artifact_index,
            &inventories
        )?;
        groups[group].identity = fingerprint([], [identity, inputs]);
    }
    var object_count = 0usize;
    var compiled_count = 0usize;
    let provider_index = index_providers(compilation.native_providers);
    for target in order {
        var reachable: Vector<bool> = [];
        for _ in targets {
            reachable.push(false);
        }
        for name in targets[target].dependencies {
            let dependency = target_index(targets, name)?;
            reachable[dependency] = true;
            for inherited in selected[dependency].dependencies {
                reachable[inherited] = true;
            }
        }
        for dependency in order {
            if reachable[dependency] { selected[target].dependencies.push(dependency); }
        }
        let group = target_groups[target];
        let object_root = f"{output_root}/.carven/objects/{groups[group].key}";
        let required = required_implementations(
            selected[target].roots.values(),
            groups[group].implementations,
            groups[group].index
        )?;
        var pending_sources: Vector<String> = [];
        for source in required {
            if !provided_by_dependency(source, target, selected) { pending_sources.push(source); }
        }
        while !pending_sources.is_empty() {
            var sources: Vector<String> = [];
            for source in pending_sources {
                if provided_by_dependency(source, target, selected) { continue; }
                if !groups[group].completed.contains(source) { sources.push(source); }
            }
            if sources.is_empty() { break; }
            let pending = compile_objects(
                groups[group].arguments,
                sources,
                object_root,
                groups[group].identity,
                compilation.cacheable
            )?;
            object_count += pending.files.length();
            compiled_count += pending.compiled;
            for object in pending.files {
                let source = object.source;
                groups[group].completed.insert(&&source);
            }
            pending_sources = record_providers(
                pending.files,
                compilation.native_providers,
                provider_index,
                &groups[group].implementations,
                &groups[group].index
            );
        }
        let final_required = required_implementations(
            selected[target].roots.values(),
            groups[group].implementations,
            groups[group].index
        )?;
        for source in final_required {
            if !provided_by_dependency(source, target, selected) {
                let owned = source;
                selected[target].implementations.insert(&&owned);
                selected[target].objects.push(object_path(object_root, source));
            }
        }
    }
    println(f"Required {object_count} objects; compiled {compiled_count}");
    for index in order {
        let target = targets[index];
        let path = outputs[index].path;
        let directory_path = parent(path);
        if !directory_path.is_empty() { directory(directory_path)?; }
        var reachable: Vector<bool> = [];
        for _ in targets {
            reachable.push(false);
        }
        reachable[index] = true;
        for dependency in selected[index].dependencies {
            reachable[dependency] = true;
        }
        match target.kind {
            .StaticLibrary => {
                let archiver = native_tool("AR", "ar")?;
                remove(path)?;
                var archive: Vector<String> = [archiver, "rcs", path];
                archive.append(selected[index].objects);
                run(archive)?;
            },
            .Executable => {
                var link: Vector<String> = [cxx];
                link.append(selected[index].objects);
                // Reverse topological order places every archive before its own dependencies.
                var position = order.length();
                while position > 0 {
                    position -= 1;
                    let dependency = order[position];
                    if reachable[dependency] && dependency != index {
                        link.push(outputs[dependency].path);
                    }
                }
                position = order.length();
                while position > 0 {
                    position -= 1;
                    let dependency = order[position];
                    if !reachable[dependency] { continue; }
                    for library_directory in targets[dependency].native.library_dirs {
                        link.push(f"-L{canonical(library_directory)?}");
                    }
                    for library in targets[dependency].native.libraries {
                        match library {
                            .Name(name) => link.push(f"-l{name}"),
                            .File(file) => link.push(canonical(file)?),
                        }
                    }
                    link.append(targets[dependency].native.link_flags);
                }
                if windows { link.push("-lws2_32"); }
                link.append(["-o", path]);
                run(link)?;
            },
        }
        println(f"Built {path}");
    }
    return &&outputs;
}
