import .build.cli using run_project;
import .build.execute using execute_plan;
import .build.plan using resolve_plan;
import std::compiler using SystemLibraries;

export struct BuildError {
    message: String,
}

export enum TargetKind {
    Executable,
    StaticLibrary,
    SourceLibrary,
}

export enum LinkLibrary {
    Name(String),
    File(String),
}

export struct NativeOptions {
    include_dirs: Vector<String>,
    defines: Vector<String>,
    compile_flags: Vector<String>,
    library_dirs: Vector<String>,
    link_flags: Vector<String>,
    libraries: Vector<LinkLibrary>,
    syslinks: Vector<SystemLibraries>,
}

export struct BuildTarget {
    name: String,
    kind: TargetKind,
    sources: Vector<String>,
    headers: Vector<String>,
    native: NativeOptions,
    dependencies: Vector<String>,
    output: String,
}

export struct BuildOutput {
    name: String,
    path: String,
    kind: TargetKind,
}

export struct BuildPlan {
    shared_sources: Vector<String>,
    targets: Vector<BuildTarget>,
    output_directory: String,
}

// An explicit build action has no command-line run or query behavior.
export const fn build(plan: BuildPlan) -> Vector<BuildOutput> throw BuildError =>
    execute_plan(resolve_plan(plan)?, false)?;

// One project entry dispatches the same declarations for query, build, run, or test.
export const fn project(plan: BuildPlan) throw BuildError => run_project(plan)?;
