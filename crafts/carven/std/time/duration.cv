export struct Duration {
    nanoseconds: i64,
}

export struct RangeError {}

private const minimum_nanoseconds = -9223372036854775808i64;
private const maximum_nanoseconds = 9223372036854775807i64;

private const fn scaled(value: i64, factor: i64) -> Duration throw RangeError {
    if value < minimum_nanoseconds / factor || value > maximum_nanoseconds / factor {
        throw RangeError {};
    }
    return { nanoseconds: value * factor };
}

export const fn nanoseconds(value: i64) -> Duration => { nanoseconds: value };

export const fn microseconds(value: i64) -> Duration throw RangeError => scaled(value, 1000)?;

export const fn milliseconds(value: i64) -> Duration throw RangeError => scaled(value, 1000000)?;

export const fn seconds(value: i64) -> Duration throw RangeError => scaled(value, 1000000000)?;

// Craft-local arithmetic keeps every invalid intermediate out of the expression.
const fn checked_add_nanoseconds(base: i64, offset: i64) -> i64 throw RangeError {
    if offset > 0 && base > maximum_nanoseconds - offset { throw RangeError {}; }
    if offset < 0 && base < minimum_nanoseconds - offset { throw RangeError {}; }
    return base + offset;
}
