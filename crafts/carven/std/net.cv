import std::async using Operation;
import std::io using ReadResult;
import <carven/std/net/native.hpp> using carven::standard::net;

export struct NetConnectionView {
    native: net::View
}

export(cpp) const fn borrow(native: net::View) -> NetConnectionView => { native: native };

export enum NetError {
    System(i32),
    Closed,
    Conflict,
    NoProgress
}

private const fn validate(kind: u8, code: i32) throw NetError {
    match kind {
        0 => {},
        1 => throw NetError::System(code),
        2 => throw NetError::Closed,
        3 => throw NetError::Conflict,
        4 => throw NetError::NoProgress,
        _ => assert(false),
    }
}

export const async fn read(
    connection: NetConnectionView,
    max_bytes: usize
) -> ReadResult<Vector<u8>> throw NetError {
    assert(max_bytes > 0);
    let pending: Operation<net::ReadResult> = net::read(connection.native, max_bytes);
    var result = await pending;
    validate(result.error as u8, result.code as i32)?;
    if result.end as bool => return .End;
    return .Data((&result).take_bytes() as Vector<u8>);
}

export const async fn write(
    connection: NetConnectionView,
    &&bytes: Vector<u8>
) -> usize throw NetError {
    if bytes.is_empty() => return 0;
    let pending: Operation<net::WriteResult> = net::write(connection.native, &&bytes, 0usize);
    let result = await pending;
    validate(result.error as u8, result.code as i32)?;
    return result.count as usize;
}

export const async fn write_all(connection: NetConnectionView, &&bytes: Vector<u8>) throw NetError {
    if bytes.is_empty() => return;
    let pending: Operation<net::WriteResult> = net::write_all(connection.native, &&bytes);
    let result = await pending;
    validate(result.error as u8, result.code as i32)?;
}
