import std::json using { JSONValue, JSONValueError }
import std::simd.scan using { one_of, byte_range, set_union, find_from }

private const escaped_bytes = set_union(byte_range(0, 0x1f), one_of([0x22, 0x5c]));

private const fn append_quoted(text: str, &output: String) {
    output.push('"');
    let bytes = text.bytes;
    var offset: usize = 0;
    while offset < bytes.length() {
        let stop = find_from(bytes, offset, escaped_bytes);
        // ASCII escape boundaries cannot split a scalar in valid UTF-8.
        output.append(str::from_utf8_unchecked(bytes.slice(offset, stop)));
        if stop == bytes.length() => break;
        let byte = bytes[stop];
        match byte {
            0x22 => output.append("\\\""),
            0x5c => output.append("\\\\"),
            0x08 => output.append("\\b"),
            0x0c => output.append("\\f"),
            0x0a => output.append("\\n"),
            0x0d => output.append("\\r"),
            0x09 => output.append("\\t"),
            _ => {
                output.append("\\u00");
                let hex = "0123456789abcdef".bytes;
                output.push(char::from_u32_unchecked(hex[(byte >> 4) as usize] as u32));
                output.push(char::from_u32_unchecked(hex[(byte & 0xf) as usize] as u32));
            },
        }
        offset = stop + 1;
    }
    output.push('"');
}

private const fn append_value(
    value: JSONValue,
    &output: String,
    depth: usize
) -> void throw JSONValueError {
    match value.kind() {
        .Null => output.append("null"),
        .Boolean => output.append(if value.as_bool()? { "true" } else { "false" }),
        .Number => output.append(value.number_text()?),
        .String => append_quoted(value.as_str()?, &output),
        .Array => {
            if depth == 64 => throw JSONValueError::DepthLimit;
            output.push('[');
            var first = true;
            for item in value.elements()? {
                if first => first = false;
                else => output.push(',');
                append_value(item, &output, depth + 1)?;
            }
            output.push(']');
        },
        .Object => {
            if depth == 64 => throw JSONValueError::DepthLimit;
            output.push('{');
            var first = true;
            for (key, child) in value.members()? {
                if first => first = false;
                else => output.push(',');
                append_quoted(key, &output);
                output.push(':');
                append_value(child, &output, depth + 1)?;
            }
            output.push('}');
        },
    }
}

const fn serialize_value(value: JSONValue) -> String throw JSONValueError {
    var output = String {};
    append_value(value, &output, 0)?;
    return output;
}
