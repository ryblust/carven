import .node using Node;
import .error using ValueError;
import std::simd.scan using { one_of, byte_range, set_union, find_from };

private const escaped_bytes = set_union(byte_range(0, 0x1f), one_of([0x22, 0x5c]));

private fn append_quoted(text: str, &output: String) {
    output.push('"');
    let bytes = text.bytes;
    var offset: usize = 0;
    while offset < bytes.len() {
        var stop = bytes.len();
        match find_from(bytes, offset, escaped_bytes) {
            .Missing => {},
            .Found(position) => { stop = position; },
        }
        // ASCII escape boundaries cannot split a scalar in valid UTF-8.
        output.append(str::from_utf8_unchecked(bytes.slice(offset, stop)));
        if stop == bytes.len() { break; }
        let byte = bytes[stop];
        match byte {
            0x22 => output.append("\\\""),
            0x5c => output.append("\\\\"),
            0x08 => output.append("\\b"),
            0x0c => output.append("\\f"),
            0x0a => output.append("\\n"),
            0x0d => output.append("\\r"),
            0x09 => output.append("\\t"),
            _ => {
                output.append("\\u00");
                let hex = "0123456789abcdef".bytes;
                output.push(char::from_u32_unchecked(hex[(byte >> 4) as usize] as u32));
                output.push(char::from_u32_unchecked(hex[(byte & 0xf) as usize] as u32));
            },
        }
        offset = stop + 1;
    }
    output.push('"');
}

private fn append_value(value: Node, &output: String, depth: usize) -> void throw ValueError {
    match value {
        .Null => output.append("null"),
        .Boolean(boolean) => output.append(if boolean { "true" } else { "false" }),
        .Number(ref text) => output.append(text.as_str()),
        .Text(ref text) => append_quoted(text.as_str(), &output),
        .Array(ref items) => {
            if depth == 64 { throw ValueError::DepthLimit; }
            output.push('[');
            var first = true;
            for item in items {
                if first { first = false; } else { output.push(','); }
                append_value(item, &output, depth + 1)?;
            }
            output.push(']');
        },
        .Object(ref members) => {
            if depth == 64 { throw ValueError::DepthLimit; }
            output.push('{');
            var first = true;
            for member in members {
                if first { first = false; } else { output.push(','); }
                append_quoted(member.key.as_str(), &output);
                output.push(':');
                append_value(member.value, &output, depth + 1)?;
            }
            output.push('}');
        },
    }
}

fn serialize_node(value: Node) -> String throw ValueError {
    var output = String {};
    append_value(value, &output, 0)?;
    return &&output;
}
