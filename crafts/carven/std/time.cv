import std::async using { Operation, cancel_point };

export struct Duration {
    nanoseconds: i64
}

export struct RangeError {}

export struct Timeout {}

private const minimum_nanoseconds = -9223372036854775808i64;
private const maximum_nanoseconds = 9223372036854775807i64;

private const fn scaled(value: i64, factor: i64) -> Duration throw RangeError {
    if value < minimum_nanoseconds / factor || value > maximum_nanoseconds / factor {
        throw RangeError {};
    }
    return { nanoseconds: value * factor };
}

export const fn nanoseconds(value: i64) -> Duration => { nanoseconds: value };
export const fn microseconds(value: i64) -> Duration throw RangeError => scaled(value, 1000)?;
export const fn milliseconds(value: i64) -> Duration throw RangeError => scaled(value, 1000000)?;
export const fn seconds(value: i64) -> Duration throw RangeError => scaled(value, 1000000000)?;

private const fn checked_add_nanoseconds(base: i64, offset: i64) -> i64 throw RangeError {
    if offset > 0 && base > maximum_nanoseconds - offset { throw RangeError {}; }
    if offset < 0 && base < minimum_nanoseconds - offset { throw RangeError {}; }
    return base + offset;
}

export class TimePoint {
    nanoseconds_since_epoch: i64,

    const fn now() -> TimePoint => { nanoseconds_since_epoch: monotonic_now() };

    const fn after(duration: Duration) -> TimePoint throw RangeError => {
        nanoseconds_since_epoch: checked_add_nanoseconds(monotonic_now(), duration.nanoseconds)?
    };

    const fn shifted(self, duration: Duration) -> TimePoint throw RangeError => {
        nanoseconds_since_epoch: checked_add_nanoseconds(
            self.nanoseconds_since_epoch,
            duration.nanoseconds
        )?
    };

    const fn is_before(self, other: TimePoint) -> bool => self.nanoseconds_since_epoch
        < other.nanoseconds_since_epoch;

    const fn has_passed(self) -> bool => self.nanoseconds_since_epoch <= monotonic_now();

    const fn wait(self) -> Operation<void> => wait_until(self.nanoseconds_since_epoch);
}

export const async fn sleep(duration: Duration) throw RangeError {
    await cancel_point();
    if duration.nanoseconds <= 0 { return; }
    let deadline = TimePoint::after(duration)?;
    await deadline.wait();
}

export const async fn sleep_until(point: TimePoint) {
    await point.wait();
}
