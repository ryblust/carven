+-- Track input and output contents in dependency records.
+import("core.project.depend")
+
+function enabled(target)
+    return target:policy("build.c++.modules.two_phases")
+        and target:has_tool("cxx", "clang", "clangxx")
+end
+
+function fingerprint(file, refresh)
+    file = path.absolute(file)
+    _g.fingerprints = _g.fingerprints or {}
+    local result = not refresh and _g.fingerprints[file]
+    if not result then
+        result = os.isfile(file) and hash.xxhash128(file) or "missing"
+        _g.fingerprints[file] = result
+    end
+    return result
+end
+
+function normalize(files)
+    local result = {}
+    for _, file in ipairs(files) do
+        table.insert(result, path.absolute(file))
+    end
+    result = table.unique(result)
+    table.sort(result)
+    return result
+end
+
+function set_inputs(target, sourcefile, files)
+    local inputs = target:data("cxx.modules.inputs") or {}
+    inputs[sourcefile] = normalize(files)
+    target:data_set("cxx.modules.inputs", inputs)
+end
+
+function inputs(target, sourcefile)
+    local inputs = target:data("cxx.modules.inputs")
+    return inputs and inputs[sourcefile]
+end
+
+function values(files, values)
+    local parts = {}
+    for _, file in ipairs(files) do
+        table.insert(parts, file)
+        table.insert(parts, fingerprint(file))
+    end
+    local input_hash = #parts > 0 and hash.strhash128(table.concat(parts, "\0")) or "none"
+    return table.join({"content_depend.v3", input_hash, fingerprint(values[1])}, values)
+end
+
+function output_changed(info, output)
+    return not os.isfile(output) or info.outputhash ~= fingerprint(output)
+end
+
+-- Input paths and contents are already encoded in values. Compare those values
+-- with the native dependency API without rechecking file modification times.
+function is_changed(info, opt)
+    return opt.changed or output_changed(info, opt.output)
+        or depend.is_changed({values = info.values}, {values = opt.values})
+end
+
+function run(callback, opt)
+    local info = depend.load(opt.dependfile) or {}
+    opt.files = normalize(opt.files)
+    opt.values = values(opt.files, opt.values)
+    if not opt.dryrun and not is_changed(info, opt) then
+        return false
+    end
+    opt.changed = true
+    -- Save dependency records only after the callback succeeds.
+    local built = false
+    depend.on_changed(function ()
+        callback()
+        built = true
+        return {outputhash = fingerprint(opt.output, true)}
+    end, opt)
+    return built
+end
