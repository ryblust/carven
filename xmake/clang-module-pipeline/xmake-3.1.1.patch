+                local key = assert(line:match("^(carven_scan_%d+):"), "unexpected dependency target")
+                assert(not dependencies[key], "duplicate dependency target " .. key)
+                dependencies[key] = parse_deps(line, {target = target})
+            end
+            local pending, seen = {}, {}
+            for _, rule in ipairs(data.rules) do
+                local key = path.absolute(rule["primary-output"])
+                local item = assert(items[key], "scanner returned unexpected output " .. key)
+                assert(not seen[key], "scanner returned duplicate output " .. key)
+                seen[key] = true
+                local files = table.unique(table.join({item.sourcefile},
+                    assert(dependencies[item.depkey], "missing dependencies for " .. item.sourcefile)))
+                table.sort(files)
+                table.insert(pending, {path = target:dependfile(item.sourcefile),
+                    data = {moduleinfo = json.encode({version = data.version, revision = data.revision, rules = {rule}}, {pure = true, orderkeys = true}), files = files}})
+            end
+            assert(#pending == #sourcefiles, "scanner did not return every translation unit")
+            -- Publish only after the entire batch parsed successfully.
+            for _, record in ipairs(pending) do
+                io.save(record.path, record.data, {only_changed = true, orderkeys = true})
+            end
+        end,
+        finally {function(ok, errors)
+            for _, file in ipairs(temporaries) do os.tryrm(file) end
+            if not ok then raise(errors) end
+        end}
+    }
+end
