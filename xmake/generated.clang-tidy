# Review findings against Carven semantics and C++ boundary contracts before
# changing the generator. Preserve evaluation order, ownership, lifetimes, and
# overload selection; handwritten C++ recommendations may not apply here.
# Fix actionable findings in the generator, not its output. Narrowly exclude
# checks that conflict with those contracts rather than distort valid lowering.
InheritParentConfig: true
Checks:
  # Value/reference passing preserves source access and snapshot semantics.
  - '-performance-unnecessary-value-param'
  # The escape heuristic also diagnoses valid, length-delimited byte literals.
  - '-bugprone-string-literal-with-embedded-nul'
CheckOptions:
  # Parameter and borrow cv-qualification preserves access and native overloads.
  misc-const-correctness.AnalyzeParameters: false
  misc-const-correctness.AnalyzeReferences: false
  misc-const-correctness.AnalyzePointers: false
