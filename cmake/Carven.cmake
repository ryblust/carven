include_guard(GLOBAL)

function(_carven_array output document)
    string(JSON length LENGTH "${document}" ${ARGN})
    set(values)
    if(length GREATER 0)
        math(EXPR last "${length} - 1")
        foreach(index RANGE ${last})
            string(JSON value GET "${document}" ${ARGN} ${index})
            list(APPEND values "${value}")
        endforeach()
    endif()
    set(${output} "${values}" PARENT_SCOPE)
endfunction()

# CMake tracks file freshness; Carven's manifest supplies the dependency closure.
# Analysis and generation share the same staging/publication path. Query execution
# is deliberately outside it because it can read inputs beyond source files.
function(_carven_stage_inputs output inventory manifest destination analysis)
    set(inputs "${Carven_EXECUTABLE}")
    set(candidates)
    if(analysis)
        string(JSON workspace GET "${manifest}" workspace root)
        _carven_array(declarations "${manifest}" inputs)
        foreach(input IN LISTS declarations)
            string(JSON path GET "${input}" path)
            get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${workspace}")
            list(APPEND inputs "${path}")
        endforeach()
        _carven_array(roots "${manifest}" library_roots)
        foreach(root IN LISTS roots)
            file(GLOB_RECURSE names CONFIGURE_DEPENDS LIST_DIRECTORIES false "${root}/*.cv")
            list(APPEND candidates "${root}" ${names})
        endforeach()
    endif()
    _carven_array(artifacts "${manifest}" artifacts)
    foreach(artifact IN LISTS artifacts)
        string(JSON path GET "${artifact}" path)
        list(APPEND inputs "${destination}/${path}")
    endforeach()
    set(${output} "${inputs}" PARENT_SCOPE)
    set(${inventory} "${candidates}" PARENT_SCOPE)
endfunction()

function(_carven_stage output destination command directory)
    set(manifest_path "${destination}/carven/manifest.json")
    set(stamp "${destination}.stamp")
    set(request "${destination}.request")
    set(analysis FALSE)
    set(options)
    set(inputs "${Carven_EXECUTABLE}")
    if(command STREQUAL "check")
        set(analysis TRUE)
        list(APPEND inputs ${ARGN})
    else()
        list(APPEND options --no-query)
        foreach(checked IN LISTS ARGN)
            list(APPEND inputs "${checked}/carven/semantic" "${checked}/carven/manifest.json")
        endforeach()
    endif()
    set(dependencies ${inputs})
    set(current FALSE)
    set(candidates)
    if(EXISTS "${manifest_path}")
        file(READ "${manifest_path}" manifest)
        _carven_stage_inputs(facts candidates "${manifest}" "${destination}" "${analysis}")
        list(APPEND inputs ${facts})
        set(current TRUE)
        if(analysis)
            string(JSON current GET "${manifest}" cacheable)
        endif()
    endif()
    set(invocation "${Carven_EXECUTABLE}\n${command}\n${directory}\n${ARGN}\n")
    set(request_content "${invocation}${candidates}\n")
    file(CONFIGURE OUTPUT "${request}" CONTENT "@request_content@" @ONLY)
    list(APPEND inputs "${request}")
    foreach(input IN LISTS inputs)
        if(NOT EXISTS "${input}" OR "${input}" IS_NEWER_THAN "${stamp}")
            set(current FALSE)
        endif()
    endforeach()

    if(NOT current)
        set(staging "${destination}.staging")
        file(REMOVE_RECURSE "${staging}")
        execute_process(
            COMMAND "${Carven_EXECUTABLE}" "${command}" ${ARGN} ${options} -o "${staging}"
            WORKING_DIRECTORY "${directory}"
            COMMAND_ERROR_IS_FATAL ANY
        )
        set(previous)
        if(EXISTS "${manifest_path}")
            _carven_array(old_artifacts "${manifest}" artifacts)
            foreach(artifact IN LISTS old_artifacts)
                string(JSON path GET "${artifact}" path)
                list(APPEND previous "${path}")
            endforeach()
        endif()
        file(READ "${staging}/carven/manifest.json" manifest)
        _carven_array(artifacts "${manifest}" artifacts)
        foreach(artifact IN LISTS artifacts)
            string(JSON path GET "${artifact}" path)
            get_filename_component(parent "${destination}/${path}" DIRECTORY)
            file(MAKE_DIRECTORY "${parent}")
            file(COPY_FILE "${staging}/${path}" "${destination}/${path}" ONLY_IF_DIFFERENT)
            list(REMOVE_ITEM previous "${path}")
        endforeach()
        foreach(path IN LISTS previous)
            file(REMOVE "${destination}/${path}")
        endforeach()
        file(MAKE_DIRECTORY "${destination}/carven")
        file(COPY_FILE "${staging}/carven/manifest.json" "${manifest_path}" ONLY_IF_DIFFERENT)
        file(REMOVE_RECURSE "${staging}")
        _carven_stage_inputs(facts candidates "${manifest}" "${destination}" "${analysis}")
        set(request_content "${invocation}${candidates}\n")
        file(CONFIGURE OUTPUT "${request}" CONTENT "@request_content@" @ONLY)
        file(TOUCH "${stamp}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        ${dependencies} ${facts} "${request}" "${manifest_path}")
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

function(_carven_queries output manifest directory)
    _carven_array(roots "${manifest}" craft_roots)
    set(queries "[]")
    set(index 0)
    foreach(root IN LISTS roots)
        # Track creation/removal of the entry as well as its loaded source closure.
        file(GLOB entry CONFIGURE_DEPENDS "${root}/build.cv")
        if(NOT entry)
            continue()
        endif()
        string(SHA256 identity "${Carven_EXECUTABLE}\n${root}")
        set(checked "${directory}/queries/${identity}")
        _carven_stage(checked_manifest "${checked}" check "${root}" "${entry}")
        execute_process(
            COMMAND "${Carven_EXECUTABLE}" query "${checked}"
            WORKING_DIRECTORY "${root}"
            OUTPUT_VARIABLE query
            COMMAND_ERROR_IS_FATAL ANY
        )
        string(JSON queries SET "${queries}" ${index} "${query}")
        math(EXPR index "${index} + 1")
    endforeach()
    string(JSON manifest SET "${manifest}" crafts "${queries}")
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

# These helpers read the current invocation's manifest, never a generated glob.
function(_carven_artifact_source output logical)
    foreach(artifact IN LISTS artifacts)
        string(JSON path GET "${artifact}" path)
        if(path STREQUAL logical)
            string(JSON source GET "${artifact}" source)
            get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${workspace}")
            set(${output} "${source}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Missing Carven implementation dependency: ${logical}")
endfunction()

function(_carven_implementation output dependencies source)
    if(NOT source MATCHES "\\.cv$")
        set(${output} "${source}" PARENT_SCOPE)
        set(${dependencies} "" PARENT_SCOPE)
        return()
    endif()
    foreach(artifact IN LISTS artifacts)
        string(JSON role GET "${artifact}" role)
        if(NOT role STREQUAL "module-implementation")
            continue()
        endif()
        string(JSON owner GET "${artifact}" source)
        get_filename_component(owner "${owner}" ABSOLUTE BASE_DIR "${workspace}")
        if(owner STREQUAL source)
            string(JSON path GET "${artifact}" path)
            _carven_array(links "${artifact}" link_dependencies)
            set(${output} "${generated}/${path}" PARENT_SCOPE)
            set(${dependencies} "${links}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR
        "Selected Carven source has no generated implementation: ${source}. "
        "Import it or include it in carven_target_sources().")
endfunction()

function(carven_target_sources target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "carven_target_sources requires an existing target: ${target}")
    endif()
    if(NOT ARGN)
        message(FATAL_ERROR "carven_target_sources requires Carven entry sources")
    endif()
    get_property(registered TARGET "${target}" PROPERTY _CARVEN_SOURCES SET)
    if(registered)
        message(FATAL_ERROR "Call carven_target_sources once with all entries for ${target}")
    endif()
    set(roots)
    foreach(source IN LISTS ARGN)
        file(REAL_PATH "${source}" absolute BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND roots "${absolute}")
    endforeach()
    list(REMOVE_DUPLICATES roots)
    set_property(TARGET "${target}" PROPERTY _CARVEN_SOURCES "${roots}")

    set(directory "${CMAKE_CURRENT_BINARY_DIR}/carven/${target}")
    set(generated "${directory}/generated")
    set(checked "${directory}/checked")
    _carven_stage(checked_manifest "${checked}" check "${PROJECT_SOURCE_DIR}" ${roots})
    _carven_stage(manifest "${generated}" compile "${PROJECT_SOURCE_DIR}" "${checked}")
    _carven_queries(manifest "${manifest}" "${CMAKE_BINARY_DIR}/carven")
    set(manifest_content "${manifest}\n")
    file(CONFIGURE OUTPUT "${generated}/carven/manifest.json" CONTENT "@manifest_content@" @ONLY)
    string(JSON workspace GET "${manifest}" workspace root)
    _carven_array(inputs "${manifest}" inputs)
    _carven_array(artifacts "${manifest}" artifacts)
    _carven_array(include_dirs "${manifest}" include_dirs)
    _carven_array(crafts "${manifest}" crafts)

    set(pending_sources)
    foreach(input IN LISTS inputs)
        string(JSON path GET "${input}" path)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${workspace}")
        string(JSON owned GET "${input}" owned)
        if(owned)
            list(APPEND pending_sources "${path}")
        endif()
    endforeach()

    set(providers)
    foreach(query IN LISTS crafts)
        string(JSON craft GET "${query}" project)
        string(JSON root GET "${craft}" root)
        _carven_array(targets "${craft}" targets)
        foreach(provider IN LISTS targets)
            string(JSON kind GET "${provider}" kind)
            if(kind STREQUAL "source-library")
                list(LENGTH providers index)
                list(APPEND providers "${provider}")
                set(provider_root_${index} "${root}")
            endif()
        endforeach()
    endforeach()

    string(TOLOWER "${CMAKE_SYSTEM_NAME}" platform)
    if(platform STREQUAL "darwin")
        set(platform macos)
    endif()
    set(pending_targets)
    set(selected_targets)
    set(selected_sources)
    set(scoped_sources)
    set(selected)
    set(libraries)
    while(TRUE)
        list(LENGTH pending_sources source_count)
        list(LENGTH pending_targets target_count)
        if(source_count EQUAL 0 AND target_count EQUAL 0)
            break()
        endif()
        # An explicit dependency establishes ownership before following source links.
        if(target_count GREATER 0)
            list(POP_FRONT pending_targets index)
            if(index IN_LIST selected_targets)
                continue()
            endif()
            list(APPEND selected_targets "${index}")
            list(GET providers ${index} provider)
            _carven_array(sources "${provider}" sources)
            list(APPEND scoped_sources ${sources})
            list(APPEND pending_sources ${sources})
            _carven_array(dependencies "${provider}" dependencies)
            foreach(dependency IN LISTS dependencies)
                set(found FALSE)
                set(candidate 0)
                foreach(value IN LISTS providers)
                    string(JSON name GET "${value}" name)
                    if(name STREQUAL dependency
                        AND provider_root_${candidate} STREQUAL provider_root_${index})
                        list(APPEND pending_targets "${candidate}")
                        set(found TRUE)
                    endif()
                    math(EXPR candidate "${candidate} + 1")
                endforeach()
                if(NOT found)
                    message(FATAL_ERROR "Missing Carven source-library dependency: ${dependency}")
                endif()
            endforeach()
            _carven_array(groups "${provider}" syslinks)
            foreach(group IN LISTS groups)
                string(JSON key GET "${group}" platform)
                if(key STREQUAL "all" OR key STREQUAL platform)
                    _carven_array(links "${group}" libraries)
                    list(APPEND libraries ${links})
                endif()
            endforeach()
            continue()
        endif()

        list(POP_FRONT pending_sources source)
        if(source IN_LIST selected_sources)
            continue()
        endif()
        if(NOT source IN_LIST scoped_sources)
            set(owners)
            set(index 0)
            foreach(provider IN LISTS providers)
                _carven_array(sources "${provider}" sources)
                if(source IN_LIST sources)
                    list(APPEND owners "${index}")
                endif()
                math(EXPR index "${index} + 1")
            endforeach()
            list(LENGTH owners count)
            if(count GREATER 1)
                message(FATAL_ERROR "Source belongs to multiple Carven source libraries: ${source}")
            elseif(count EQUAL 1)
                list(APPEND pending_targets ${owners})
                list(APPEND pending_sources "${source}")
                continue()
            endif()
        endif()
        list(APPEND selected_sources "${source}")
        _carven_implementation(compiled links "${source}")
        list(APPEND selected "${compiled}")
        foreach(logical IN LISTS links)
            _carven_artifact_source(dependency "${logical}")
            list(APPEND pending_sources "${dependency}")
        endforeach()
    endwhile()

    list(REMOVE_DUPLICATES selected)
    list(REMOVE_DUPLICATES libraries)
    target_sources("${target}" PRIVATE ${selected})
    target_include_directories("${target}" PUBLIC "${generated}" ${include_dirs})
    target_compile_features("${target}" PUBLIC cxx_std_20)
    target_link_libraries("${target}" PRIVATE ${libraries})
endfunction()
